-- ══════════════════════════════════════════════════════
--  BARS
-- ══════════════════════════════════════════════════════
local BAR_COUNT = 16
local BAR_W     = 8
local GAP       = 3

local palette = {
    Color3.fromRGB(0,   255, 120), Color3.fromRGB(60,  255,  60),
    Color3.fromRGB(140, 255,   0), Color3.fromRGB(200, 240,   0),
    Color3.fromRGB(255, 210,   0), Color3.fromRGB(255, 170,   0),
    Color3.fromRGB(255, 120,   0), Color3.fromRGB(255,  70,  30),
    Color3.fromRGB(255,  40,  80), Color3.fromRGB(240,   0, 150),
    Color3.fromRGB(210,   0, 210), Color3.fromRGB(160,   0, 255),
    Color3.fromRGB(90,   60, 255), Color3.fromRGB(30,  130, 255),
    Color3.fromRGB(0,   200, 255), Color3.fromRGB(0,   240, 200),
}

local sens = {}
for i = 1, BAR_COUNT do
    local mid  = (BAR_COUNT + 1) / 2
    local dist = math.abs(i - mid) / mid
    sens[i] = (1 - dist * 0.35) + math.random() * 0.12
end

-- Full bars
local BAR_MAX_H = 78
local totalW    = BAR_COUNT * BAR_W + (BAR_COUNT - 1) * GAP
local startX    = (PANEL_W - 14 - totalW) / 2

local bars = {}
for i = 1, BAR_COUNT do
    local bar = Instance.new("Frame")
    bar.Size             = UDim2.new(0, BAR_W, 0, 2)
    bar.Position         = UDim2.new(0, startX + (i-1)*(BAR_W+GAP), 1, -2)
    bar.AnchorPoint      = Vector2.new(0, 1)
    bar.BackgroundColor3 = palette[i]
    bar.BorderSizePixel  = 0
    bar.ZIndex           = 12
    bar.Parent           = vizFrame
    Instance.new("UICorner", bar).CornerRadius = UDim.new(0, 3)
    bars[i] = bar
end

-- Mini bars
local BAR_MAX_H_MINI = 16
local totalWMini     = BAR_COUNT * BAR_W + (BAR_COUNT - 1) * GAP
local startXMini     = (PANEL_W - 8 - totalWMini) / 2

local miniBars = {}
for i = 1, BAR_COUNT do
    local bar = Instance.new("Frame")
    bar.Size             = UDim2.new(0, BAR_W, 0, 2)
    bar.Position         = UDim2.new(0, startXMini + (i-1)*(BAR_W+GAP), 1, -2)
    bar.AnchorPoint      = Vector2.new(0, 1)
    bar.BackgroundColor3 = palette[i]
    bar.BorderSizePixel  = 0
    bar.ZIndex           = 12
    bar.Parent           = miniVizFrame
    Instance.new("UICorner", bar).CornerRadius = UDim.new(0, 2)
    miniBars[i] = bar
end

-- ══════════════════════════════════════════════════════
--  RUNTIME STATE
-- ══════════════════════════════════════════════════════
local renderConn   = nil
local currentSound = nil
local isPlaying    = false
local isMinimized  = false
local loadedId     = nil   -- ID string of currently loaded track

local function resetBars()
    for i = 1, BAR_COUNT do
        bars[i].Size     = UDim2.new(0, BAR_W, 0, 2)
        miniBars[i].Size = UDim2.new(0, BAR_W, 0, 2)
    end
end

local function updateBars()
    local loudness   = (currentSound and currentSound.IsPlaying)
                        and currentSound.PlaybackLoudness or 0
    local normalized = math.clamp(loudness / 950, 0, 1)
    local t          = tick()

    for i = 1, BAR_COUNT do
        local noise = (math.noise(i * 0.45, t * 2.8) + 1) / 2
        local phase = math.sin(t * 3.5 + i * 0.9) * 0.12
        local f     = math.clamp(
            normalized * sens[i] + noise * 0.22 * normalized + phase * normalized,
            0, 1
        )

        local tH = math.max(2, f * BAR_MAX_H)
        local cH = bars[i].Size.Y.Offset
        local sp = tH > cH and 0.55 or 0.18
        bars[i].Size = UDim2.new(0, BAR_W, 0, math.max(2, cH + (tH - cH) * sp))

        local tM = math.max(2, f * BAR_MAX_H_MINI)
        local cM = miniBars[i].Size.Y.Offset
        local sm = tM > cM and 0.55 or 0.18
        miniBars[i].Size = UDim2.new(0, BAR_W, 0, math.max(2, cM + (tM - cM) * sm))
    end
end

-- ══════════════════════════════════════════════════════
--  MINIMIZE / EXPAND
-- ══════════════════════════════════════════════════════
local function setMinimized(state)
    isMinimized = state
    if state then
        main.Size            = UDim2.new(0, PANEL_W, 0, PANEL_H_MINI)
        content.Visible      = false
        miniVizFrame.Visible = true
        minBtn.Text          = "+"
    else
        main.Size            = UDim2.new(0, PANEL_W, 0, PANEL_H_FULL)
        content.Visible      = true
        miniVizFrame.Visible = false
        minBtn.Text          = "−"
    end
end

minBtn.MouseButton1Click:Connect(function()
    setMinimized(not isMinimized)
end)

-- ══════════════════════════════════════════════════════
--  HELPER: stop current sound and reset state
-- ══════════════════════════════════════════════════════
local function stopCurrent()
    if renderConn then renderConn:Disconnect(); renderConn = nil end
    if currentSound and currentSound.Parent then
        currentSound:Stop()
        currentSound:Destroy()
        currentSound = nil
    end
    cleanupSound()
    loadedId  = nil
    isPlaying = false
    resetBars()
end

-- ══════════════════════════════════════════════════════
--  PLAY / PAUSE  BUTTON
-- ══════════════════════════════════════════════════════
playBtn.MouseButton1Click:Connect(function()
    -- Grab the current input ID (could be empty / changed)
    local inputId = string.match(inputBox.Text, "%d+")

    if isPlaying then
        -- ── PAUSE ─────────────────────────────────────
        if currentSound then currentSound:Pause() end
        isPlaying = false
        if renderConn then renderConn:Disconnect(); renderConn = nil end
        resetBars()

        playBtn.Text             = "▶   PLAY"
        playBtn.BackgroundColor3 = Color3.fromRGB(0, 185, 85)
        nowPlayingLabel.Text       = "Paused"
        nowPlayingLabel.TextColor3 = Color3.fromRGB(160, 130, 50)

    else
        -- ── PLAY ──────────────────────────────────────
        -- Decide: resume same track  OR  load new track

        local canResume = (inputId ~= nil)
                      and (inputId == loadedId)
                      and (currentSound ~= nil)
                      and (currentSound.Parent ~= nil)

        if canResume then
            -- Resume paused track
            currentSound:Resume()
            isPlaying = true

            playBtn.Text             = "⏸   PAUSE"
            playBtn.BackgroundColor3 = Color3.fromRGB(200, 60, 60)
            nowPlayingLabel.TextColor3 = Color3.fromRGB(70, 200, 120)

            if not renderConn then
                renderConn = RunService.RenderStepped:Connect(updateBars)
            end
        else
            -- ID changed, cleared, or nothing loaded → always reload
            stopCurrent()

            playBtn.Active           = false
            playBtn.Text             = "⏳  Loading..."
            playBtn.BackgroundColor3 = Color3.fromRGB(160, 120, 0)
            nowPlayingLabel.Text       = "Fetching track..."
            nowPlayingLabel.TextColor3 = Color3.fromRGB(200, 170, 60)

            local sound, songName, err = loadTrack(inputBox.Text)

            if err or not sound then
                nowPlayingLabel.Text       = err or "Unknown error."
                nowPlayingLabel.TextColor3 = Color3.fromRGB(220, 60, 60)
                playBtn.Text             = "▶   PLAY"
                playBtn.BackgroundColor3 = Color3.fromRGB(0, 185, 85)
                playBtn.Active           = true
                return
            end

            currentSound = sound
            loadedId     = string.match(inputBox.Text, "%d+")
            isPlaying    = true

            playBtn.Text             = "⏸   PAUSE"
            playBtn.BackgroundColor3 = Color3.fromRGB(200, 60, 60)
            playBtn.Active           = true
            nowPlayingLabel.Text       = "♪  " .. songName
            nowPlayingLabel.TextColor3 = Color3.fromRGB(70, 200, 120)

            if not renderConn then
                renderConn = RunService.RenderStepped:Connect(updateBars)
            end
        end
    end
end)

