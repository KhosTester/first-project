-- ══════════════════════════════════════════════════════
--  BOOMBOX ENGINE
-- ══════════════════════════════════════════════════════
local function cleanupSound()
    local s = workspace:FindFirstChild("FemboyBoombox")
    if s then s:Stop(); s:Destroy() end
end

-- Returns: sound, songName, errorMsg
local function loadTrack(inputText)
    local rawId = string.match(tostring(inputText), "%d+")
    if not rawId then
        return nil, nil, "Invalid ID — numbers only."
    end

    cleanupSound()

    local sound = Instance.new("Sound")
    sound.Name    = "FemboyBoombox"
    sound.Parent  = workspace
    sound.Volume  = 1
    sound.Looped  = true
    sound.SoundId = "rbxassetid://" .. rawId

    local waited = 0
    while not sound.IsLoaded and waited < 4 do
        task.wait(0.1)
        waited += 0.1
    end

    if sound.TimeLength == 0 or not sound.IsLoaded then
        sound:Destroy()
        return nil, nil, "Track unavailable or copyrighted."
    end

    local songName = "Track " .. rawId
    local ok, info = pcall(function()
        return MarketplaceService:GetProductInfo(tonumber(rawId))
    end)
    if ok and info and info.Name then
        songName = info.Name
    end

    sound:Play()
    return sound, songName, nil
end

