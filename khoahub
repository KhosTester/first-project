-- ── Check if a model in Game→Players is an Evade bot ──────────
local function isPlayerChar(m)
    for _,p in pairs(Players:GetPlayers()) do if p.Character==m then return true end end
    return false
end

local function isEvadeBot(model)
    if not model or not model:IsA("Model") then return false end
    local hum = model:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    if isPlayerChar(model) then return false end
    -- If blacklist has entries, use it; otherwise fall back to "has humanoid + not player"
    if next(npcBlacklist) then
        return isNPCName(model.Name)
    end
    return true  -- fallback: any non-player humanoid model in Game→Players is a bot
end

