local activeTween = nil

local function TweenTo(cf, speed)
    local hrp = GetPlayerHRP()
    if not hrp then return end
    local s = tonumber(speed) or 0.3
    if s <= 0 then s = 0.3 end
    if activeTween then activeTween:Cancel(); activeTween = nil end
    local tw = TweenService:Create(hrp,
        TweenInfo.new(s, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        { CFrame = cf })
    activeTween = tw
    tw:Play()
    pcall(function() tw.Completed:Wait() end)
    activeTween = nil
end

local function CancelTween()
    if activeTween then activeTween:Cancel(); activeTween = nil end
end

local stayConn = nil
local stayCF   = nil

local function StartStaying(cf)
    stayCF = cf
    if stayConn then stayConn:Disconnect() end
    local hum = GetPlayerHum()
    if hum then hum:MoveTo(cf.Position) end
    stayConn = RunService.Heartbeat:Connect(function()
        local hrp = GetPlayerHRP()
        local h   = GetPlayerHum()
        if not hrp or not h or not stayCF then return end
        if (hrp.Position - stayCF.Position).Magnitude > 3 then
            h:MoveTo(stayCF.Position)
        end
    end)
end

local function StopStaying()
    stayCF = nil
    if stayConn then stayConn:Disconnect(); stayConn = nil end
end

-- ============================================================
--   TELEPORT (Farm dùng portal như cũ)
-- ============================================================
local currentIsland  = nil
local lastTPTime     = 0
local TP_COOLDOWN    = 4

local preFiredIsland = nil

local function TeleportToIsland(island)
    if currentIsland == island then return true end

    local alreadyFired = (preFiredIsland == island)
    preFiredIsland = nil

    if alreadyFired then
        local hrp      = GetPlayerHRP()
        local startPos = hrp and hrp.Position or Vector3.zero
        local elapsed  = 0
        local moved    = false
        repeat
            task.wait(0.2); elapsed += 0.2
            hrp = GetPlayerHRP()
            if hrp and (hrp.Position - startPos).Magnitude > 20 then
                moved = true; break
            end
        until elapsed >= 4
        if moved then
            task.wait(GetPostTPWait())
            currentIsland = island
            lastTPTime    = tick()
            return true
        end
    end

    local now  = tick()
    local wait = TP_COOLDOWN - (now - lastTPTime)
    if wait > 0 then task.wait(wait) end

    pcall(function() TeleportToPortal:FireServer(island) end)

    local hrp      = GetPlayerHRP()
    local startPos = hrp and hrp.Position or Vector3.zero
    local elapsed  = 0
    repeat
        task.wait(0.2); elapsed += 0.2
        hrp = GetPlayerHRP()
    until (hrp and (hrp.Position - startPos).Magnitude > 20) or elapsed >= 5

    local success = hrp and (hrp.Position - startPos).Magnitude > 20
    if success then
        task.wait(GetPostTPWait())
        currentIsland = island
        lastTPTime    = tick()
    end
    return success
end

local function PreFirePortal(island)
    if Config.FarmMode ~= "TP" then return end
    if not island or island == currentIsland then return end
    local now = tick()
    if (now - lastTPTime) >= (TP_COOLDOWN - 1) then
        pcall(function() TeleportToPortal:FireServer(island) end)
        preFiredIsland = island
    end
end

-- ============================================================
--   TP BOSS qua Portal — retry 3 lan, timeout 8s
-- ============================================================
local lastBossTPTime   = 0
local BOSS_TP_COOLDOWN = 4

local function TeleportToBossIsland(island)
    if currentIsland == island then return true end

    local MAX_RETRY = 3
    for attempt = 1, MAX_RETRY do
        local now  = tick()
        local w    = BOSS_TP_COOLDOWN - (now - lastBossTPTime)
        if w > 0 then task.wait(w) end

        local hrp      = GetPlayerHRP()
        local startPos = hrp and hrp.Position or Vector3.zero

        pcall(function() TeleportToPortal:FireServer(island) end)
        lastBossTPTime = tick()

        local elapsed = 0
        repeat
            task.wait(0.2); elapsed += 0.2
            hrp = GetPlayerHRP()
        until (hrp and (hrp.Position - startPos).Magnitude > 20) or elapsed >= 8

        local moved = hrp and (hrp.Position - startPos).Magnitude > 20
        if moved then
            task.wait(0.6)
            currentIsland  = island
            lastBossTPTime = tick()
            lastTPTime     = tick()
            return true
        end

        warn(string.format("[KhoaHub] BossTP attempt %d/%d fail -> retry", attempt, MAX_RETRY))
        task.wait(1)
    end

    warn("[KhoaHub] BossTP FAILED: " .. tostring(island))
    return false
end

