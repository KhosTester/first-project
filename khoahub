-- FAKE UNUSUAL  (clone real cosmetics từ ReplicatedStorage)
-- ══════════════════════════════════════════════════════════════
local function buildEmoteTab()

    -- ══════════════════════════════════════════════════════════
    -- EMOTE SWAPPER  (ReplicatedStorage → Items → Emotes)
    -- Dropdown-based, scan button, Add/Remove/Reset mappings
    -- ══════════════════════════════════════════════════════════
    local swRS     = game:GetService("ReplicatedStorage")
    local swPairs  = {}          -- { [currentName] = selectName }
    local swEmoteList = {}       -- cached list from RS scan

    -- ── Scan RS for emote names ─────────────────────────────
    local function scanEmotes()
        swEmoteList = {}
        local items = swRS:FindFirstChild("Items")
        local ef    = items and items:FindFirstChild("Emotes")
        if ef then
            for _, obj in ipairs(ef:GetChildren()) do
                if obj:IsA("ModuleScript") or obj:IsA("StringValue") or obj:IsA("Instance") then
                    table.insert(swEmoteList, obj.Name)
                end
            end
        end
        table.sort(swEmoteList)
        if #swEmoteList == 0 then
            swEmoteList = {"(No emotes found — scan first)"}
        end
        return swEmoteList
    end

    -- ── Swap / Reset helpers ────────────────────────────────
    local function swapNames(cur, sel)
        local items = swRS:FindFirstChild("Items"); if not items then return false end
        local ef    = items:FindFirstChild("Emotes"); if not ef then return false end
        local cO = ef:FindFirstChild(cur); local sO = ef:FindFirstChild(sel)
        if cO and sO then
            local tmp = sel .. "_Tmp" .. math.random(1000, 9999)
            cO.Name = tmp; sO.Name = cur; cO.Name = sel
            return true
        end
        return false
    end

    local function resetAllSwaps()
        local items = swRS:FindFirstChild("Items"); if not items then return false end
        local ef    = items:FindFirstChild("Emotes"); if not ef then return false end
        for cur, sel in pairs(swPairs) do
            local cO = ef:FindFirstChild(sel); local sO = ef:FindFirstChild(cur)
            if cO and sO then
                local tmp = cur .. "_Tmp" .. math.random(1000, 9999)
                cO.Name = tmp; sO.Name = sel; cO.Name = cur
            end
        end
        return true
    end

    -- ── Dropdown refs (updated after scan) ─────────────────
    local ddCurrent = nil
    local ddSelect  = nil
    local swStatusPara = nil
    local swMappingPara = nil

    local function refreshStatus()
        if not swStatusPara then return end
        local count = 0
        for _ in pairs(swPairs) do count = count + 1 end
        local lines = "Active mappings: " .. count
        for cur, sel in pairs(swPairs) do
            lines = lines .. "\n  " .. cur .. "  →  " .. sel
        end
        pcall(function() swStatusPara:SetDesc(lines) end)
    end

    local function rebuildDropdowns(list)
        -- Fluent dropdowns cannot be dynamically re-populated after creation,
        -- so we store the list and apply it the first time dropdowns are built.
        -- After a rescan the user sees updated values on next UI rebuild (respawn).
        -- We update the internal Options value directly as a workaround.
        pcall(function()
            if Fluent.Options["SwCurrentEmote"] then
                Fluent.Options["SwCurrentEmote"].Values = list
            end
            if Fluent.Options["SwSelectEmote"] then
                Fluent.Options["SwSelectEmote"].Values = list
            end
        end)
    end

    -- ── Initial scan ───────────────────────────────────────
    local initialList = scanEmotes()

    -- ── Section: Emote Swapper ──────────────────────────────
    local sSwap = Tabs.Emote:AddSection("Emote Swapper")

    -- Scan button
    sSwap:AddButton({Title = "Scan Emotes", Callback = function()
        local list = scanEmotes()
        rebuildDropdowns(list)
        local msg = #list > 0 and ("Found " .. #list .. " emote(s)") or "No emotes found"
        pcall(function() swStatusPara:SetDesc(msg) end)
    end})

    -- Current Emote dropdown
    ddCurrent = sSwap:AddDropdown("SwCurrentEmote", {
        Title   = "Current Emote",
        Values  = initialList,
        Default = initialList[1] or "",
        Callback = function(_) end,
    })

    -- Select Emote dropdown
    ddSelect = sSwap:AddDropdown("SwSelectEmote", {
        Title   = "Select Emote",
        Values  = initialList,
        Default = initialList[1] or "",
        Callback = function(_) end,
    })

    -- Action buttons: Add, Remove, Reset
    sSwap:AddButton({Title = "Add", Callback = function()
        local cur = tostring(Fluent.Options["SwCurrentEmote"] and Fluent.Options["SwCurrentEmote"].Value or "")
        local sel = tostring(Fluent.Options["SwSelectEmote"]  and Fluent.Options["SwSelectEmote"].Value  or "")
        if cur == "" or sel == "" or cur:find("No emotes") then
            pcall(function() swStatusPara:SetDesc("Select valid emotes first.") end)
            return
        end
        if cur == sel then
            pcall(function() swStatusPara:SetDesc("Current and Select must be different.") end)
            return
        end
        if swPairs[cur] then
            pcall(function() swStatusPara:SetDesc("Mapping for '" .. cur .. "' already exists. Remove it first.") end)
            return
        end
        if swapNames(cur, sel) then
            swPairs[cur] = sel
            pcall(function() swStatusPara:SetDesc("Added: " .. cur .. " → " .. sel) end)
        else
            pcall(function() swStatusPara:SetDesc("Failed — emotes not found in ReplicatedStorage.") end)
        end
        refreshStatus()
    end})

    sSwap:AddButton({Title = "Remove Selected", Callback = function()
        local cur = tostring(Fluent.Options["SwCurrentEmote"] and Fluent.Options["SwCurrentEmote"].Value or "")
        if not swPairs[cur] then
            pcall(function() swStatusPara:SetDesc("No mapping for '" .. cur .. "'.") end)
            return
        end
        local sel = swPairs[cur]
        -- Undo this specific swap
        local items = swRS:FindFirstChild("Items")
        local ef    = items and items:FindFirstChild("Emotes")
        if ef then
            local cO = ef:FindFirstChild(sel); local sO = ef:FindFirstChild(cur)
            if cO and sO then
                local tmp = cur .. "_Tmp" .. math.random(1000,9999)
                cO.Name = tmp; sO.Name = sel; cO.Name = cur
            end
        end
        swPairs[cur] = nil
        pcall(function() swStatusPara:SetDesc("Removed mapping for: " .. cur) end)
        refreshStatus()
    end})

    sSwap:AddButton({Title = "Reset All", Callback = function()
        if resetAllSwaps() then
