local function GetDungeonUI()
    return LocalPlayer.PlayerGui:FindFirstChild(DUNGEON_UI_PATH)
end

local GuiService = game:GetService("GuiService")

local function NavClick(btn)
    if not btn then return false end
    local ok = pcall(function()
        local prevSelectable = btn.Selectable
        btn.Selectable = true
        GuiService.SelectedObject = btn
        task.wait(0.1)
        local inset  = GuiService:GetGuiInset()
        local pos    = btn.AbsolutePosition
        local size   = btn.AbsoluteSize
        local x = pos.X + size.X / 2
        local y = pos.Y + size.Y / 2 + inset.Y
        mousemoveabs(x, y)
        task.wait(0.1)
        mouse1click()
        task.wait(0.1)
        btn.Selectable = prevSelectable
        GuiService.SelectedObject = nil
    end)
    return ok
end

local function WalkPath(root, path)
    local cur = root
    for part in path:gmatch("[^%.]+") do
        cur = cur and cur:FindFirstChild(part)
    end
    return cur
end

local function ClickVoteButton(difficulty)
    local dui = GetDungeonUI()
    if not dui then return false end
    local btn = WalkPath(dui, DIFF_BUTTONS[difficulty] or "")
    if not btn then return false end
    return NavClick(btn)
end

local function ClickReplayButton()
    local dui = GetDungeonUI()
    if not dui then return false end
    local replayFrame = dui:FindFirstChild(REPLAY_FRAME_PATH)
    if not replayFrame then return false end
    local btn = nil
    for _, v in ipairs(replayFrame:GetDescendants()) do
        if (v:IsA("ImageButton") or v:IsA("TextButton"))
            and string.find(v.Name:lower(), "replay") then
            btn = v; break
        end
    end
    return NavClick(btn)
end

local function IsVoteFrameVisible()
    local dui = GetDungeonUI()
    if not dui then return false end
    local actions = WalkPath(dui, "ContentFrame.Actions")
    return actions ~= nil and actions.Visible == true
end

local function IsReplayFrameVisible()
    local dui = GetDungeonUI()
    if not dui then return false end
    local rf = dui:FindFirstChild(REPLAY_FRAME_PATH)
    return rf ~= nil and rf.Visible == true
end

