    end

    local function spawnRipple(pos,speedFactor)
        local sf=math.clamp(speedFactor or 1.0,0.4,2.5); spawnGlowDisc(pos)
        spawnRippleRing(pos,0.10,2.0*sf,0.28,0.05,Color3.new(1,1,1),0.065)
