function buildLightingEditor()
    local function getOrCreate(className)
        local eff=Lighting:FindFirstChildOfClass(className)
        if not eff then eff=Instance.new(className); eff.Parent=Lighting end
        return eff
    end
    local origLightFull={Brightness=Lighting.Brightness,ClockTime=Lighting.ClockTime,GlobalShadows=Lighting.GlobalShadows,ExposureCompensation=Lighting.ExposureCompensation,Ambient=Lighting.Ambient,OutdoorAmbient=Lighting.OutdoorAmbient}
    local origAtmo={}
    local atmo0=Lighting:FindFirstChildOfClass("Atmosphere")
    if atmo0 then origAtmo={Density=atmo0.Density,Offset=atmo0.Offset,Haze=atmo0.Haze,Color=atmo0.Color,Decay=atmo0.Decay}
    else origAtmo={Density=0,Offset=0,Haze=0,Color=Color3.fromRGB(199,199,199),Decay=Color3.fromRGB(106,127,139)} end
    local origPostCC={}; local origPostBloom={}; local origPostSR={}; local origPostBlur={}
    local cc0=Lighting:FindFirstChildOfClass("ColorCorrectionEffect")
    if cc0 then origPostCC={Brightness=cc0.Brightness,Contrast=cc0.Contrast,Saturation=cc0.Saturation,TintColor=cc0.TintColor}
    else origPostCC={Brightness=0,Contrast=0,Saturation=0,TintColor=Color3.new(1,1,1)} end
    local bl0=Lighting:FindFirstChildOfClass("BloomEffect"); if bl0 then origPostBloom={Intensity=bl0.Intensity} else origPostBloom={Intensity=0.1} end
