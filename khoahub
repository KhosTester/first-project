-- ============================================================
--   BOSS LOOP — Event-driven
-- ============================================================

task.spawn(function()
    local ok, BossTimerEvent = pcall(function()
        return RS:WaitForChild("Remotes", 10):WaitForChild("BossTimerEvent", 10)
    end)
    if not ok or not BossTimerEvent then
        warn("[KhoaHub] BossTimerEvent not found!")
        return
    end

    BossTimerEvent.OnClientEvent:Connect(function(bossName, state, _timer)
        if state ~= "SPAWNED" then return end
        if not Config.BossEnabled then return end

        local def = BOSS_NAME_TO_DEF[bossName]
        if not def then return end
        if not Config.SelectedBossNPCs[def.label] then return end

        for _, entry in ipairs(bossQueue) do
            if entry.def.name == def.name then return end
        end

        table.insert(bossQueue, { def = def, timestamp = tick() })

        Fluent:Notify({
            Title   = "Boss Spawned!",
            Content = bossName .. " → added to queue (" .. #bossQueue .. ")",
            Duration = 3,
        })
    end)
end)

-- Boss Worker Loop
task.spawn(function()
    while true do
        task.wait(0.3)

        if not Config.BossEnabled then
            if BossRunning then
                BossRunning   = false
                queueLock     = false
                currentIsland = nil
            end
            continue
        end

        if #bossQueue == 0 then continue end
        if queueLock then continue end

        local entry = table.remove(bossQueue, 1)
        local def   = entry.def

        if (tick() - entry.timestamp) > 300 then
            Fluent:Notify({
                Title   = "Boss Skipped",
                Content = def.name .. " — entry expired",
                Duration = 2,
            })
            continue
        end

        queueLock   = true
        BossRunning = true

        -- BƯỚC 1: TP qua portal đến đảo boss
        Fluent:Notify({
            Title   = "Auto Boss",
            Content = "TP → " .. def.island .. " | " .. def.name,
            Duration = 2,
        })

        -- [v41] Cung dao: VerifyOnIsland truoc khi skip TP
        -- Boss chet co the ban player ra arena → reset neu NPCFolder mat
        if currentIsland == def.island then
            if not VerifyOnIsland() then
                currentIsland = nil
            end
        end
        local tpOk = TeleportToBossIsland(def.island)

        if not tpOk or not Config.BossEnabled then
            BossRunning   = false
            queueLock     = false
            currentIsland = nil
            continue
        end

        -- BƯỚC 2: Chờ boss load (tối đa 15s — tăng từ 8s)
        -- [v41] Cùng đảo: boss có thể chưa respawn ngay → đợi lâu hơn
        local boss   = nil
        local waited = 0
        local waitMax = (currentIsland == def.island) and 15 or 8
        repeat
            task.wait(0.3)
            waited = waited + 0.3
            boss = FindLiveBoss(def)
        until boss or waited >= waitMax or not Config.BossEnabled

        if not boss then
            Fluent:Notify({
                Title   = "Boss Not Found",
                Content = def.name .. " — not found after " .. waitMax .. "s, skipping",
                Duration = 3,
            })
            BossRunning = false
            queueLock   = false
            -- [v41] KHÔNG reset currentIsland khi boss not found
            -- Boss tiếp theo cùng đảo vẫn có thể tìm được
            if #bossQueue == 0 then
                currentIsland = nil
            end
            continue
        end

        -- BƯỚC 3: Kill boss (isBoss=true → luôn direct CFrame TP)
        Fluent:Notify({
            Title   = "Fighting!",
            Content = def.name .. " found — engaging",
            Duration = 2,
        })

        GoAndFight(boss, Config.TweenSpeedTP, true)

        -- BƯỚC 4: Done
        BossRunning = false
        queueLock   = false
        -- [v40] FIX: Giữ currentIsland sau mỗi boss
        -- Nếu boss tiếp theo cùng đảo → skip TP, tìm boss trực tiếp
        -- Nếu boss tiếp theo khác đảo → TeleportToBossIsland tự xử lý
        -- Chỉ reset khi queue rỗng và trả về farm

        if #bossQueue == 0 then
            currentIsland = nil
            Fluent:Notify({
                Title   = "Boss Done!",
                Content = def.name .. " cleared — resuming farm.",
                Duration = 2,
            })
        else
            Fluent:Notify({
                Title   = "Boss Done!",
                Content = def.name .. " cleared — " .. #bossQueue .. " boss(es) in queue.",
                Duration = 2,
            })
        end

        task.wait(0.3)
    end
end)


-- ============================================================
--   BOSS FARM LOOP — Quét liên tục boss trên đảo hiện tại
--   Khác với event-driven: không cần BossTimerEvent, không TP
--   Điều kiện: BossFarmEnabled = true + đang đứng trên đảo + boss alive
-- ============================================================

task.spawn(function()
    local lastKillTime = {}   -- def.name → tick() lần kill gần nhất
    local RESPAWN_WAIT = 2.0  -- đợi ít nhất 2s sau khi boss chết trước khi scan lại

    while true do
        task.wait(0.3)

        if not Config.BossFarmEnabled then continue end
        -- Nhường cho Boss Worker Loop nếu đang xử lý queue event
        if BossRunning then task.wait(0.3); continue end

        -- Gom danh sách boss được chọn
        local candidates = {}
        for _, def in ipairs(BOSS_DEFS) do
            if Config.SelectedBossNPCs[def.label] then
                table.insert(candidates, def)
            end
        end
        if #candidates == 0 then task.wait(0.5); continue end

        -- Quét boss alive ngay trên đảo (không TP, không kiểm tra island)
        local found = false
        for _, def in ipairs(candidates) do
            if not Config.BossFarmEnabled then break end
            if BossRunning then break end

            -- Throttle: bỏ qua boss vừa mới bị kill (tránh spam)
            local lastKill = lastKillTime[def.name] or 0
            if (tick() - lastKill) < RESPAWN_WAIT then continue end

            local boss = FindLiveBoss(def)
            if not boss then continue end

            found = true
            BossRunning = true

            Fluent:Notify({
                Title   = "Boss Farm",
                Content = def.name .. " detected — engaging!",
                Duration = 2,
            })

            GoAndFight(boss, Config.TweenSpeedNPC, true)

            lastKillTime[def.name] = tick()
            BossRunning = false

            -- Nghỉ ngắn giữa các boss để tránh spam
            task.wait(0.5)
        end

        -- Nếu không tìm thấy boss nào, nghỉ 1s trước khi scan lại
        if not found then
            task.wait(1.0)
        end
    end
end)

-- ============================================================
--   FARM ALL LOOP
-- ============================================================

task.spawn(function()
    while true do
        task.wait(0.2)
        if not Config.FarmAllEnabled then continue end
        -- [v42] Boss đang chạy: farm nhường thread, không đụng UI toggle
        if BossRunning then task.wait(0.3); continue end

        for gi, islandGroup in ipairs(ISLAND_FARM_ORDER) do
            if not Config.FarmAllEnabled then break end

            if currentIsland ~= islandGroup.island then
                local ok = TeleportToIsland(islandGroup.island)
                if not ok then task.wait(1); continue end
            end

            local nextIsland = nil
            for ni = gi + 1, #ISLAND_FARM_ORDER do
                nextIsland = ISLAND_FARM_ORDER[ni].island; break
            end
            if not nextIsland then nextIsland = ISLAND_FARM_ORDER[1].island end

            local watchSet = BuildIslandWatchSet(islandGroup.defs)
            local isFirst  = true
            local cleared  = false

            for _, def in ipairs(islandGroup.defs) do
                if not Config.FarmAllEnabled or cleared then break end
                for i = 1, def.max do
                    if not Config.FarmAllEnabled or cleared then break end
                    local npc = FindLiveNPC(def.prefix..i)
                    if npc then
                        local speed = isFirst and Config.TweenSpeedTP or Config.TweenSpeedNPC
                        -- [v39] FIX 5: thêm isBoss=false tường minh
                        GoAndFight(npc, speed, false)
                        isFirst = false
                        if not FolderHasAnyAlive(watchSet) then
                            PreFirePortal(nextIsland)
                            cleared = true; break
                        end
                        task.wait(GetInterNPC())
                    end
                end
                if not cleared then task.wait(GetInterDef()) end
            end
        end
    end
end)

-- ============================================================
--   SPECIFIC FARM LOOP
-- ============================================================

task.spawn(function()
    while true do
        task.wait(0.2)
        if not Config.FarmEnabled then continue end

        local queue = {}
        for _, d in ipairs(FARM_DEFS) do
            if Config.SelectedFarmNPCs[d.label] then table.insert(queue, d) end
        end
        if #queue == 0 then task.wait(0.5); continue end
        -- [v42] Boss đang chạy: farm nhường thread, không đụng UI toggle
        if BossRunning then task.wait(0.3); continue end

        local islandDefs  = {}
        local islandOrder = {}
        local seen = {}
        for _, def in ipairs(queue) do
            if not seen[def.island] then
                seen[def.island] = true
                table.insert(islandOrder, def.island)
                islandDefs[def.island] = {}
            end
            table.insert(islandDefs[def.island], def)
        end

        local anyKilled = false

        for ii, island in ipairs(islandOrder) do
            if not Config.FarmEnabled then break end

            local defs   = islandDefs[island]
            local needTP = currentIsland ~= island
            if needTP then
                local ok = TeleportToIsland(island)
                if not ok then task.wait(1); continue end
            end

            local nextIsland = islandOrder[ii + 1]
            local watchSet   = BuildIslandWatchSet(defs)
            local isFirst    = needTP
            local cleared    = false

            for _, def in ipairs(defs) do
                if not Config.FarmEnabled or cleared then break end
                if not Config.SelectedFarmNPCs[def.label] then continue end
                for i = 1, def.max do
                    if not Config.FarmEnabled or cleared then break end
                    if not Config.SelectedFarmNPCs[def.label] then break end
                    local npc = FindLiveNPC(def.prefix..i)
                    if npc then
                        anyKilled = true
                        local speed = isFirst and Config.TweenSpeedTP or Config.TweenSpeedNPC
                        -- [v39] FIX 5: thêm isBoss=false tường minh
                        GoAndFight(npc, speed, false)
                        isFirst = false
                        if not FolderHasAnyAlive(watchSet) then
                            if nextIsland then PreFirePortal(nextIsland) end
                            cleared = true; break
                        end
                        task.wait(GetInterNPC())
                    end
                end
                if not cleared then task.wait(GetInterDef()) end
            end
        end

        if not anyKilled then
            task.wait(Config.FarmMode == "TP" and 0.15 or 1.0)
        end
    end
end)

