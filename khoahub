-- CUSTOM UNUSUAL SYSTEM
-- ════════════════════════════════════════════════════════════════

local function unusualCleanup()
    if unusual.conn then unusual.conn:Disconnect(); unusual.conn = nil end
    for _, entry in ipairs(unusual.objs) do
        pcall(function() if entry.obj and entry.obj.Parent then entry.obj:Destroy() end end)
    end
    unusual.objs = {}
    local c = player.Character
    if c then
        for _, part in ipairs(c:GetChildren()) do
            if part:IsA("BasePart") then
                for _, cls in ipairs({"Fire","Smoke","Sparkles","ParticleEmitter"}) do
                    for _, obj in ipairs(part:GetChildren()) do
                        if obj:IsA(cls) and obj.Name:find("FemboyUnusual") then
                            pcall(function() obj:Destroy() end)
                        end
                    end
                end
            end
        end
    end
end

-- Tạo instance + lưu vào objs với hueOffset
local function unusualNew(className, part, hueOffset)
    local obj = Instance.new(className)
    obj.Name   = "FemboyUnusual_" .. className
    obj.Parent = part
    table.insert(unusual.objs, {obj = obj, hueOffset = hueOffset or 0})
    return obj
end

local function applyUnusual()
    if not unusual.enabled then return end
    unusualCleanup()

    local c = player.Character
    if not c then return end

    -- Lấy danh sách bộ phận đang bật
    local activeParts = {}
    for label, isOn in pairs(unusual.bodyParts) do
        if isOn then
            local part = resolveBodyPart(c, label)
            if part then table.insert(activeParts, part) end
        end
    end
    if #activeParts == 0 then return end

    local sel        = unusual.selected
    local masterHue  = math.random()

    -- Spawn effect lên từng bộ phận
    for _, part in ipairs(activeParts) do

        if sel == "Rainbow Fire" then
            local f = unusualNew("Fire", part, 0)
            f.Size = unusual.size; f.Heat = unusual.heat
            f.Color = Color3.fromHSV(masterHue, 1, 1)
            f.SecondaryColor = Color3.fromHSV((masterHue+0.18)%1, 0.85, 1)

        elseif sel == "Rainbow Smoke" then
            local s = unusualNew("Smoke", part, 0)
            s.Color = Color3.fromHSV(masterHue, 0.8, 1)
            s.Opacity = unusual.opacity
            s.RiseVelocity = unusual.size * 2
            s.Size = unusual.size * 0.7

        elseif sel == "Rainbow Sparkles" then
            local sp = unusualNew("Sparkles", part, 0)
            sp.SparkleColor = Color3.fromHSV(masterHue, 1, 1)

        elseif sel == "Neon Aura" then
            local sp = unusualNew("Sparkles", part, 0)
            sp.SparkleColor = Color3.fromHSV(masterHue, 1, 1)
            local pe = unusualNew("ParticleEmitter", part, 0)
            pe.Texture = "rbxassetid://1266070111"
            pe.Rate = 12; pe.Speed = NumberRange.new(1, 3)
            pe.Lifetime = NumberRange.new(0.5, 1.2)
            pe.SpreadAngle = Vector2.new(360, 360)
            pe.LightEmission = 1; pe.LightInfluence = 0
            pe.Size = NumberSequence.new({
                NumberSequenceKeypoint.new(0, unusual.size * 0.4),
                NumberSequenceKeypoint.new(1, 0),
            })
            pe.Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 0.2),
                NumberSequenceKeypoint.new(1, 1),
            })
            pe.Color = ColorSequence.new(Color3.fromHSV(masterHue, 1, 1))

        elseif sel == "Vortex Smoke" then
            local s1 = unusualNew("Smoke", part, 0)
            s1.Color = Color3.fromHSV(masterHue, 0.6, 0.9)
            s1.Opacity = 0.55; s1.RiseVelocity = 8; s1.Size = unusual.size * 0.9
            local s2 = unusualNew("Smoke", part, 0.5)
            s2.Color = Color3.fromHSV((masterHue+0.5)%1, 0.6, 0.9)
            s2.Opacity = 0.45; s2.RiseVelocity = 12; s2.Size = unusual.size * 0.55

        elseif sel == "Firework Sparks" then
            local f1 = unusualNew("Fire", part, 0)
            f1.Size = unusual.size * 0.8; f1.Heat = 15
            f1.Color = Color3.fromHSV(masterHue, 1, 1)
            f1.SecondaryColor = Color3.new(1, 1, 1)
            local f2 = unusualNew("Fire", part, 0.15)
            f2.Size = unusual.size * 0.5; f2.Heat = 20
            f2.Color = Color3.fromHSV((masterHue+0.15)%1, 1, 1)
            f2.SecondaryColor = Color3.fromRGB(255, 255, 255)

        elseif sel == "7 Fires" then
            -- 7 ngọn lửa xếp chồng, mỗi cái 1 màu cầu vồng cố định
            for i = 0, 6 do
                local offset = i / 7
                local f = unusualNew("Fire", part, offset)
                f.Color          = Color3.fromHSV((masterHue + offset) % 1, 1, 1)
                f.SecondaryColor = Color3.fromHSV((masterHue + offset + 0.1) % 1, 0.8, 1)
                f.Size           = unusual.size * (1.0 - i * 0.09)
                f.Heat           = unusual.heat + i * 2
            end

        elseif sel == "ALL Effects" then
            local f = unusualNew("Fire", part, 0)
            f.Size = unusual.size; f.Heat = unusual.heat
            f.Color = Color3.fromHSV(masterHue, 1, 1)
            f.SecondaryColor = Color3.fromHSV((masterHue+0.18)%1, 0.85, 1)
            local s = unusualNew("Smoke", part, 0.33)
            s.Color = Color3.fromHSV((masterHue+0.33)%1, 0.8, 1)
            s.Opacity = unusual.opacity; s.RiseVelocity = unusual.size*2; s.Size = unusual.size*0.7
            local sp = unusualNew("Sparkles", part, 0.66)
            sp.SparkleColor = Color3.fromHSV((masterHue+0.66)%1, 1, 1)
        end
    end

    -- ── Per-frame màu cầu vồng ───────────────────────────────────
    unusual.conn = RunService.Heartbeat:Connect(function(dt)
        if not unusual.enabled then return end
        masterHue = (masterHue + dt * unusual.speed) % 1

        for _, entry in ipairs(unusual.objs) do
            local obj    = entry.obj
            local offset = entry.hueOffset
            if not obj or not obj.Parent then continue end
            local h = (masterHue + offset) % 1
            pcall(function()
                if obj:IsA("Fire") then
                    obj.Color          = Color3.fromHSV(h, 1, 1)
                    obj.SecondaryColor = Color3.fromHSV((h + 0.12) % 1, 0.85, 1)
                    obj.Size           = unusual.size * math.max(0.1, 1.0 - offset * 0.85)
                    obj.Heat           = unusual.heat
                elseif obj:IsA("Smoke") then
                    obj.Color   = Color3.fromHSV(h, 0.8, 1)
                    obj.Opacity = unusual.opacity
                    obj.Size    = unusual.size * 0.7
                elseif obj:IsA("Sparkles") then
                    obj.SparkleColor = Color3.fromHSV(h, 1, 1)
                elseif obj:IsA("ParticleEmitter") then
                    obj.Color = ColorSequence.new(Color3.fromHSV(h, 1, 1))
                end
            end)
        end
    end)
end

