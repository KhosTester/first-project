        if farm.active and farm.method==1 then farm.phase=1; farmTP() end
    end})
    sFM:AddButton({Title="Return to Surface (M3)",Callback=function()
        if farm.method==3 then
            local c=player.Character; if not c then return end
            local h=c:FindFirstChild("HumanoidRootPart")
            if h then h.CFrame=CFrame.new(0,5,0); h.AssemblyLinearVelocity=Vector3.new() end
        end
    end})

    -- Auto Vote
    local autoVoteConn  = nil
    local autoVoteMode  = "Easiest First"
    local VOTE_PRIORITIES = {
        ["Easiest First"] = {"EASY", "NORMAL", "HARD", "EXPERT"},
        ["Hardest First"] = {"EXPERT", "HARD", "NORMAL", "EASY"},
        ["Random"]        = nil,
    }
    local function executeAutoVote()
        if not st.AutoVote then return end
        local playerGui = player:FindFirstChild("PlayerGui"); if not playerGui then return end
        local voteFrame = nil
        for _, desc in pairs(playerGui:GetDescendants()) do
            if desc.Name == "Vote" and desc:IsA("Frame") and desc.Visible then voteFrame = desc; break end
        end
        if not voteFrame then return end
        local choices = nil
        for _ = 1, 20 do
            choices = voteFrame:FindFirstChild("Choices")
            if choices and #choices:GetChildren() >= 4 then break end
            task.wait(0.2)
        end
        if not choices then return end
        local slots = {}
        for i = 1, 4 do
            local container = choices:FindFirstChild(tostring(i))
            if container then
                local imgBtn = container:FindFirstChild("ImageButton") or container:FindFirstChildOfClass("ImageButton") or container
                local diffLabel  = imgBtn and imgBtn:FindFirstChild("Difficulty")
                local titleLabel = imgBtn and imgBtn:FindFirstChild("Title")
                slots[i] = {button=imgBtn, difficulty=diffLabel and diffLabel.Text or "UNKNOWN", mapName=titleLabel and titleLabel.Text or "Slot "..i}
            end
        end
        local target = nil
        if autoVoteMode == "Random" then
            local available = {}
            for i = 1, 4 do if slots[i] then table.insert(available, slots[i]) end end
            if #available > 0 then target = available[math.random(1, #available)] end
        else
            local priority = VOTE_PRIORITIES[autoVoteMode] or VOTE_PRIORITIES["Easiest First"]
            for _, pref in ipairs(priority) do
                for i = 1, 4 do if slots[i] and slots[i].difficulty == pref then target = slots[i]; break end end
                if target then break end
            end
        end
        if not target then target = slots[4] end
        if not target or not target.button then return end
        local btn = target.button
        local cx = math.floor(btn.AbsolutePosition.X + btn.AbsoluteSize.X * 0.5)
        local cy = math.floor(btn.AbsolutePosition.Y + btn.AbsoluteSize.Y * 0.5)
        pcall(function() VIM:SendMouseMovementEvent(cx, cy, false, game) end)
        task.wait(0.05)
        pcall(function() VIM:SendMouseButtonEvent(cx, cy, 0, true, game, 1); task.wait(0.08); VIM:SendMouseButtonEvent(cx, cy, 0, false, game, 1) end)
    end
    sFM:AddDropdown("VoteMode",{Title="Vote Priority",Values={"Easiest First","Hardest First","Random"},Default="Easiest First",Callback=function(v) autoVoteMode=tostring(v) end})
    toggleRefs["AutoVote"] = sFM:AddToggle("AutoVote",{Title="Enable Auto Vote",Default=false,Callback=function(v)
        st.AutoVote=v
        if v then
            task.spawn(function()
                local playerGui = player:WaitForChild("PlayerGui")
                if autoVoteConn then autoVoteConn:Disconnect() end
                local voteLastCheck = 0
                autoVoteConn = RunService.Heartbeat:Connect(function()
                    if not st.AutoVote then return end
                    if tick() - voteLastCheck < 2 then return end
                    voteLastCheck = tick()
                    for _, desc in pairs(playerGui:GetDescendants()) do
                        if desc.Name == "Vote" and desc:IsA("Frame") and desc.Visible then
                            local choices = desc:FindFirstChild("Choices")
                            if choices then
                                local alreadyVoted = false
                                for i = 1, 4 do
                                    local container = choices:FindFirstChild(tostring(i))
                                    local imgBtn = container and (container:FindFirstChild("ImageButton") or container:FindFirstChildOfClass("ImageButton"))
                                    local votedLabel = imgBtn and imgBtn:FindFirstChild("Voted")
                                    if votedLabel and votedLabel.Visible then alreadyVoted = true; break end
                                end
                                if not alreadyVoted then task.spawn(executeAutoVote) end
                            end
                            break
                        end
                    end
                end)
            end)
        else
            if autoVoteConn then autoVoteConn:Disconnect(); autoVoteConn=nil end
        end
    end})
    sFM:AddButton({Title="Vote Now (manual)",Callback=function() task.spawn(executeAutoVote) end})

    -- Auto Ticket
    local tfStatusPara = sFM:AddParagraph({Title="Ticket Status", Content="Idle"})
    local tfCountPara  = sFM:AddParagraph({Title="Collected",     Content="0"})
    task.spawn(function()
        while true do
            task.wait(0.5)
            pcall(function() tfStatusPara:SetDesc(ticketFarm.status) end)
            pcall(function() tfCountPara:SetDesc(tostring(ticketFarm.count)) end)
        end
    end)
    toggleRefs["TicketFarm"] = sFM:AddToggle("TicketFarm",{Title="Enable Auto Ticket Farm",Default=false,Callback=function(v)
        st.TicketFarm=v; ticketFarm.enabled=v
        if v then startTicketFarm() else stopTicketFarm() end
    end})
    sFM:AddKeybind("KbTicketFarm",{Title="Ticket Keybind",Default="None",Callback=function() end,ChangedCallback=function(new) registerKeybind("TicketFarm",new) end})

    -- Anti-AFK
    toggleRefs["AntiAFK"]=sFM:AddToggle("AntiAFK",{Title="Enable Anti-AFK",Default=false,Callback=function(v)
        st.AntiAFK=v
        if v then lastInputTime=tick(); enableAntiAFK() else disableAntiAFK() end
    end})
    local afkTimeP=sFM:AddParagraph({Title="Time Until Kick",Content="20:00"})
    local afkStatusP=sFM:AddParagraph({Title="AFK Status",Content="Active"})
    RunService.Heartbeat:Connect(function()
        local elapsed=tick()-lastInputTime; local remaining=math.max(0,1200-elapsed)
        pcall(function() afkTimeP:SetDesc(string.format("%02d:%02d",math.floor(remaining/60),math.floor(remaining%60))) end)
        pcall(function()
            if remaining<=60 then afkStatusP:SetDesc("⚠ ABOUT TO BE KICKED!")
            elseif remaining<=300 then afkStatusP:SetDesc("⚡ Warning — less than 5 minutes left")
            else afkStatusP:SetDesc("Active — No AFK risk") end
        end)
    end)
end

