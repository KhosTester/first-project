-- Lưu mode farm đang bật trước khi boss interrupt
-- "none" | "farm" | "farmAll"
local savedFarmMode = "none"

-- Gọi khi boss bắt đầu: tắt farm thật sự
local function PauseFarmForBoss()
    if Config.FarmEnabled then
        savedFarmMode = "farm"
        -- Tắt toggle thật sự
        Config.FarmEnabled = false
        pcall(function() Fluent.Options.FarmToggle:SetValue(false) end)
    elseif Config.FarmAllEnabled then
        savedFarmMode = "farmAll"
        Config.FarmAllEnabled = false
        pcall(function() Fluent.Options.FarmAllToggle:SetValue(false) end)
    else
        savedFarmMode = "none"
    end
    -- Reset island context để farm restart sạch
    -- (currentIsland được khai báo bên dưới nhưng Lua cho phép closure)
end

-- Gọi khi boss xong: bật lại farm
local function ResumeFarmAfterBoss()
    if savedFarmMode == "farm" then
        Config.FarmEnabled = true
        pcall(function() Fluent.Options.FarmToggle:SetValue(true) end)
    elseif savedFarmMode == "farmAll" then
        Config.FarmAllEnabled = true
        pcall(function() Fluent.Options.FarmAllToggle:SetValue(true) end)
    end
    savedFarmMode = "none"
end

