-- EMOTE WALK BYPASS
-- Idle emotes lock movement by setting WalkSpeed = 0 every frame.
-- This restores WalkSpeed to whatever it was before the emote fired,
-- so the character can move normally while the emote animation plays.
-- ════════════════════════════════════════════════════════════════
local function enableEmoteWalk()
    local c   = player.Character
    local hum = c and c:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    if hum.WalkSpeed > 0 then emoteWalk.savedSpeed = hum.WalkSpeed end

    hum:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
        if hum.WalkSpeed > 0 then emoteWalk.savedSpeed = hum.WalkSpeed end
    end)

    -- Restore WalkSpeed every frame if emote locked it to 0
    if emoteWalk.conn then emoteWalk.conn:Disconnect() end
    emoteWalk.conn = RunService.Heartbeat:Connect(function()
        if not emoteWalk.enabled then return end
        local ch = player.Character
        local hm = ch and ch:FindFirstChildOfClass("Humanoid")
        if not hm then return end
        if hm.WalkSpeed == 0 then
            hm.WalkSpeed = emoteWalk.savedSpeed
        end
        -- Restore JumpPower if emote zeroed it too
        if hm.JumpPower == 0 then
            hm.JumpPower = 50
        end
    end)

    -- Allow jump via Space while emote is playing
    if emoteWalk.jumpConn then emoteWalk.jumpConn:Disconnect() end
    emoteWalk.jumpConn = UserInputService.InputBegan:Connect(function(inp, gpe)
        if gpe then return end
        if not emoteWalk.enabled then return end
        if inp.KeyCode ~= Enum.KeyCode.Space then return end
        local ch = player.Character
        local hm = ch and ch:FindFirstChildOfClass("Humanoid")
        if hm then pcall(function() hm:ChangeState(Enum.HumanoidStateType.Jumping) end) end
    end)
end

local function disableEmoteWalk()
    if emoteWalk.conn then emoteWalk.conn:Disconnect(); emoteWalk.conn = nil end
    if emoteWalk.jumpConn then emoteWalk.jumpConn:Disconnect(); emoteWalk.jumpConn = nil end
end

-- Survive respawn
player.CharacterAdded:Connect(function()
    if emoteWalk.enabled then
        task.wait(1)
        enableEmoteWalk()
    end
end)

