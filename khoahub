local function StartAntiBanBlock()
    if antibanPart and antibanPart.Parent then return end

    antibanPart              = Instance.new("Part")
    antibanPart.Name         = "AntiBanPlatform"
    antibanPart.Size         = Vector3.new(6, 0.2, 6)
