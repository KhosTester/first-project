local SKILL_SLOTS = { Z=1, X=2, C=3, V=4, F=5 }
local SKILL_ORDER = {"Z","X","C","V","F"}
local SkillCooldowns = {}

-- Một handler duy nhất cho cooldown
RS.AbilitySystem.Remotes.AbilityFeedback.OnClientEvent:Connect(function(data)
    if type(data) ~= "table" then return end
    if data.Caster ~= LocalPlayer then return end
    if data.AbilitySlot and data.Cooldown then
        SkillCooldowns[data.AbilitySlot] = tick() + data.Cooldown
    end
end)

local function IsSkillOnCooldown(slotNum)
    local cd = SkillCooldowns[slotNum]
    return cd ~= nil and tick() < cd
end

local function SetAutoSkillSlot(slot)
    pcall(function() LocalPlayer:SetAttribute("AutoSkillSlot", slot) end)
end

local VIM = game:GetService("VirtualInputManager")

local function VIMClick(obj)
    if not obj then return end
    local ok, pos = pcall(function()
        return obj.AbsolutePosition + obj.AbsoluteSize / 2
    end)
    if not ok then return end
    pcall(function()
        VIM:SendMouseButtonEvent(pos.X, pos.Y, 0, true,  game, 0)
        task.wait(0.05)
        VIM:SendMouseButtonEvent(pos.X, pos.Y, 0, false, game, 0)
    end)
end

local function GetSkillToggleButtons(key)
    local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if not pg then return nil, nil end
    local ui = pg:FindFirstChild("AutoSkillSettingsUI")
    if not ui then return nil, nil end
    local frame = ui:FindFirstChild("MainFrame")
    if not frame then return nil, nil end
    local toggle = frame:FindFirstChild("Frame")
        and frame.Frame:FindFirstChild("Content")
        and frame.Frame.Content:FindFirstChild("Settings")
        and frame.Frame.Content.Settings:FindFirstChild("Toggle_AutoSkill"..key)
    if not toggle then return nil, nil end
    local holder = toggle:FindFirstChild("SettingsHolder")
    if not holder then return nil, nil end
    return holder:FindFirstChild("On"), holder:FindFirstChild("Off")
end

