-- ============================================================
--   AUTO SKILL LOOP
--   [v39] FIX 3: Dùng if/else thay ternary — tránh Lua operator bug
--   [v39] FIX 4: lastFiredSlot/lastFiredTime đã merge vào 1 connection ở trên
-- ============================================================

task.spawn(function()
    local prevEnabled = false

    while true do
        task.wait(0.1)

        -- [v39] FIX 3: if/else thay vì ternary (sửa lỗi Lua precedence)
        local skillEnabled, selectedSkills
        if BossRunning then
            skillEnabled   = Config.AutoSkillBossEnabled
            selectedSkills = Config.SelectedSkillsBoss
        else
            skillEnabled   = Config.AutoSkillFarmEnabled
            selectedSkills = Config.SelectedSkillsFarm
        end

        if not skillEnabled then
            if prevEnabled then
                task.spawn(DisableAllSkillsInGameUI)
                prevEnabled = false
                SetAutoSkillSlot(0)
            end
            continue
        end
        prevEnabled = true

        local hasSkills = false
        for _ in pairs(selectedSkills) do hasSkills = true; break end
        if not hasSkills then task.wait(0.3); continue end

        for _, key in ipairs(SKILL_ORDER) do
            if not skillEnabled then break end
            if not selectedSkills[key] then continue end
            local slotNum = SKILL_SLOTS[key]
            if IsSkillOnCooldown(slotNum) then continue end

            EnableSkillInGameUI(key)
            SetAutoSkillSlot(slotNum)

            local timeout       = 3.0
            local waited        = 0
            local confirmed     = false
            local prevFiredTime = lastFiredTime

            while waited < timeout do
                if not skillEnabled then break end
                task.wait(0.1); waited += 0.1
                if lastFiredSlot == slotNum and lastFiredTime ~= prevFiredTime then
                    confirmed = true; break
                end
            end

            DisableSkillInGameUI(key)
            SetAutoSkillSlot(0)

            if confirmed then
                local cd = SkillCooldowns[slotNum]
                if cd then
                    while tick() < cd do
                        if not skillEnabled then break end
                        task.wait(0.2)
                    end
                end
            else
                task.wait(0.5)
            end
            task.wait(0.1)
        end
    end
end)

