    local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if not pg then return end
    local ui = pg:FindFirstChild("AutoSkillSettingsUI")
    if not ui then return end
    pcall(function()
        ui.Enabled = true
        local mf = ui:FindFirstChild("MainFrame")
        if mf then
            -- Đẩy hoàn toàn ra ngoài màn hình (bên trái, âm vô cùng)
            mf.Position = UDim2.new(0, -9999, 0, 0)
        end
    end)
end

local function HideSkillUI()
    local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if not pg then return end
    local ui = pg:FindFirstChild("AutoSkillSettingsUI")
    if ui then pcall(function() ui.Enabled = false end) end
end

