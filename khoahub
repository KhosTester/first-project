local BossActive = false

-- ============================================================
--   GO AND FIGHT
--   FIX: Boss knockback → re-tween với 2 s cooldown thay vì spam TP
--        Farm NPC → re-tween với 0.5 s cooldown
-- ============================================================

local BOSS_RETP_COOLDOWN = 2.0   -- giây giữa 2 lần re-approach boss
local NPC_RETP_COOLDOWN  = 0.5   -- giây giữa 2 lần re-approach NPC thường

local function GoAndFight(npc, speed, isBoss)
    local root = GetRoot(npc)
    if not root then return end
    local s = tonumber(speed) or 0.3
    if s <= 0 then s = 0.3 end

    if isBoss then BossActive = true end

    -- Lần đầu tween vào
    local targetCF = root.CFrame
    TweenTo(targetCF, s)
    StartStaying(targetCF)

    local lastReTP = tick()
    local cooldown = isBoss and BOSS_RETP_COOLDOWN or NPC_RETP_COOLDOWN

    while IsAlive(npc) do
        -- Boss priority: if a boss spawns while farming a normal NPC, drop it immediately
        if not isBoss and BossActive then
            break
        end

        if not (root and root.Parent) then break end

        targetCF = root.CFrame
        stayCF   = targetCF

        local hrp = GetPlayerHRP()
        if hrp then
            local dist = (hrp.Position - targetCF.Position).Magnitude
            if dist > 15 and (tick() - lastReTP) >= cooldown then
                lastReTP = tick()
                StopStaying()
                TweenTo(targetCF, Config.TweenSpeedNPC)
                StartStaying(targetCF)
            end
        end

        task.wait(0.15)
    end

    StopStaying()
    if isBoss then BossActive = false end
end

