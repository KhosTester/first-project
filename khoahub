local BossTimerEvent = RS.Remotes:WaitForChild("BossTimerEvent")
BossTimerEvent.OnClientEvent:Connect(function(bossName, state)
    if state ~= "SPAWNED" then return end
    if not Config.BossEnabled then return end
    local def = BOSS_NAME_TO_DEF[bossName]
    if not def then return end
    if not Config.SelectedBossNPCs[def.label] then return end
    if not spawnedBossSet[def.name] then
        spawnedBossSet[def.name] = true
        table.insert(spawnedBossQueue, def)
        -- Signal farm loops to stop immediately — boss loop will set it false when done
        BossActive = true
        Fluent:Notify({
            Title    = "Boss Spawned!",
            Content  = bossName.." spotted — interrupting farm!",
            Duration = 3,
        })
    end
end)

-- ============================================================
--   BOSS LOOP
-- ============================================================

task.spawn(function()
    while true do
        task.wait(0.2)
        if not Config.BossEnabled then
            BossActive       = false
            spawnedBossQueue = {}
            spawnedBossSet   = {}
            continue
        end

        -- Initial scan
        for _, def in ipairs(BOSS_DEFS) do
            if not Config.SelectedBossNPCs[def.label] then continue end
            if spawnedBossSet[def.name] then continue end
            if FindLiveBoss(def) then
                spawnedBossSet[def.name] = true
                table.insert(spawnedBossQueue, def)
            end
        end

        if #spawnedBossQueue == 0 then BossActive = false; continue end

        local def = table.remove(spawnedBossQueue, 1)
        spawnedBossSet[def.name] = nil

        BossActive = true
        local tpOk = TeleportToIsland(def.island)
        if not tpOk then
            table.insert(spawnedBossQueue, def)
            spawnedBossSet[def.name] = true
            BossActive = false
            task.wait(2)
            continue
        end

        local boss = FindLiveBoss(def)
        if boss then
            GoAndFight(boss, Config.TweenSpeedTP, true)
            task.wait(0.3)
        end
        BossActive = false
    end
end)

-- ============================================================
--   FARM ALL LOOP
-- ============================================================

task.spawn(function()
    while true do
        task.wait(0.2)
        if not Config.FarmAllEnabled then continue end
        while BossActive do task.wait(0.2) end

        for _, islandGroup in ipairs(ISLAND_FARM_ORDER) do
            if not Config.FarmAllEnabled then break end
            while BossActive do task.wait(0.2) end

            if currentIsland ~= islandGroup.island then
                TeleportToIsland(islandGroup.island)
            end

            local isFirst = true
            for _, def in ipairs(islandGroup.defs) do
                if not Config.FarmAllEnabled then break end
                for i = 1, def.max do
                    if not Config.FarmAllEnabled then break end
                    local npc = FindLiveNPC(def.prefix..i)
                    if npc then
                        local speed = isFirst and Config.TweenSpeedTP or Config.TweenSpeedNPC
                        GoAndFight(npc, speed)
                        isFirst = false
                        task.wait(0.1)
                    end
                end
            end
        end
    end
end)

-- ============================================================
--   SPECIFIC FARM LOOP
-- ============================================================

task.spawn(function()
    while true do
        task.wait(0.2)
        if not Config.FarmEnabled then continue end
        while BossActive do task.wait(0.2) end

        local queue = {}
        for _, d in ipairs(FARM_DEFS) do
            if Config.SelectedFarmNPCs[d.label] then table.insert(queue, d) end
        end
        if #queue == 0 then task.wait(0.5); continue end

        local anyKilled = false
        for _, def in ipairs(queue) do
            if not Config.FarmEnabled then break end
            if not Config.SelectedFarmNPCs[def.label] then continue end
            while BossActive do task.wait(0.2) end

            local needTP = currentIsland ~= def.island
            if needTP then
                local ok = TeleportToIsland(def.island)
                if not ok then task.wait(1); continue end
            end

            local isFirst = needTP
            for i = 1, def.max do
                if not Config.FarmEnabled then break end
                if not Config.SelectedFarmNPCs[def.label] then break end
                local npc = FindLiveNPC(def.prefix..i)
                if npc then
                    anyKilled = true
                    local speed = isFirst and Config.TweenSpeedTP or Config.TweenSpeedNPC
                    GoAndFight(npc, speed)
                    isFirst = false
                    task.wait(0.2)
                end
            end
            task.wait(0.1)
        end
        if not anyKilled then task.wait(1) end
    end
end)

