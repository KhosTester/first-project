local function StopAntiBanBlock()
    if antibanConn then antibanConn:Disconnect(); antibanConn = nil end
    if antibanPart  then antibanPart:Destroy();   antibanPart = nil  end
end

-- ============================================================
--   TWEEN / STAY
-- ============================================================
local activeTween = nil

local function TweenTo(cf, speed)
    local hrp = GetPlayerHRP()
    if not hrp then return end
    local s = tonumber(speed) or 0.3
    if s <= 0 then s = 0.3 end
    if activeTween then activeTween:Cancel(); activeTween = nil end
    local tw = TweenService:Create(hrp,
        TweenInfo.new(s, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        { CFrame = cf })
    activeTween = tw
    tw:Play()
    tw.Completed:Wait()
    activeTween = nil
end

local function CancelTween()
    if activeTween then activeTween:Cancel(); activeTween = nil end
end

local stayConn = nil
local stayCF   = nil

local function StartStaying(cf)
    stayCF = cf
    if stayConn then stayConn:Disconnect() end
    local hum = GetPlayerHum()
    if hum then hum:MoveTo(cf.Position) end
    stayConn = RunService.Heartbeat:Connect(function()
        local hrp = GetPlayerHRP()
        local h   = GetPlayerHum()
        if not hrp or not h or not stayCF then return end
        if (hrp.Position - stayCF.Position).Magnitude > 3 then
            h:MoveTo(stayCF.Position)
        end
    end)
end

local function StopStaying()
    stayCF = nil
    if stayConn then stayConn:Disconnect(); stayConn = nil end
end

-- ============================================================
--   TELEPORT
-- ============================================================
local currentIsland = nil
local lastTPTime    = 0
local TP_COOLDOWN   = 8

local function TeleportToIsland(island)
    if currentIsland == island then return true end
    local now  = tick()
    local wait = TP_COOLDOWN - (now - lastTPTime)
    if wait > 0 then task.wait(wait) end

    pcall(function() TeleportToPortal:FireServer(island) end)
    local hrp      = GetPlayerHRP()
    local startPos = hrp and hrp.Position or Vector3.zero
    local elapsed  = 0
    repeat
        task.wait(0.25); elapsed += 0.25
        hrp = GetPlayerHRP()
    until (hrp and (hrp.Position - startPos).Magnitude > 50) or elapsed >= 8

    local success = hrp and (hrp.Position - startPos).Magnitude > 50
    if success then
        task.wait(2.0)
        currentIsland = island
        lastTPTime    = tick()
    end
    return success
end

