-- ANIMATED BORDER SYSTEM
-- ══════════════════════════════════════════════════════════════
local animatedBorders = {}
local _animT = 0

RunService.Heartbeat:Connect(function(dt)
    _animT = _animT + dt * 2.8
    local pulse     = math.sin(_animT) * 0.5 + 0.5
    local thickness = 3.5 + pulse * 2.0
    local rVal      = math.floor(200 + 55 * pulse)
    local gbVal     = math.floor(pulse * 40)
    local color     = Color3.fromRGB(rVal, gbVal, gbVal)
    for i = #animatedBorders, 1, -1 do
        local s = animatedBorders[i]
        if s and s.Parent then
            pcall(function() s.Thickness = thickness; s.Color = color end)
        else
            table.remove(animatedBorders, i)
        end
    end
end)

local function addAnimatedBorder(parent, startThickness)
    local stroke = Instance.new("UIStroke")
    stroke.Color     = Color3.fromRGB(220, 0, 0)
    stroke.Thickness = startThickness or 3.5
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Parent    = parent
    table.insert(animatedBorders, stroke)
    return stroke
end

