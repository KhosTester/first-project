local function FindLiveNPC(fullName)
    local folder = GetNPCFolder()
    if not folder then return nil end
    for _, npc in ipairs(folder:GetChildren()) do
        if npc.Name == fullName and IsAlive(npc) then return npc end
    end
    return nil
end

-- [17] FindLiveBoss: dùng string.find để bắt cả suffix không khai báo
-- Ví dụ GojoBoss có thể spawn thành "GojoBoss" hoặc "GojoBoss_Phase2" v.v.
local function FindLiveBoss(def)
    local folder = GetNPCFolder()
    if not folder then return nil end

    -- Ưu tiên: exact match với forms đã khai báo
    if def.forms then
        for _, suf in ipairs(def.forms) do
            for _, npc in ipairs(folder:GetChildren()) do
                if npc.Name == def.name..suf and IsAlive(npc) then return npc end
            end
        end
    end

    -- Fallback: exact name
    for _, npc in ipairs(folder:GetChildren()) do
        if npc.Name == def.name and IsAlive(npc) then return npc end
    end

    -- [17] Fallback 2: prefix match — bắt tên có suffix bất kỳ
    -- Chỉ dùng khi forms=nil để tránh nhầm boss khác
    if not def.forms then
        for _, npc in ipairs(folder:GetChildren()) do
            if string.sub(npc.Name, 1, #def.name) == def.name and IsAlive(npc) then
                return npc
            end
        end
    end

    return nil
end

-- [15] Workspace-scan: build set tên NPC rồi scan folder 1 lần O(n)
-- Nhanh hơn nested loop IslandHasLiveNPCs cũ
local function BuildIslandWatchSet(defs)
    local set = {}
    for _, def in ipairs(defs) do
        for i = 1, def.max do
            set[def.prefix..i] = true
        end
    end
    return set
end

-- Trả về true nếu CÒN ít nhất 1 NPC sống trong watchSet
local function FolderHasAnyAlive(watchSet)
    local folder = GetNPCFolder()
    if not folder then return false end
    for _, child in ipairs(folder:GetChildren()) do
        if watchSet[child.Name] and IsAlive(child) then
            return true
        end
    end
    return false
end

-- [9] Kiểm tra các slot còn lại của 1 def (sau slot i) — giữ cho Specific loop
local function DefHasLiveNPCsAfter(def, afterIndex)
    for j = afterIndex + 1, def.max do
        if FindLiveNPC(def.prefix..j) then return true end
    end
    return false
end

-- ============================================================
--   GO AND FIGHT
-- ============================================================

local BOSS_RETP_COOLDOWN = 2.0
local NPC_RETP_COOLDOWN  = 0.5

local function ApproachCF(cf, speed)
    if Config.FarmMode == "TP" then
        local hrp = GetPlayerHRP()
        if hrp then hrp.CFrame = cf end
    else
        TweenTo(cf, speed)
    end
end

local function GoAndFight(npc, speed, isBoss)
    local root = GetRoot(npc)
    if not root then return end
    local s = tonumber(speed) or 0.3
    if s <= 0 then s = 0.3 end

    local targetCF = root.CFrame
    ApproachCF(targetCF, s)
    StartStaying(targetCF)

    local lastReApproach = tick()
    local cooldown  = isBoss and BOSS_RETP_COOLDOWN or NPC_RETP_COOLDOWN
    local loopWait  = Config.FarmMode == "TP" and 0.05 or 0.15

    while IsAlive(npc) do
        -- [7] Farm loop thoát sớm vì toggle đã bị tắt bởi boss
        if not isBoss and BossRunning then break end
        if not (root and root.Parent) then break end

        targetCF = root.CFrame
        stayCF   = targetCF

        local hrp = GetPlayerHRP()
        if hrp then
            local dist = (hrp.Position - targetCF.Position).Magnitude
            if dist > 15 and (tick() - lastReApproach) >= cooldown then
                lastReApproach = tick()
                StopStaying()
                if Config.FarmMode == "TP" then
                    hrp.CFrame = targetCF
                else
                    TweenTo(targetCF, Config.TweenSpeedNPC)
                end
                StartStaying(targetCF)
            end
        end

        task.wait(loopWait)
    end

    StopStaying()
end

