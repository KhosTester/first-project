-- ============================================================
--   SPECIFIC FARM LOOP  [15] workspace-scan island clear
-- ============================================================

task.spawn(function()
    while true do
        task.wait(0.2)
        if not Config.FarmEnabled then continue end

        local queue = {}
        for _, d in ipairs(FARM_DEFS) do
            if Config.SelectedFarmNPCs[d.label] then table.insert(queue, d) end
        end
        if #queue == 0 then task.wait(0.5); continue end

        -- Group queue theo island để build watchSet hiệu quả
        local islandDefs = {}   -- island → { defs }
        local islandOrder = {}  -- thứ tự island xuất hiện trong queue
        local seen = {}
        for _, def in ipairs(queue) do
            if not seen[def.island] then
                seen[def.island] = true
                table.insert(islandOrder, def.island)
                islandDefs[def.island] = {}
            end
            table.insert(islandDefs[def.island], def)
        end

        local anyKilled = false

        for ii, island in ipairs(islandOrder) do
            if not Config.FarmEnabled then break end

            local defs   = islandDefs[island]
            local needTP = currentIsland ~= island
            if needTP then
                local ok = TeleportToIsland(island)
                if not ok then task.wait(1); continue end
            end

            -- Tìm đảo tiếp theo (khác island) để pre-fire
            local nextIsland = islandOrder[ii + 1]

            -- [15] Build watchSet cho đảo này
            local watchSet = BuildIslandWatchSet(defs)
            local isFirst  = needTP
            local cleared  = false  -- [18] thay goto

            for _, def in ipairs(defs) do
                if not Config.FarmEnabled or cleared then break end
                if not Config.SelectedFarmNPCs[def.label] then continue end

                for i = 1, def.max do
                    if not Config.FarmEnabled or cleared then break end
                    if not Config.SelectedFarmNPCs[def.label] then break end

                    local npc = FindLiveNPC(def.prefix..i)
                    if npc then
                        anyKilled = true
                        local speed = isFirst and Config.TweenSpeedTP or Config.TweenSpeedNPC
                        GoAndFight(npc, speed)
                        isFirst = false

                        -- [15] Scan folder trực tiếp — nếu đảo sạch thì pre-fire và thoát
                        if not FolderHasAnyAlive(watchSet) then
                            if nextIsland then PreFirePortal(nextIsland) end
                            cleared = true  -- [18] thoát cả 2 vòng for
                            break
                        end
                        task.wait(GetInterNPC())
                    end
                end
                if not cleared then task.wait(GetInterDef()) end
            end
        end

        if not anyKilled then
            task.wait(Config.FarmMode == "TP" and 0.15 or 1.0)
        end
    end
end)

