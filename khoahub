-- ════ MACRO TAB ════════════════════════════════════════════════
local function buildMacroTab()
    -- ── State ──────────────────────────────────────────────────
    local macro = {
        running      = false,    -- true while combo is executing (blocks re-entry)
        shouldStop   = false,    -- set true when user wants to stop after current combo
        loopEnabled  = false,
        keyDelay     = 0.08,     -- delay between keys inside combo
        loopDelay    = 0.50,     -- delay between loop iterations
        selectedPreset = "G → 1",
        customKeys   = {},
        loopThread   = nil,
    }

    -- ── Presets ────────────────────────────────────────────────
    local PRESETS = {
        ["G → 1"] = {Enum.KeyCode.G, Enum.KeyCode.One},
        ["G → 2"] = {Enum.KeyCode.G, Enum.KeyCode.Two},
        ["G → 3"] = {Enum.KeyCode.G, Enum.KeyCode.Three},
        ["G → 4"] = {Enum.KeyCode.G, Enum.KeyCode.Four},
        ["G → 5"] = {Enum.KeyCode.G, Enum.KeyCode.Five},
        ["G → 6"] = {Enum.KeyCode.G, Enum.KeyCode.Six},
        ["G → 1→2→3→4→5→6"] = {
            Enum.KeyCode.G, Enum.KeyCode.One,
            Enum.KeyCode.G, Enum.KeyCode.Two,
            Enum.KeyCode.G, Enum.KeyCode.Three,
            Enum.KeyCode.G, Enum.KeyCode.Four,
            Enum.KeyCode.G, Enum.KeyCode.Five,
            Enum.KeyCode.G, Enum.KeyCode.Six,
        },
        ["Space"]  = {Enum.KeyCode.Space},
        ["Ctrl"]   = {Enum.KeyCode.LeftControl},
        ["Custom"] = {},
    }
    local PRESET_NAMES = {
        "G → 1","G → 2","G → 3","G → 4","G → 5","G → 6",
        "G → 1→2→3→4→5→6",
        "Space","Ctrl","Custom",
    }

    -- ── Key resolver ───────────────────────────────────────────
    local KEY_MAP = {
        space=Enum.KeyCode.Space, ctrl=Enum.KeyCode.LeftControl,
        leftcontrol=Enum.KeyCode.LeftControl, rightcontrol=Enum.KeyCode.RightControl,
        shift=Enum.KeyCode.LeftShift, leftshift=Enum.KeyCode.LeftShift,
        rightshift=Enum.KeyCode.RightShift, alt=Enum.KeyCode.LeftAlt,
        e=Enum.KeyCode.E, f=Enum.KeyCode.F, g=Enum.KeyCode.G, q=Enum.KeyCode.Q,
        r=Enum.KeyCode.R, t=Enum.KeyCode.T, x=Enum.KeyCode.X, z=Enum.KeyCode.Z,
        ["1"]=Enum.KeyCode.One,   ["2"]=Enum.KeyCode.Two,   ["3"]=Enum.KeyCode.Three,
        ["4"]=Enum.KeyCode.Four,  ["5"]=Enum.KeyCode.Five,  ["6"]=Enum.KeyCode.Six,
        ["7"]=Enum.KeyCode.Seven, ["8"]=Enum.KeyCode.Eight, ["9"]=Enum.KeyCode.Nine,
        ["0"]=Enum.KeyCode.Zero,
        w=Enum.KeyCode.W, a=Enum.KeyCode.A, s=Enum.KeyCode.S, d=Enum.KeyCode.D,
    }
    local function resolveKey(str)
        local s = str:lower():gsub("%s+","")
        if s == "" then return nil end
        local kc = KEY_MAP[s]; if kc then return kc end
        local ok, val = pcall(function() return Enum.KeyCode[str] end)
        if ok and val then return val end
        return nil
    end

    -- ── Get active key list ────────────────────────────────────
    local function getKeys()
        if macro.selectedPreset == "Custom" then return macro.customKeys end
        return PRESETS[macro.selectedPreset] or {}
    end

    -- ── Send one key press + release ───────────────────────────
    local function sendKey(kc)
        pcall(function()
            VIM:SendKeyEvent(true,  kc, false, game)
            task.wait(0.04)
            VIM:SendKeyEvent(false, kc, false, game)
        end)
    end

    -- ── Run combo once, returns when finished ──────────────────
    -- Respects macro.shouldStop only AFTER the full combo finishes
    local function runCombo()
        local keys = getKeys()
        if #keys == 0 then return end
        for _, kc in ipairs(keys) do
            sendKey(kc)
            task.wait(macro.keyDelay)
        end
    end

    -- ── Status paragraph ref ───────────────────────────────────
    local statusPara = nil
    local function updateStatus()
        if not statusPara then return end
        local keys = getKeys()
        local state = macro.running and "Running" or "Idle"
        local loop  = macro.loopEnabled and "ON" or "OFF"
        pcall(function()
            statusPara:SetDesc(state.." | Loop: "..loop.." | Keys: "..#keys)
        end)
    end

    -- ── Stop loop ──────────────────────────────────────────────
    local function stopMacro()
        macro.shouldStop = true
        -- loopThread will exit after current combo finishes
    end

    -- ── Start: run once or loop ────────────────────────────────
    local function startMacro()
        if macro.running then
            -- Already running — signal stop after current combo
            stopMacro(); return
        end
        local keys = getKeys()
        if #keys == 0 then
            
            return
        end
        macro.shouldStop = false
        macro.running    = true
        updateStatus()

        macro.loopThread = task.spawn(function()
            repeat
                runCombo()
                if macro.loopEnabled and not macro.shouldStop then
                    task.wait(macro.loopDelay)
                end
            until not macro.loopEnabled or macro.shouldStop

            macro.running    = false
            macro.shouldStop = false
            macro.loopThread = nil
            -- Sync toggle button back to OFF
            pcall(function() toggleRefs["MacroEnable"]:SetValue(false) end)

            updateStatus()
        end)
    end

    -- ── Toggle handler (called by keybind, button, toggle) ─────
    local function toggleMacro()
        if macro.running then
            stopMacro()
        else
            startMacro()
        end
        updateStatus()
    end

    -- ── Keybind (default Z) ────────────────────────────────────
    local macroKeyConn = nil
    local function rebuildKeybind(kc)
        if macroKeyConn then macroKeyConn:Disconnect(); macroKeyConn = nil end
        if not kc or kc == Enum.KeyCode.Unknown then return end
        macroKeyConn = UserInputService.InputBegan:Connect(function(inp, gpe)
            if gpe then return end
            if inp.KeyCode ~= kc then return end
            toggleMacro()
        end)
    end
    rebuildKeybind(Enum.KeyCode.Z)

    -- ── Mobile Button ──────────────────────────────────────────
    -- A floating on-screen button positioned above the Roblox jump button.
    -- Tapping it calls toggleMacro() — same as the keybind.
    local mobileBtnGui = nil

    local function destroyMobileButton()
        if mobileBtnGui then
            pcall(function() mobileBtnGui:Destroy() end)
            mobileBtnGui = nil
        end
    end

    local function createMobileButton()
        destroyMobileButton()

        -- Create ScreenGui
        mobileBtnGui = Instance.new("ScreenGui")
        mobileBtnGui.Name            = "FemboyMacroMobileBtn"
        mobileBtnGui.ResetOnSpawn    = false
        mobileBtnGui.ZIndexBehavior  = Enum.ZIndexBehavior.Sibling
        mobileBtnGui.IgnoreGuiInset  = true
        pcall(function() mobileBtnGui.Parent = CoreGui end)
        if not mobileBtnGui.Parent then
            mobileBtnGui.Parent = player.PlayerGui
        end

        -- Outer frame (draggable shell + visual border)
        local frame = Instance.new("Frame")
        frame.Name                  = "MacroMobileBtnFrame"
        frame.Size                  = UDim2.fromOffset(72, 72)
        -- Positioned above the jump button (bottom-right area)
        -- Roblox jump button is roughly at (1, -90, 1, -90) from bottom-right
        frame.Position              = UDim2.new(1, -100, 1, -180)
        frame.BackgroundColor3      = Color3.fromRGB(18, 18, 24)
        frame.BackgroundTransparency = 0.08
        frame.BorderSizePixel       = 0
        frame.ZIndex                = 50
        frame.Parent                = mobileBtnGui
        Instance.new("UICorner", frame).CornerRadius = UDim.new(1, 0)

        -- Animated red border (reuse the hub's addAnimatedBorder)
        addAnimatedBorder(frame, 3)

        -- The actual TextButton
        local btn = Instance.new("TextButton")
        btn.Name                  = "MacroMobileBtn"
        btn.Size                  = UDim2.new(1, -6, 1, -6)
        btn.Position              = UDim2.new(0, 3, 0, 3)
        btn.BackgroundColor3      = Color3.fromRGB(30, 30, 40)
        btn.BackgroundTransparency = 0.15
        btn.BorderSizePixel       = 0
        btn.Text                  = "MACRO"
        btn.TextColor3            = Color3.fromRGB(220, 220, 220)
        btn.Font                  = Enum.Font.GothamBold
        btn.TextSize              = 13
        btn.ZIndex                = 51
        btn.AutoButtonColor       = false
        btn.Parent                = frame
        Instance.new("UICorner", btn).CornerRadius = UDim.new(1, 0)

        -- Visual feedback: flash button on press
        local function flashBtn(active)
            if active then
                btn.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
                btn.TextColor3       = Color3.fromRGB(255, 255, 255)
            else
                btn.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
                btn.TextColor3       = Color3.fromRGB(220, 220, 220)
            end
        end

        -- Update label to reflect macro state
        local function refreshLabel()
            if macro.running then
                btn.Text       = "STOP"
                btn.TextColor3 = Color3.fromRGB(255, 100, 100)
            else
                btn.Text       = "MACRO"
                btn.TextColor3 = Color3.fromRGB(220, 220, 220)
            end
        end

        btn.MouseButton1Down:Connect(function()
            flashBtn(true)
            toggleMacro()
            task.delay(0.12, function() flashBtn(false); refreshLabel() end)
        end)

        -- Keep label in sync while button exists
        task.spawn(function()
            while mobileBtnGui and mobileBtnGui.Parent do
                refreshLabel()
                task.wait(0.25)
            end
        end)

        -- Make the frame draggable
        local dragging, dragStart, startPos = false, nil, nil
        frame.InputBegan:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.Touch
            or inp.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging  = true
                dragStart = inp.Position
                startPos  = frame.Position
            end
        end)
        frame.InputEnded:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.Touch
            or inp.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = false
            end
        end)
        UserInputService.InputChanged:Connect(function(inp)
            if not dragging then return end
            if inp.UserInputType ~= Enum.UserInputType.Touch
            and inp.UserInputType ~= Enum.UserInputType.MouseMovement then return end
            if not mobileBtnGui or not mobileBtnGui.Parent then return end
            local delta = inp.Position - dragStart
            frame.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end)
    end

    -- ════ UI ═══════════════════════════════════════════════════
    local sMacro = Tabs.Macro:AddSection("Macro")

    -- Status
    statusPara = sMacro:AddParagraph({Title="State", Content="Idle | Loop: OFF | Keys: 0"})

    -- Preset dropdown
    sMacro:AddDropdown("MacroPreset", {
        Title   = "Select Preset",
        Values  = PRESET_NAMES,
        Default = "G → 1",
        Callback = function(v)
            macro.selectedPreset = tostring(v)
            updateStatus()
        end,
    })

    -- Custom keys
    local customRaw = ""
    sMacro:AddInput("MacroCustomInput", {
        Title       = "Key sequence",
        Default     = "",
        Placeholder = "e.g. G,1,G,2 or Q,E",
        Numeric     = false, Finished = false,
        Callback    = function(v) customRaw = v end,
    })
    local customStatus = sMacro:AddParagraph({Title="Custom", Content="(not applied)"})
    sMacro:AddButton({Title="Apply Custom Keys", Callback=function()
        local parts = {}
        for seg in customRaw:gmatch("[^,]+") do
            local t = seg:match("^%s*(.-)%s*$")
            if t ~= "" then table.insert(parts, t) end
        end
        macro.customKeys = {}
        local ok, fail = 0, 0
        for _, name in ipairs(parts) do
            local kc = resolveKey(name)
            if kc then table.insert(macro.customKeys, kc); ok = ok + 1
            else fail = fail + 1 end
        end
        local msg = ok.." key(s) applied"
        if fail > 0 then msg = msg.." | "..fail.." unrecognized" end
        pcall(function() customStatus:SetDesc(msg) end)
        macro.selectedPreset = "Custom"
        pcall(function() Fluent.Options.MacroPreset:SetValue("Custom") end)
        updateStatus()
    end})
    sMacro:AddButton({Title="Clear Custom Keys", Callback=function()
        macro.customKeys = {}
        pcall(function() customStatus:SetDesc("Cleared.") end)
        updateStatus()
    end})

    -- Timing
    sMacro:AddSlider("MacroKeyDelay", {
        Title    = "Delay between keys (ms)",
        Default  = 80, Min = 10, Max = 1000, Rounding = 0,
        Callback = function(v) macro.keyDelay = v / 1000 end,
    })
    sMacro:AddSlider("MacroLoopDelay", {
        Title    = "Delay between loops (ms)",
        Default  = 500, Min = 10, Max = 1000, Rounding = 0,
        Callback = function(v) macro.loopDelay = v / 1000 end,
    })

    -- Loop + Enable + Keybind + Mobile
    toggleRefs["MacroLoop"] = sMacro:AddToggle("MacroLoop", {
        Title    = "Infinite Loop",
        Default  = false,
        Callback = function(v) macro.loopEnabled = v; updateStatus() end,
    })
    toggleRefs["MacroEnable"] = sMacro:AddToggle("MacroEnable", {
        Title    = "Enable Macro",
        Default  = false,
        Callback = function(v)
            if v then startMacro() else stopMacro() end
        end,
    })
    sMacro:AddKeybind("MacroKeybind", {
        Title           = "Keybind (default: Z)",
        Default         = "Z",
        Callback        = function() end,
        ChangedCallback = function(new) rebuildKeybind(new) end,
    })
    toggleRefs["MacroMobileBtn"] = sMacro:AddToggle("MacroMobileBtn", {
        Title    = "Mobile Button",
        Default  = false,
        Callback = function(v)
            if v then createMobileButton() else destroyMobileButton() end
        end,
    })

end

buildMacroTab()

SaveManager:LoadAutoloadConfig()
Window:SelectTab(1)
