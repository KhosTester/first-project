local function resolveBodyPart(character, label)
    if not character then return nil end
    local candidates = UNUSUAL_PART_RESOLVE[label]
    if candidates then
        for _, name in ipairs(candidates) do
            local part = character:FindFirstChild(name)
            if part then return part end
        end
    end
    return character:FindFirstChild(label) or character:FindFirstChild("Head")
end

