-- AVOID BOT  —  TP orbit around bot when it gets too close
-- ══════════════════════════════════════════════════════════════
local avoidBot = {conn=nil, TRIGGER_DIST=15, ORBIT_RADIUS=20, cooldown=0}

local function enableAvoidBot()
    if avoidBot.conn then avoidBot.conn:Disconnect() end
    avoidBot.conn = RunService.Heartbeat:Connect(function()
        if not st.AvoidBot then return end
        local c    = player.Character; if not c then return end
        local root = c:FindFirstChild("HumanoidRootPart"); if not root then return end
        local hum  = c:FindFirstChild("Humanoid")
        if not hum or hum.Health <= 0 then return end

        local myPos = root.Position
        local now   = tick()

        local gpFolder = getGamePlayersFolder()
        if not gpFolder then return end

        local closestDist = math.huge
        local closestBot  = nil

        for _, model in ipairs(gpFolder:GetChildren()) do
            if isEvadeBot(model) then
                local botRoot = model:FindFirstChild("HumanoidRootPart")
                             or model.PrimaryPart
                             or model:FindFirstChildWhichIsA("BasePart")
                if botRoot then
                    local dist = (botRoot.Position - myPos).Magnitude
                    if dist < avoidBot.TRIGGER_DIST and dist < closestDist then
                        closestDist = dist
                        closestBot  = botRoot
                    end
                end
            end
        end

        if closestBot and now - avoidBot.cooldown > 0.28 then
            avoidBot.cooldown = now
            local botPos = closestBot.Position
            local r      = avoidBot.ORBIT_RADIUS

            -- Generate 12 candidate orbit points around the bot in a horizontal circle
            local bestPt    = nil
            local bestScore = -math.huge
            for i = 0, 11 do
                local angle  = (i / 12) * math.pi * 2
                local pt     = Vector3.new(
                    botPos.X + math.cos(angle) * r,
                    botPos.Y + 3,
                    botPos.Z + math.sin(angle) * r
                )
                -- Prefer the point that is farthest from current player position
                -- (moves player to the opposite side of the bot from where they are)
                local score = (pt - myPos).Magnitude
                if score > bestScore then bestScore = score; bestPt = pt end
            end

            if bestPt then
                root.CFrame = CFrame.new(bestPt)
                pcall(function() root.AssemblyLinearVelocity = Vector3.new() end)
            end
        end
    end)
end

local function disableAvoidBot()
    if avoidBot.conn then avoidBot.conn:Disconnect(); avoidBot.conn = nil end
end

-- ══════════════════════════════════════════════════════════════
-- BETTER BOUNCE
-- ══════════════════════════════════════════════════════════════
local function enableBetterBounce()
    if bb.conn then bb.conn:Disconnect() end
    bb.peakFlatSpeed = 0; bb.boosted = false; bb.wasAirborne = false
    bb.bankedSpeed = 0; bb.landedTime = 0; bb.lastGroundedTime = 0

    bb.conn = RunService.Heartbeat:Connect(function()
        if not st.BetterBounce then return end
        if not hrp or not humanoid or humanoid.Health <= 0 then return end

        local vel        = hrp.AssemblyLinearVelocity
        local isAirborne = (humanoid.FloorMaterial == Enum.Material.Air)
        local flatVel    = Vector3.new(vel.X, 0, vel.Z)
        local flatSpeed  = flatVel.Magnitude
        local now        = tick()

        -- ── Track last grounded time (cho Coyote Jump) ────────────────
        if not isAirborne then
            bb.lastGroundedTime = now
        end

        -- ── Vừa rời đất → reset trạng thái boost ─────────────────────
        if not bb.wasAirborne and isAirborne then
            bb.peakFlatSpeed = flatSpeed
            bb.boosted       = false
        end

        -- ── Tính effective airborne: thật sự đang bay hoặc trong cửa sổ Coyote
        local coyoteActive = bb.coyoteEnabled
            and isAirborne
            and (now - bb.lastGroundedTime) <= bb.coyoteWindow

        local effectiveAirborne = isAirborne

        if effectiveAirborne then
            -- ── Kiểm tra trigger: vel.Y vượt ngưỡng HOẶC đang trong cửa sổ Coyote
            -- Yêu cầu peakFlatSpeed > minFlatSpeed để tránh boost khi nhảy thường
            local triggerByVelocity = vel.Y > bb.minTriggerY and vel.Y < 85
                and bb.peakFlatSpeed > bb.minFlatSpeed
            local triggerByCoyote   = coyoteActive and not bb.boosted
                and (now - bb.lastGroundedTime) > 0.02  -- loại bỏ frame đầu rời đất
                and bb.peakFlatSpeed > bb.minFlatSpeed

            if not bb.boosted and (triggerByVelocity or triggerByCoyote) then
                bb.boosted = true

                local rawNewY = math.min(vel.Y * bb.yBoost, 130)

                -- ── Feature 7: Momentum Banking ─────────────────────────────
                -- Nếu nhảy lại trong bankWindow sau khi chạm đất, cộng bankedSpeed vào Y
                if bb.bankEnabled
                    and bb.bankedSpeed > 0
                    and (now - bb.landedTime) <= bb.bankWindow then
                    local bankAdd = bb.bankedSpeed * bb.bankBonus
                    rawNewY = math.min(rawNewY + bankAdd, 150)  -- cap cao hơn khi banking
                end

                -- ── Feature 8: Directional Boost ────────────────────────────
                -- Nghiêng boost nhẹ theo hướng camera LookVector
                local newX, newZ = vel.X, vel.Z
                if bb.dirBoostEnabled and bb.dirBlend > 0 then
                    local cam     = workspace.CurrentCamera
                    local look    = cam.CFrame.LookVector
                    -- Lấy hướng ngang của camera (bỏ Y)
                    local camFlat = Vector3.new(look.X, 0, look.Z)
                    if camFlat.Magnitude > 0.01 then
                        camFlat = camFlat.Unit
                        -- Blend: giữ momentum hiện tại + thêm một phần theo hướng camera
                        local blendedFlat = flatVel.Magnitude > 0.5
                            and (flatVel.Unit * (1 - bb.dirBlend) + camFlat * bb.dirBlend).Unit
                            or  camFlat
                        local newFlat = blendedFlat * math.max(flatSpeed, 1)
                        newX = newFlat.X
                        newZ = newFlat.Z
                    end
                end

                hrp.AssemblyLinearVelocity = Vector3.new(newX, rawNewY, newZ)
            end

            -- ── Bù tốc độ ngang bị mất trong không khí (Air Speed Retention) ──
            if bb.peakFlatSpeed > bb.minFlatSpeed and flatSpeed > 3 then
                local speedLoss = bb.peakFlatSpeed - flatSpeed
                if speedLoss > 0.4 then
                    local compensate = flatVel.Unit * speedLoss * bb.retainFactor
                    local curVel     = hrp.AssemblyLinearVelocity
                    hrp.AssemblyLinearVelocity = Vector3.new(
                        curVel.X + compensate.X,
                        curVel.Y,
                        curVel.Z + compensate.Z
                    )
                end
            end

        else
            -- ── Chạm đất ─────────────────────────────────────────────────
            if bb.wasAirborne and bb.peakFlatSpeed > 25 and flatSpeed > 3 then
                -- Landing Momentum Keep
                local keepDir = flatVel.Unit
                hrp.AssemblyLinearVelocity = Vector3.new(
                    keepDir.X * bb.peakFlatSpeed * bb.landingKeep,
                    vel.Y,
                    keepDir.Z * bb.peakFlatSpeed * bb.landingKeep
                )
            end

            -- ── Feature 7: Lưu bankedSpeed khi chạm đất ──────────────────
            if bb.wasAirborne then
                if bb.bankEnabled and bb.peakFlatSpeed > bb.minFlatSpeed then
                    bb.bankedSpeed = bb.peakFlatSpeed
                    bb.landedTime  = now
                end
                bb.peakFlatSpeed = 0
                bb.boosted       = false
            end
        end

        bb.wasAirborne = isAirborne
    end)
end
local function disableBetterBounce()
    if bb.conn then bb.conn:Disconnect(); bb.conn = nil end
    bb.peakFlatSpeed = 0; bb.boosted = false; bb.wasAirborne = false
    bb.bankedSpeed = 0; bb.landedTime = 0; bb.lastGroundedTime = 0
end

-- ══════════════════════════════════════════════════════════════
-- AIR STRAFE
-- ══════════════════════════════════════════════════════════════
local function enableAirStrafe()
    if as.conn then as.conn:Disconnect() end
    as.conn = RunService.Heartbeat:Connect(function(dt)
        if not st.AirStrafe then return end
        if not hrp or not humanoid or humanoid.Health <= 0 then return end
        if humanoid.FloorMaterial ~= Enum.Material.Air then return end
        local pressA = UserInputService:IsKeyDown(Enum.KeyCode.A)
        local pressD = UserInputService:IsKeyDown(Enum.KeyCode.D)
        if not pressA and not pressD then return end
        local cam     = workspace.CurrentCamera
        local vel     = hrp.AssemblyLinearVelocity
        local flatVel = Vector3.new(vel.X, 0, vel.Z)
        local camRight = cam.CFrame.RightVector
        local wishDir  = Vector3.new(camRight.X, 0, camRight.Z)
        if wishDir.Magnitude < 0.01 then return end
        wishDir = wishDir.Unit
        if pressA then wishDir = -wishDir end
        local currentSpeedAlongWish = flatVel:Dot(wishDir)
        local addSpeed = as.maxSpeed - currentSpeedAlongWish
        if addSpeed <= 0 then return end
        local accelThisFrame = math.min(as.accel * dt, addSpeed)
        local push   = wishDir * accelThisFrame
        local newVel = Vector3.new(vel.X + push.X, vel.Y, vel.Z + push.Z)
        hrp.AssemblyLinearVelocity = newVel
    end)
end
local function disableAirStrafe()
    if as.conn then as.conn:Disconnect(); as.conn = nil end
end

