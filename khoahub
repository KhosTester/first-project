-- ============================================================
--   AUTO SKILL LOOP
--   Handler riêng để track lastFired (không duplicate cooldown update)
-- ============================================================

task.spawn(function()
    local prevEnabled   = false
    local lastFiredSlot = 0
    local lastFiredTime = 0

    -- Track fired slot ONLY (cooldown đã xử lý bởi handler ngoài)
    RS.AbilitySystem.Remotes.AbilityFeedback.OnClientEvent:Connect(function(data)
        if type(data) ~= "table" then return end
        if data.Caster ~= LocalPlayer then return end
        if data.AbilitySlot then
            lastFiredSlot = data.AbilitySlot
            lastFiredTime = tick()
        end
    end)

    while true do
        task.wait(0.1)

        if not Config.AutoSkillEnabled then
            if prevEnabled then
                task.spawn(DisableAllSkillsInGameUI)
                prevEnabled = false
                SetAutoSkillSlot(0)
            end
            continue
        end

        prevEnabled = true

        local hasSkills = false
        for _ in pairs(Config.SelectedSkills) do hasSkills = true; break end
        if not hasSkills then task.wait(0.3); continue end

        for _, key in ipairs(SKILL_ORDER) do
            if not Config.AutoSkillEnabled then break end
            if not Config.SelectedSkills[key] then continue end

            local slotNum = SKILL_SLOTS[key]
            if IsSkillOnCooldown(slotNum) then continue end

            EnableSkillInGameUI(key)
            SetAutoSkillSlot(slotNum)

            local timeout       = 3.0
            local waited        = 0
            local confirmed     = false
            local prevFiredTime = lastFiredTime

            while waited < timeout do
                if not Config.AutoSkillEnabled then break end
                task.wait(0.1); waited += 0.1
                if lastFiredSlot == slotNum and lastFiredTime ~= prevFiredTime then
                    confirmed = true; break
                end
            end

            DisableSkillInGameUI(key)
            SetAutoSkillSlot(0)

            if confirmed then
                local cd = SkillCooldowns[slotNum]
                if cd then
                    while tick() < cd do
                        if not Config.AutoSkillEnabled then break end
                        task.wait(0.2)
                    end
                end
            else
                task.wait(0.5)
            end

            task.wait(0.1)
        end
    end
end)

-- ============================================================
--   SPEED LOOP (keep WalkSpeed synced khi CharacterAdded)
-- ============================================================

task.spawn(function()
    while true do
        task.wait(1)
        if Config.SpeedEnabled then
            local hum = GetPlayerHum()
            if hum and hum.WalkSpeed ~= Config.SpeedValue then
                hum.WalkSpeed = Config.SpeedValue
            end
        end
    end
end)

-- ============================================================
--   CLEANUP on Respawn
-- ============================================================

LocalPlayer.CharacterAdded:Connect(function()
    CancelTween(); StopStaying()
    ComboIndex = 0; currentIsland = nil; BossActive = false
    spawnedBossQueue = {}; spawnedBossSet = {}
    SkillCooldowns = {}
    SetAutoSkillSlot(0)
    task.spawn(HideSkillUI)

    -- Re-apply player features after respawn
    task.wait(1)
    if Config.SpeedEnabled  then StartSpeed(Config.SpeedValue) end
    if Config.InfinityJump  then StopInfinityJump(); StartInfinityJump() end
    if noClipCount > 0      then RemoveNoClip(); ApplyNoClip() end
    if Config.AntiBanBlock  then StopAntiBanBlock(); StartAntiBanBlock() end
end)

