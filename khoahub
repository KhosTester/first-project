local function buildSnowEmitter(parent)
    local emitter = Instance.new("ParticleEmitter")
    emitter.EmissionDirection = Enum.NormalId.Bottom
    emitter.Texture        = "rbxassetid://242109931"
    emitter.Color          = ColorSequence.new({
        ColorSequenceKeypoint.new(0,   Color3.fromRGB(235,245,255)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255,255,255)),
        ColorSequenceKeypoint.new(1,   Color3.fromRGB(220,235,255)),
    })
    emitter.LightEmission  = 0.6; emitter.LightInfluence = 0.85
    emitter.Rate           = math.max(1, snowCfg.rate)
    emitter.Speed          = NumberRange.new(math.max(0.1, snowCfg.fallSpeed*0.6), math.max(0.2, snowCfg.fallSpeed))
    emitter.Lifetime       = NumberRange.new(3.0, 5.0)
    local sz               = math.max(0.01, snowCfg.size)
    emitter.Size           = NumberSequence.new({
        NumberSequenceKeypoint.new(0,    0.0),
        NumberSequenceKeypoint.new(0.10, sz),
        NumberSequenceKeypoint.new(0.85, sz*0.95),
        NumberSequenceKeypoint.new(1,    0.0),
    })
    emitter.Squash         = NumberSequence.new({NumberSequenceKeypoint.new(0,0), NumberSequenceKeypoint.new(1,0)})
    emitter.Transparency   = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 1.0), NumberSequenceKeypoint.new(0.12, 0.12),
        NumberSequenceKeypoint.new(0.88, 0.12), NumberSequenceKeypoint.new(1, 1.0),
    })
    emitter.Acceleration   = Vector3.new(3,-5,0)
    emitter.Rotation       = NumberRange.new(-180,180); emitter.RotSpeed = NumberRange.new(-30,30)
    emitter.SpreadAngle    = Vector2.new(18,18); emitter.LockedToPart = false
    pcall(function() emitter.EmitterShape = Enum.ParticleEmitterShape.Box end)
    emitter.Parent = parent
end

local function rebuildSnowEmitter()
    if not weather.part or not weather.part.Parent then return end
    if weather.lastType ~= "Snow" then return end
    for _, e in pairs(weather.part:GetChildren()) do
        if e:IsA("ParticleEmitter") then pcall(function() e:Destroy() end) end
    end
    buildSnowEmitter(weather.part)
end

