local function DoAttack()
    local hrp  = GetPlayerHRP()
    local tool = GetEquippedTool()
    if not hrp or not tool then return end
    ComboIndex = (ComboIndex % 3) + 1
    pcall(function()
        RequestHit:FireServer({
            ComboIndex = ComboIndex,
            HitName    = "Strike "..ComboIndex,
            CFrame     = hrp.CFrame,
            Position   = hrp.Position,
            WeaponName = tool.Name,
            Timestamp  = tick(),
            HitCount   = ComboIndex - 1,
            Caster     = LocalPlayer,
        })
    end)
end

