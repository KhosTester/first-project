-- ============================================================
--   BOSS LOOP  [7][16]
--   Sau khi kill boss, drain tất cả boss cùng đảo trong queue
--   trước khi restore farm → không cần TP lại cùng đảo
-- ============================================================

-- Helper: lấy và xóa boss cùng island khỏi queue
local function PopSameIslandBoss(island)
    for i, qdef in ipairs(spawnedBossQueue) do
        if qdef.island == island then
            spawnedBossSet[qdef.name] = nil
            return table.remove(spawnedBossQueue, i)
        end
    end
    return nil
end

task.spawn(function()
    while true do
        task.wait(0.2)
        if not Config.BossEnabled then
            if BossRunning then
                BossRunning = false
                if savedFarmMode ~= "none" then ResumeFarmAfterBoss() end
            end
            spawnedBossQueue = {}
            spawnedBossSet   = {}
            continue
        end

        -- Scan workspace nếu boss đang sống nhưng chưa trong queue
        for _, def in ipairs(BOSS_DEFS) do
            if not Config.SelectedBossNPCs[def.label] then continue end
            if spawnedBossSet[def.name] then continue end
            if FindLiveBoss(def) then
                spawnedBossSet[def.name] = true
                table.insert(spawnedBossQueue, def)
            end
        end

        -- Prune: loại boss đã chết khỏi queue
        local i = 1
        while i <= #spawnedBossQueue do
            if not FindLiveBoss(spawnedBossQueue[i]) then
                spawnedBossSet[spawnedBossQueue[i].name] = nil
                table.remove(spawnedBossQueue, i)
            else
                i += 1
            end
        end

        if #spawnedBossQueue == 0 then continue end

        local def = table.remove(spawnedBossQueue, 1)
        spawnedBossSet[def.name] = nil
        if not FindLiveBoss(def) then continue end

        -- Tắt farm thật sự trước khi bắt đầu boss
        PauseFarmForBoss()
        BossRunning   = true
        currentIsland = nil

        Fluent:Notify({ Title="Boss!", Content=def.name.." — tạm dừng farm, đang đến!", Duration=3 })

        local tpOk = TeleportToIsland(def.island)

        if not Config.BossEnabled then
            BossRunning = false; currentIsland = nil; ResumeFarmAfterBoss(); continue
        end

        if not tpOk then
            table.insert(spawnedBossQueue, def)
            spawnedBossSet[def.name] = true
            BossRunning = false; currentIsland = nil; ResumeFarmAfterBoss()
            task.wait(2); continue
        end

        -- Fight boss đầu tiên
        local boss = FindLiveBoss(def)
        if boss then
            GoAndFight(boss, Config.TweenSpeedTP, true)
        end

        -- [16] Drain tất cả boss CÙng đảo trong queue — không TP lại
        while Config.BossEnabled do
            -- Rescan workspace trước khi lấy boss tiếp
            for _, scanDef in ipairs(BOSS_DEFS) do
                if not Config.SelectedBossNPCs[scanDef.label] then continue end
                if spawnedBossSet[scanDef.name] then continue end
                if scanDef.island ~= def.island then continue end
                if FindLiveBoss(scanDef) then
                    spawnedBossSet[scanDef.name] = true
                    table.insert(spawnedBossQueue, scanDef)
                end
            end

            local nextDef = PopSameIslandBoss(def.island)
            if not nextDef then break end
            if not FindLiveBoss(nextDef) then continue end

            Fluent:Notify({
                Title   = "Boss tiếp theo!",
                Content = nextDef.name.." — cùng đảo, đang tiến đến!",
                Duration = 2,
            })

            local nextBoss = FindLiveBoss(nextDef)
            if nextBoss then
                -- Cùng đảo → dùng TweenSpeedNPC (nhanh), không TP
                GoAndFight(nextBoss, Config.TweenSpeedNPC, true)
            end
            def = nextDef
        end

        -- Xong tất cả boss trên đảo này
        BossRunning   = false
        currentIsland = nil
        ResumeFarmAfterBoss()
        Fluent:Notify({ Title="Boss xong!", Content="Đã kill xong — tiếp tục farm.", Duration=3 })
        task.wait(0.3)
    end
end)

