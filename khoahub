        end
        refreshStatus()
    end})

    -- Status paragraph
    swStatusPara = sSwap:AddParagraph({Title = "Status", Content = "Not Active."})
    refreshStatus()

    -- Survive respawn
    player.CharacterRemoving:Connect(function()
        if next(swPairs) then pcall(resetAllSwaps) end
    end)
    player.CharacterAdded:Connect(function()
        task.wait(1)
        if next(swPairs) then
            for cur, sel in pairs(swPairs) do pcall(swapNames, cur, sel) end
