        and frame.Frame.Content:FindFirstChild("Settings")
        and frame.Frame.Content.Settings:FindFirstChild("Toggle_AutoSkill"..key)
    if not toggle then return nil, nil end
    local holder = toggle:FindFirstChild("SettingsHolder")
    if not holder then return nil, nil end
    return holder:FindFirstChild("On"), holder:FindFirstChild("Off")
end

