local function FindLiveNPC(fullName)
    local folder = GetNPCFolder()
    if not folder then return nil end
    for _, npc in ipairs(folder:GetChildren()) do
        if npc.Name == fullName and IsAlive(npc) then return npc end
    end
    return nil
end

local function FindLiveBoss(def)
    local folder = GetNPCFolder()
    if not folder then return nil end
    if def.forms then
        for _, suf in ipairs(def.forms) do
            for _, npc in ipairs(folder:GetChildren()) do
                if npc.Name == def.name..suf and IsAlive(npc) then return npc end
            end
        end
    else
        for _, npc in ipairs(folder:GetChildren()) do
            if npc.Name == def.name and IsAlive(npc) then return npc end
        end
    end
    return nil
end

