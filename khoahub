local function GetNPCFolder()
    return workspace:FindFirstChild("NPCs")
        or workspace:FindFirstChild("NPCS")
        or workspace:FindFirstChild("Npcs")
end

local function IsAlive(model)
    if not model or not model.Parent then return false end
    local h = model:FindFirstChildOfClass("Humanoid")
    if h then return h.Health > 0 end
    local hp = model:FindFirstChild("Health") or model:FindFirstChild("HP")
    if hp and (hp:IsA("IntValue") or hp:IsA("NumberValue")) then
        return hp.Value > 0
    end
    return false
end

-- [v39] FIX 1: GetRoot mạnh hơn — fallback tìm cả descendants
-- Nguyên nhân boss không di chuyển: GetRoot() trả nil → GoAndFight return ngay
local function GetRoot(model)
    if not model then return nil end
    -- Thử các tên phổ biến trước
    local root = model:FindFirstChild("HumanoidRootPart")
        or model:FindFirstChild("RootPart")
        or model:FindFirstChild("Torso")
        or model.PrimaryPart
    if root then return root end
    -- Fallback: tìm trong descendants
    for _, p in ipairs(model:GetDescendants()) do
        if p:IsA("BasePart") and p.Name == "HumanoidRootPart" then return p end
    end
    for _, p in ipairs(model:GetDescendants()) do
        if p:IsA("BasePart") and p.Name == "RootPart" then return p end
    end
    for _, p in ipairs(model:GetDescendants()) do
        if p:IsA("BasePart") and p.Name == "Torso" then return p end
    end
    -- Last resort: bất kỳ BasePart nào
    for _, p in ipairs(model:GetDescendants()) do
        if p:IsA("BasePart") then return p end
    end
    return nil
end

