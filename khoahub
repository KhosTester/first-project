local function tasPlay()
    if #tas.frames==0 then return end
    
    local timePlay=tick(); local fc=#tas.frames; local of=1
    local loop; loop=RunService.Heartbeat:Connect(function()
        if (tick()-timePlay)>=tas.frames[fc][3] then loop:Disconnect(); return end
        for i=of,math.min(of+60,fc) do
            local f=tas.frames[i]
            if f and f[3]<=tick()-timePlay then
                of=i; local ch=player.Character
                if ch then
                    if ch:FindFirstChild("HumanoidRootPart") then ch.HumanoidRootPart.CFrame=f[1] end
                    if ch:FindFirstChild("Humanoid") then pcall(function() ch.Humanoid:ChangeState(f[2]) end) end
                end
            end
        end
    end)
end

