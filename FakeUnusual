local fakeUnusual = {
    enabled  = false,
    selected = "",
    conn     = nil,
}

-- Only safe effect classes — never clone BaseParts/Meshes (causes invisibility on respawn)
local SAFE_CLASSES = {
    ParticleEmitter = true,
    Attachment      = true,
    Fire            = true,
    Smoke           = true,
    Sparkles        = true,
    PointLight      = true,
    SpotLight       = true,
    SurfaceLight    = true,
}

local function cleanup()
    local char = player.Character; if not char then return end
    for _, v in pairs(char:GetDescendants()) do
        if v:GetAttribute("FakeUnusual") then pcall(function() v:Destroy() end) end
    end
end

local function apply()
    cleanup()
    if not fakeUnusual.enabled or fakeUnusual.selected == "" then return end
    local char = player.Character; if not char then return end
    local hum  = char:FindFirstChildOfClass("Humanoid"); if not hum then return end
    local isR6 = hum.RigType == Enum.HumanoidRigType.R6

    local cosFolder = ReplicatedStorage:FindFirstChild("Items")
    if cosFolder then cosFolder = cosFolder:FindFirstChild("Cosmetics") end
    if not cosFolder then return end

    local module = cosFolder:FindFirstChild(fakeUnusual.selected)
    if not module then return end

    local modelName = isR6 and "CharacterClassic" or "Character"
    local effectModel = module:FindFirstChild(modelName)
                     or module:FindFirstChild("Character")
                     or module:FindFirstChild("CharacterClassic")
    if not effectModel then return end

    for _, sourcePart in pairs(effectModel:GetChildren()) do
        if sourcePart:IsA("BasePart") then
            local targetPart = char:FindFirstChild(sourcePart.Name)
            if targetPart then
                for _, effect in pairs(sourcePart:GetChildren()) do
                    if SAFE_CLASSES[effect.ClassName] then
                        local ok, clone = pcall(function() return effect:Clone() end)
                        if ok and clone then
                            clone:SetAttribute("FakeUnusual", true)
                            clone.Parent = targetPart
                        end
                    end
                end
            end
        end
    end
end

local function enable()
    fakeUnusual.enabled = true
    apply()
    if fakeUnusual.conn then fakeUnusual.conn:Disconnect() end
    fakeUnusual.conn = player.CharacterAdded:Connect(function(newChar)
        newChar:WaitForChild("Head", 8)
        task.wait(1.5)
        if fakeUnusual.enabled then apply() end
    end)
end

local function disable()
    fakeUnusual.enabled = false
    cleanup()
    if fakeUnusual.conn then fakeUnusual.conn:Disconnect(); fakeUnusual.conn = nil end
end

local function getList()
    local list = {}
    local cosFolder = ReplicatedStorage:FindFirstChild("Items")
    if cosFolder then cosFolder = cosFolder:FindFirstChild("Cosmetics") end
    if not cosFolder then return {"(Not found)"} end
    for _, item in pairs(cosFolder:GetChildren()) do
        if item:IsA("ModuleScript") then
            if item:FindFirstChild("Character") or item:FindFirstChild("CharacterClassic") then
                local ok, data = pcall(require, item)
                if ok and type(data) == "table" then
                    local ci = data.CosmeticInfo
                    if ci and ci.Unusual then
                        table.insert(list, item.Name)
                    end
                end
            end
        end
    end
    table.sort(list)
    return #list > 0 and list or {"(None found)"}
end

