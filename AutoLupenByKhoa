-- =============================================
--         AUTO FARM LUPEN
--         Using Fluent UI Library
-- =============================================

local Fluent = loadstring(game:HttpGet("https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"))()

-- =============================================
--              SERVICES
-- =============================================
local Players           = game:GetService("Players")
local RunService        = game:GetService("RunService")
local Workspace         = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer

-- =============================================
--              CONFIG
-- =============================================
local Config = {
    Enabled       = false,
    BotDetectRange = 25,   -- studs — bot cách bao nhiêu thì mới né
}

-- =============================================
--         BOT NAME LIST
-- Quét ReplicatedStorage -> NPCs
-- =============================================
local BotNames = {}

local function BuildBotList()
    BotNames = {}
    local npcFolder = ReplicatedStorage:FindFirstChild("NPCs")
    if not npcFolder then return end
    for _, obj in ipairs(npcFolder:GetChildren()) do
        local lower = obj.Name:lower()
        if lower ~= "lupen" then
            BotNames[lower] = true
        end
    end
end

-- =============================================
--     FIND LUPEN  Workspace -> Game -> Players
-- =============================================
local function FindLupen()
    local gameFolder = Workspace:FindFirstChild("Game")
    if not gameFolder then return nil end
    local playersFolder = gameFolder:FindFirstChild("Players")
    if not playersFolder then return nil end
    for _, obj in ipairs(playersFolder:GetChildren()) do
        if obj.Name:lower() == "lupen" then
            return obj
        end
    end
    return nil
end

-- =============================================
--     CHECK BOT IS CLOSE
-- Chỉ né khi bot thực sự ở gần nhân vật
-- =============================================
local function GetNearbyBot()
    local char = LocalPlayer.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    local gameFolder = Workspace:FindFirstChild("Game")
    if not gameFolder then return nil end
    local playersFolder = gameFolder:FindFirstChild("Players")
    if not playersFolder then return nil end

    for _, obj in ipairs(playersFolder:GetChildren()) do
        local lower = obj.Name:lower()
        if lower ~= "lupen" and BotNames[lower] then
            local root = obj:FindFirstChild("HumanoidRootPart")
                      or obj:FindFirstChild("Root")
                      or obj.PrimaryPart
            if root then
                local dist = (hrp.Position - root.Position).Magnitude
                if dist <= Config.BotDetectRange then
                    return obj  -- trả về bot đầu tiên đến gần
                end
            end
        end
    end
    return nil
end

-- =============================================
--     TELEPORT TO LUPEN
-- =============================================
local function TeleportToLupen(target)
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local root = target:FindFirstChild("HumanoidRootPart")
                 or target:FindFirstChild("Root")
                 or target.PrimaryPart
    if not root then return end
    hrp.CFrame = root.CFrame * CFrame.new(0, 0, 1.5)
end

-- =============================================
--     RANDOM ROAM
-- =============================================
local function RoamRandomPosition()
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local angle  = math.random() * 2 * math.pi
    local radius = math.random(30, 80)
    local pos    = hrp.Position

    hrp.CFrame = CFrame.new(
        pos.X + math.cos(angle) * radius,
        pos.Y,
        pos.Z + math.sin(angle) * radius
    )
end

-- =============================================
--              MAIN LOOP
-- Priority:
--   1. Có Lupen -> TP đến Lupen (kể cả đang bị bot đuổi)
--   2. Không có Lupen + bot đến gần -> roam
--   3. Không có gì -> đứng im
-- =============================================
local mainConn
local dodgeCooldown = 0

local function StartLoop()
    if mainConn then mainConn:Disconnect() end
    BuildBotList()

    mainConn = RunService.Heartbeat:Connect(function()
        if not Config.Enabled then return end

        -- ① Ưu tiên Lupen trước
        local lupen = FindLupen()
        if lupen then
            TeleportToLupen(lupen)
            return
        end

        -- ② Không có Lupen -> kiểm tra bot gần
        local now = tick()
        if (now - dodgeCooldown) >= 1 then
            local nearBot = GetNearbyBot()
            if nearBot then
                dodgeCooldown = now
                RoamRandomPosition()
                Fluent:Notify({
                    Title   = "Anti Bot",
                    Content = "Bot den gan! Dang di chuyen...",
                    Duration = 2,
                })
            end
        end
        -- Không có Lupen, không có bot gần -> đứng im
    end)
end

local function StopLoop()
    if mainConn then mainConn:Disconnect(); mainConn = nil end
end

-- =============================================
--              FLUENT WINDOW
-- =============================================

local Window = Fluent:CreateWindow({
    Title       = "Auto Farm Lupen",
    SubTitle    = "v1.2",
    TabWidth    = 0,
    Size        = UDim2.fromOffset(340, 150),
    Acrylic     = true,
    Theme       = "Dark",
    MinimizeKey = Enum.KeyCode.LeftControl,
})

local Tab = Window:AddTab({ Title = " ", Icon = "" })

Tab:AddToggle("MainToggle", {
    Title    = "Auto Farm Lupen",
    Default  = false,
    Callback = function(state)
        Config.Enabled = state
        if state then
            StartLoop()
            Fluent:Notify({ Title = "Bat!", Content = "Dang chay...", Duration = 2 })
        else
            StopLoop()
            Fluent:Notify({ Title = "Tat!", Content = "Da dung.", Duration = 2 })
        end
    end,
})

-- =============================================
--              INIT
-- =============================================
Window:SelectTab(1)
