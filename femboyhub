local function listenForKey(flagRef, btn, onDone)
    if flagRef[1] then return end
    flagRef[1] = true
    btn.Text             = "⌨️  Press any key..."
    btn.BackgroundColor3 = ORANGE
    local c; c = UserInputService.InputBegan:Connect(function(inp, gp)
        if gp then return end
        if inp.UserInputType == Enum.UserInputType.Keyboard then
            flagRef[1] = false
            btn.BackgroundColor3 = BLUE_BTN
            c:Disconnect()
            onDone(inp.KeyCode)
        end
    end)
end

