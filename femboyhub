-- ============================================================
-- WALL REMOVER  (manual)
-- ============================================================
local storedParts={}; local processedParts={}; local isProcessing=false
local wallRepairKeywords={"stair","step","ramp","trimp","platform","invisibleplatform","floor","ground","pad","road","path","bridge"}

local function isGameplayPart(name)
    name=string.lower(name)
    for _,kw in pairs(wallRepairKeywords) do if string.find(name,kw,1,true) then return true end end
    return false
end
local function wallDestroyAndStore()
    if isProcessing then return 0,0 end
    isProcessing=true; local destroyed,stored=0,0; local parts={}
    for _,obj in pairs(workspace:GetDescendants()) do
        if (obj:IsA("BasePart") or obj:IsA("MeshPart")) and not processedParts[obj] then table.insert(parts,obj) end
    end
    for i=1,#parts,50 do
        for j=i,math.min(i+49,#parts) do
            local obj=parts[j]
            if obj and obj.Parent then
                local name=string.lower(obj.Name)
                if isGameplayPart(name) then
                    if obj.CanCollide then local np=obj:Clone(); np.Parent=nil; table.insert(storedParts,np); pcall(function() obj:Destroy() end); stored=stored+1 end
                else
                    if obj.CanCollide and obj.Transparency>=0.8 and obj.Position.Y>50 then pcall(function() obj:Destroy(); destroyed=destroyed+1 end) end
                end
                processedParts[obj]=true
            end
        end
        task.wait()
    end
    isProcessing=false; return stored,destroyed
end
local function wallRestoreStoredParts()
    local restored=0; local mapParent=workspace:FindFirstChild("Map") or workspace:FindFirstChild("Level") or workspace
    for i=1,#storedParts,25 do
        for j=i,math.min(i+24,#storedParts) do
            local part=storedParts[j]
            if part then pcall(function() part.Parent=mapParent; restored=restored+1 end) end
        end
        task.wait()
    end
    storedParts={}; processedParts={}; return restored
end
local function runWallRemover()
    Notify("Wall Remover","🔍 Scanning & removing invisible walls...",4)
    task.spawn(function()
        local stored,destroyed=wallDestroyAndStore(); task.wait(0.2)
        local restored=wallRestoreStoredParts()
        if destroyed>0 or stored>0 then
            Notify("Wall Remover","✅ Done!  Saved: "..stored.."  |  Removed: "..destroyed.."  |  Restored: "..restored,6)
        else Notify("Wall Remover","✅ No invisible walls found.",3) end
    end)
end

