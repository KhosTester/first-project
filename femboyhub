        pcall(function()
            if remaining<=60 then afkStatusP:SetDesc("⚠ ABOUT TO KICK!")
            elseif remaining<=300 then afkStatusP:SetDesc("⚡ Warning < 5 min")
            else afkStatusP:SetDesc("✔ Normal") end
        end)
    end)
end

