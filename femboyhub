local function startResize(dir)
    if isResizing then return end
    isResizing    = true
    resizeDir     = dir
    rStartMouse   = UserInputService:GetMouseLocation()
    rStartSize    = Vector2.new(MF.AbsoluteSize.X, MF.AbsoluteSize.Y)
    MF.Draggable  = false
end

