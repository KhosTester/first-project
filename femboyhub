-- WET FLOOR SECTION
-- ════════════════════════════════════════════════════════════════
function buildWetFloorSection()
    local sMF = Tabs.Settings:AddSection("Wet Floor  💧✨")
    local waterParts={}; local wetComplexObjs={}; local waterApplied=false; local rippleConn=nil
    local wetIntensity=0.65; local waterThickness=0.05; local waterColorTint=Color3.fromRGB(180,220,255)
    local waterTransAlpha=0.55; local waterCanCollide=false; local waterMaterial=Enum.Material.Glass
    local WATER_MATERIALS={["Glass"]=Enum.Material.Glass,["SmoothPlastic"]=Enum.Material.SmoothPlastic,["Plastic"]=Enum.Material.Plastic}
    local reflectGroundActive=false; local reflectGroundLevel=0.50; local reflectOriginals={}; local reflectDescConn=nil
    local rippleOpacity=0.15; local rippleThickness=0.07; local rippleColor=Color3.fromRGB(180,220,255)
    local rippleColor2=Color3.fromRGB(140,195,240); local rippleMaterial=Enum.Material.Neon; local lastRippleTime=0

    local function isComplexObject(obj)
        if obj:IsA("MeshPart") then return true end
        if obj:IsA("UnionOperation") then return true end
        if obj:FindFirstChildOfClass("SpecialMesh") then return true end
        return false
    end

    local function refreshAllWaterParts()
        for _,wp in ipairs(waterParts) do
            if wp and wp.Parent then pcall(function() wp.Material=waterMaterial; wp.Transparency=waterTransAlpha; wp.CanCollide=waterCanCollide end) end
        end
        for _,entry in ipairs(wetComplexObjs) do
            if entry.obj and entry.obj.Parent then pcall(function() entry.obj.Material=waterMaterial; entry.obj.Transparency=waterTransAlpha; entry.obj.Reflectance=0.28+0.62*wetIntensity end) end
        end
    end

    local function findFloorsByRaycast()
        local char=player.Character; local hrpL=char and char:FindFirstChild("HumanoidRootPart")
        local base=hrpL and hrpL.Position or Vector3.new(0,50,0)
        local excl={}; if char then table.insert(excl,char) end
        for _,wp in ipairs(waterParts) do table.insert(excl,wp) end
        local rp=RaycastParams.new(); rp.FilterType=Enum.RaycastFilterType.Exclude; rp.FilterDescendantsInstances=excl
        local seen,floors={},{}; local step,radius=5,200
        for x=-radius,radius,step do
            for z=-radius,radius,step do
                local origin=Vector3.new(base.X+x,base.Y+80,base.Z+z)
                local result=workspace:Raycast(origin,Vector3.new(0,-300,0),rp)
                if result and result.Instance then
                    local obj=result.Instance
                    if obj:IsA("BasePart") and not obj:IsA("Terrain") and obj.Size.X>=0.5 and obj.Size.Z>=0.5
                    and obj.Name~="FemboyWaterOverlay" and obj.Name~="FemboyRipple"
                    and obj.Name~="FemboyWeatherPart" and obj.Name~="FemboyFarm3Platform"
                    and not seen[obj] then seen[obj]=true; table.insert(floors,obj) end
                end
            end
        end
        return floors
    end

    local function createWaterOverlay(orig)
        local wp=Instance.new("Part"); wp.Name="FemboyWaterOverlay"; wp.Anchored=true; wp.CanCollide=waterCanCollide
        wp.CanQuery=false; wp.CastShadow=false; wp.Material=waterMaterial
        local bc,tc=orig.Color,waterColorTint
        wp.Color=Color3.new(bc.R*0.40+tc.R*0.60,bc.G*0.40+tc.G*0.60,bc.B*0.40+tc.B*0.60)
        wp.Reflectance=0.28+0.62*wetIntensity; wp.Transparency=waterTransAlpha
        wp.Size=Vector3.new(orig.Size.X,waterThickness,orig.Size.Z)
        wp.CFrame=orig.CFrame*CFrame.new(0,orig.Size.Y/2+waterThickness/2+0.005,0); wp.Parent=workspace; return wp
    end

    local function applyComplexWet(orig)
        for _,entry in ipairs(wetComplexObjs) do if entry.obj==orig then return end end
        local origMat=orig.Material; local origTrans=orig.Transparency; local origRef=orig.Reflectance
        pcall(function() orig.Material=waterMaterial; orig.Transparency=waterTransAlpha; orig.Reflectance=0.28+0.62*wetIntensity end)
        table.insert(wetComplexObjs,{obj=orig,origMaterial=origMat,origTrans=origTrans,origRef=origRef})
    end

    local function applyWaterOverlay()
        if waterApplied then Fluent:Notify({Title="Wet Floor",Content="⚠ Already applied! Reset first.",Duration=3}); return end
        waterParts={}; wetComplexObjs={}
        Fluent:Notify({Title="Wet Floor",Content="⏳ Scanning floors...",Duration=2})
        task.spawn(function()
            local floors=findFloorsByRaycast()
            if #floors==0 then Fluent:Notify({Title="Wet Floor",Content="❌ No floors found!",Duration=5}); return end
            local countOverlay,countComplex=0,0
            for _,orig in ipairs(floors) do
                if isComplexObject(orig) then pcall(function() applyComplexWet(orig) end); countComplex=countComplex+1
                else pcall(function() local wp=createWaterOverlay(orig); table.insert(waterParts,wp); countOverlay=countOverlay+1 end) end
                if (countOverlay+countComplex)%60==0 then task.wait() end
            end
            waterApplied=true
            Fluent:Notify({Title="Wet Floor",Content="💧 Done!\n✅ Overlay: "..countOverlay.." parts\n🔷 Complex (material): "..countComplex,Duration=5})
        end)
    end

    local function resetWaterOverlay()
        if not waterApplied and #waterParts==0 and #wetComplexObjs==0 then Fluent:Notify({Title="Wet Floor",Content="⚠ Nothing to reset.",Duration=2}); return end
        local removed=0
        for _,wp in ipairs(waterParts) do if wp and wp.Parent then pcall(function() wp:Destroy() end); removed=removed+1 end end
        waterParts={}
        for _,obj in pairs(workspace:GetDescendants()) do if obj.Name=="FemboyWaterOverlay" then pcall(function() obj:Destroy() end) end end
        local restored=0
        for _,entry in ipairs(wetComplexObjs) do
            if entry.obj and entry.obj.Parent then
                pcall(function() entry.obj.Material=entry.origMaterial; entry.obj.Transparency=entry.origTrans; entry.obj.Reflectance=entry.origRef end)
                restored=restored+1
            end
        end
        wetComplexObjs={}; waterApplied=false
        Fluent:Notify({Title="Wet Floor",Content="🗑 Removed "..removed.." overlays\n🔄 Restored "..restored.." complex objects",Duration=4})
    end

    local function spawnRippleRing(pos,startDiam,endDiam,duration,startTrans,col,yOff)
        local r=Instance.new("Part"); r.Name="FemboyRipple"; r.Anchored=true; r.CanCollide=false; r.CanQuery=false; r.CastShadow=false
        r.Material=rippleMaterial; r.Color=col; r.Shape=Enum.PartType.Cylinder
        r.CFrame=CFrame.new(pos.X,pos.Y+(yOff or 0.04),pos.Z)*CFrame.Angles(0,0,math.rad(90))
        r.Size=Vector3.new(rippleThickness*0.8,startDiam,startDiam)
        r.Transparency=math.clamp(startTrans+rippleOpacity,0,0.99); r.Parent=workspace
        local tw=TweenService:Create(r,TweenInfo.new(duration,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{Size=Vector3.new(rippleThickness*0.2,endDiam,endDiam),Transparency=1})
        tw:Play(); tw.Completed:Connect(function() pcall(function() r:Destroy() end) end)
    end

    local function spawnGlowDisc(pos)
        local d=Instance.new("Part"); d.Name="FemboyRipple"; d.Anchored=true; d.CanCollide=false; d.CanQuery=false; d.CastShadow=false
        d.Material=rippleMaterial; d.Color=Color3.new(0.9,0.97,1); d.Shape=Enum.PartType.Cylinder
        d.CFrame=CFrame.new(pos.X,pos.Y+0.03,pos.Z)*CFrame.Angles(0,0,math.rad(90))
        d.Size=Vector3.new(0.03,0.8,0.8); d.Transparency=math.clamp(0.12+rippleOpacity,0,0.98); d.Parent=workspace
        TweenService:Create(d,TweenInfo.new(0.22,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{Size=Vector3.new(0.015,3.0,3.0),Transparency=1}):Play()
        task.delay(0.25,function() pcall(function() d:Destroy() end) end)
    end

    local function spawnRipple(pos,speedFactor)
        local sf=math.clamp(speedFactor or 1.0,0.4,2.5); spawnGlowDisc(pos)
        spawnRippleRing(pos,0.10,2.0*sf,0.28,0.05,Color3.new(1,1,1),0.065)
        task.delay(0.07,function() spawnRippleRing(pos,0.14,5.0*sf,0.52,0.15,rippleColor,0.055) end)
        task.delay(0.18,function() spawnRippleRing(pos,0.09,9.0*sf,0.80,0.35,rippleColor2,0.044) end)
    end

    local function startRipple()
        if rippleConn then return end
        rippleConn=RunService.Heartbeat:Connect(function()
            local now=tick(); if now-lastRippleTime<0.20 then return end
            local c=player.Character; local hrpL=c and c:FindFirstChild("HumanoidRootPart"); local humL=c and c:FindFirstChild("Humanoid")
            if not hrpL or not humL then return end
            if humL.MoveDirection.Magnitude>0.1 and humL.FloorMaterial~=Enum.Material.Air then
                local rp=RaycastParams.new(); rp.FilterDescendantsInstances={c}; rp.FilterType=Enum.RaycastFilterType.Exclude
                local ray=workspace:Raycast(hrpL.Position,Vector3.new(0,-5,0),rp)
                if ray and ray.Instance and ray.Instance.Name~="FemboyRipple" then
                    local speed=hrpL.AssemblyLinearVelocity.Magnitude; spawnRipple(ray.Position,math.clamp(speed/16,0.5,2.5)); lastRippleTime=now
                end
            end
        end)
    end

    local function stopRipple()
        if rippleConn then rippleConn:Disconnect(); rippleConn=nil end
        for _,obj in pairs(workspace:GetDescendants()) do if obj.Name=="FemboyRipple" then pcall(function() obj:Destroy() end) end end
    end

    sMF:AddSlider("WetIntensity",{Title="Wet Intensity",Default=65,Min=0,Max=100,Rounding=0,Callback=function(v)
        wetIntensity=v/100
        for _,wp in ipairs(waterParts) do if wp and wp.Parent then pcall(function() wp.Reflectance=0.28+0.62*wetIntensity end) end end
        for _,entry in ipairs(wetComplexObjs) do if entry.obj and entry.obj.Parent then pcall(function() entry.obj.Reflectance=0.28+0.62*wetIntensity end) end end
    end})
    sMF:AddSlider("WaterTransparency",{Title="Water Transparency",Default=55,Min=0,Max=100,Rounding=0,Callback=function(v) waterTransAlpha=v/100; refreshAllWaterParts() end})
    sMF:AddSlider("WaterThickness",{Title="Layer Thickness  (Simple Parts only)",Default=5,Min=1,Max=30,Rounding=0,Callback=function(v) waterThickness=v/100 end})
    sMF:AddDropdown("WaterMaterial",{Title="Water Material",Values={"Glass","SmoothPlastic","Plastic"},Default="Glass",Callback=function(v) waterMaterial=WATER_MATERIALS[tostring(v)] or Enum.Material.Glass; refreshAllWaterParts() end})
    sMF:AddColorpicker("WaterTint",{Title="Water Tint",Default=Color3.fromRGB(180,220,255),Callback=function(v) waterColorTint=v end})
    sMF:AddButton({Title="💧 Apply Wet Floor",Callback=function() task.spawn(applyWaterOverlay) end})
    sMF:AddButton({Title="🗑 Reset Wet Floor",Callback=function() task.spawn(resetWaterOverlay) end})

    local sRG=Tabs.Settings:AddSection("Reflective Ground  🪞  (All Surfaces)")
    local function setGroundReflective(level)
        for _,entry in ipairs(reflectOriginals) do
            if entry.obj and entry.obj.Parent then pcall(function() entry.obj.Reflectance=entry.origRef end) end
        end
        reflectOriginals={}
        if level<=0 then return end
        for _,obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") and not obj:IsA("Terrain") then
                local origRef=obj.Reflectance; table.insert(reflectOriginals,{obj=obj,origRef=origRef})
                pcall(function() obj.Reflectance=level end)
            end
        end
    end

    local function enableReflectiveGround()
        setGroundReflective(reflectGroundLevel)
        if reflectDescConn then reflectDescConn:Disconnect() end
        reflectDescConn=workspace.DescendantAdded:Connect(function(obj)
            if not reflectGroundActive then return end
            if not obj:IsA("BasePart") or obj:IsA("Terrain") then return end
            local origRef=obj.Reflectance; table.insert(reflectOriginals,{obj=obj,origRef=origRef})
            pcall(function() obj.Reflectance=reflectGroundLevel end)
        end)
        Fluent:Notify({Title="Reflective Ground",Content="🪞 Applied to all "..#reflectOriginals.." surfaces\nLevel: "..math.floor(reflectGroundLevel*100).."%",Duration=4})
    end

    local function disableReflectiveGround()
        if reflectDescConn then reflectDescConn:Disconnect(); reflectDescConn=nil end
        local count=#reflectOriginals; setGroundReflective(0)
        Fluent:Notify({Title="Reflective Ground",Content="🔄 Restored "..count.." objects.",Duration=3})
    end

    sRG:AddSlider("ReflectLevel",{Title="Reflection Level",Default=50,Min=0,Max=100,Rounding=0,Callback=function(v)
        reflectGroundLevel=v/100; if reflectGroundActive then setGroundReflective(reflectGroundLevel) end
        pcall(function() Fluent.Options.ReflectLevelInput:SetValue(tostring(v)) end)
    end})
    sRG:AddInput("ReflectLevelInput",{Title="↳ Enter value",Default="50",Placeholder="0 – 100",Numeric=false,Finished=false,Callback=function(v)
        local n=tonumber(v); if not n then return end; n=math.clamp(math.floor(n),0,100)
        reflectGroundLevel=n/100; if reflectGroundActive then setGroundReflective(reflectGroundLevel) end
        pcall(function() Fluent.Options.ReflectLevel:SetValue(n) end)
    end})
    toggleRefs["ReflectGround"]=sRG:AddToggle("ReflectGround",{Title="Reflective Ground",Default=false,Callback=function(v)
        reflectGroundActive=v; if v then task.spawn(enableReflectiveGround) else disableReflectiveGround() end
    end})

    local sCC2=Tabs.Settings:AddSection("Water CanCollide")
    local ccStatePara=sCC2:AddParagraph({Title="Info",Content="Toggle whether the water overlay blocks your movement."})
    sCC2:AddButton({Title="🔀 Toggle: Walk Through / Solid",Callback=function()
        waterCanCollide=not waterCanCollide; refreshAllWaterParts()
        if not waterCanCollide then Fluent:Notify({Title="Water CanCollide",Content="🔴 Solid.",Duration=2}); pcall(function() ccStatePara:SetDesc("🔴 Solid (CanCollide ON)") end)
        else Fluent:Notify({Title="Water CanCollide",Content="🟢 Pass-through.",Duration=2}); pcall(function() ccStatePara:SetDesc("🟢 Pass-through (CanCollide OFF)") end) end
    end})

    sMF:AddSlider("RippleOpacity",{Title="Ripple Opacity",Default=15,Min=0,Max=90,Rounding=0,Callback=function(v) rippleOpacity=v/100; pcall(function() Fluent.Options.RippleOpacityInput:SetValue(tostring(v)) end) end})
    sMF:AddInput("RippleOpacityInput",{Title="↳ Enter value",Default="15",Placeholder="0 – 90",Numeric=false,Finished=false,Callback=function(v) local n=tonumber(v); if not n then return end; n=math.clamp(math.floor(n),0,90); rippleOpacity=n/100; pcall(function() Fluent.Options.RippleOpacity:SetValue(n) end) end})
    sMF:AddSlider("RippleThickness",{Title="Ring Thickness",Default=7,Min=1,Max=50,Rounding=0,Callback=function(v) rippleThickness=v/100; pcall(function() Fluent.Options.RippleThicknessInput:SetValue(tostring(v)) end) end})
    sMF:AddInput("RippleThicknessInput",{Title="↳ Enter value",Default="7",Placeholder="1 – 50",Numeric=false,Finished=false,Callback=function(v) local n=tonumber(v); if not n then return end; n=math.clamp(math.floor(n),1,50); rippleThickness=n/100; pcall(function() Fluent.Options.RippleThickness:SetValue(n) end) end})
    sMF:AddColorpicker("RippleColor",{Title="Ripple Color — Primary",Default=Color3.fromRGB(180,220,255),Callback=function(v) rippleColor=v end})
    sMF:AddColorpicker("RippleColor2",{Title="Ripple Color — Secondary",Default=Color3.fromRGB(140,195,240),Callback=function(v) rippleColor2=v end})
    local RIPPLE_MATS={["Glass"]=Enum.Material.Glass,["Plastic"]=Enum.Material.Plastic,["SmoothPlastic"]=Enum.Material.SmoothPlastic}
    sMF:AddDropdown("RippleMaterial",{Title="Ripple Material",Values={"Glass","Plastic","SmoothPlastic"},Default="Glass",Callback=function(v) rippleMaterial=RIPPLE_MATS[tostring(v)] or Enum.Material.Glass end})
    toggleRefs["Ripple"]=sMF:AddToggle("RippleToggle",{Title="💧 Ripple  (Walk Only)",Default=false,Callback=function(v)
        if v then startRipple()
        else stopRipple() end
    end})
end
buildSettingsTab()

SaveManager:LoadAutoloadConfig()
Window:SelectTab(1)

