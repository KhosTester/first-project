-- HELPER: sync number input → slider + callback
-- ============================================================
local function syncInput(rawValue, minVal, maxVal, sliderObj, callback)
    local clean = tostring(rawValue):gsub("[^%-%d%.]+", "")
    local v = tonumber(clean)
    if not v then return end
    v = math.clamp(math.floor(v + 0.5), minVal, maxVal)
    if sliderObj and sliderObj.Set then sliderObj:Set(v) end
    callback(v)
end

