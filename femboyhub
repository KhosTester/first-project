                if n:find(k) then bounce=true; break end
            end; if bounce then break end
        end
        if not bounce and #tp>0 then
            local power = BOOST_POWER
            if edgeBoostMode == "Light"  then power = math.random(40,  90)  end
            if edgeBoostMode == "Medium" then power = math.random(90,  140) end
            if edgeBoostMode == "Heavy"  then power = math.random(140, 200) end
            hrp.AssemblyLinearVelocity=Vector3.new(hrp.AssemblyLinearVelocity.X, power, hrp.AssemblyLinearVelocity.Z)
        end
    end
end

