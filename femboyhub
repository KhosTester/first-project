-- EDGE BOOST
local boostOn    = false
local boostConn  = nil
local lastBoostT = 0

local function getChar()
    local c = player.Character or player.CharacterAdded:Wait()
    return c, c:WaitForChild("HumanoidRootPart"), c:WaitForChild("Humanoid")
end
local _, hrp, hum = getChar()

local bKW = {"bounce","boost","launch","jump","pad","ramp","platform"}
local function isBouncePart(part)
    local n = string.lower(part.Name)
    for _, kw in pairs(bKW) do
        if n:find(kw) then return true end
    end
    if part.Parent then
        if part.Parent:IsA("Model") or part.Parent:IsA("Folder") then
            local pn = string.lower(part.Parent.Name)
            for _, kw in pairs(bKW) do
                if pn:find(kw) then return true end
            end
        end
    end
    return false
end

local function applyBoost()
    if not boostOn or not hrp or not hum or hum.Health <= 0 then return end
    local now = tick()
    if now - lastBoostT < 0.15 then return end
    if hrp.AssemblyLinearVelocity.Y < -1.0 then
        local touching = hrp:GetTouchingParts()
        if #touching == 0 then return end
        for _, p in pairs(touching) do
            if isBouncePart(p) then return end
        end
        local hv = Vector3.new(hrp.AssemblyLinearVelocity.X, 0, hrp.AssemblyLinearVelocity.Z)
        hrp.AssemblyLinearVelocity = hv + Vector3.new(0, getBoost(), 0)
        lastBoostT = now
    end
end

