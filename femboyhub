        BoostBtn.BackgroundColor3 = SN[1]
    else
        BoostDot.BackgroundColor3 = C.red
        BoostTxt.Text = "Femboi Form: OFF"
        BoostBtn.Text = "⚡  TOGGLE EDGE BOOST  —  OFF"
        BoostBtn.BackgroundColor3 = SD[1]
    end
end

