local dragging, dragStart, dragPos0 = false, nil, nil
TBar.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true; dragStart = i.Position; dragPos0 = MF.Position
    end
end)
TBar.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
end)
UserInputService.InputChanged:Connect(function(i)
    if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
        local d = i.Position - dragStart
        MF.Position = UDim2.new(dragPos0.X.Scale, dragPos0.X.Offset + d.X,
                                 dragPos0.Y.Scale, dragPos0.Y.Offset + d.Y)
    end
end)

