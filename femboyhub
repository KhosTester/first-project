    if dist<=espAi.DIST_DANGER then
        local p=math.sin(tick()*8)*0.5+0.5; return Color3.new(1,p*0.15,0)
    elseif dist<=espAi.DIST_WARN then
        local t=(dist-espAi.DIST_DANGER)/(espAi.DIST_WARN-espAi.DIST_DANGER)
