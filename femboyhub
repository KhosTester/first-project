local eDrag, jDrag, fDrag = false, false, false
eSBg.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then eDrag = true  end end)
eSBg.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then eDrag = false end end)
jSBg.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then jDrag = true  end end)
jSBg.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then jDrag = false end end)
fSBg.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then fDrag = true  end end)
fSBg.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then fDrag = false end end)

UserInputService.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 then
        eDrag = false; jDrag = false; fDrag = false
    end
end)
UserInputService.InputChanged:Connect(function(i)
    if i.UserInputType ~= Enum.UserInputType.MouseMovement then return end
    if eDrag then
        local r = math.clamp((i.Position.X - eSBg.AbsolutePosition.X) / eSBg.AbsoluteSize.X, 0, 1)
        updateEdge(r * 400)
    end
    if jDrag then
        local r = math.clamp((i.Position.X - jSBg.AbsolutePosition.X) / jSBg.AbsoluteSize.X, 0, 1)
        updateJump(r * 400)
    end
    if fDrag then
        local r = math.clamp((i.Position.X - fSBg.AbsolutePosition.X) / fSBg.AbsoluteSize.X, 0, 1)
        updateFlySpeed(r * 20)
    end
end)

