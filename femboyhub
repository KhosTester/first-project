-- WALL REMOVER
local stored    = {}
local processed = {}
local wallBusy  = false
local repKW     = {"stair","step","ramp","trimp","platform","invisibleplatform","floor","ground","pad","road","path","bridge"}

local function isGameplay(name)
    local n = string.lower(name)
    for _, kw in pairs(repKW) do
        if string.find(n, kw, 1, true) then return true end
    end
    return false
end

local function doWallClean()
    if wallBusy then return end
    wallBusy = true
    local parts = {}
    for _, obj in pairs(workspace:GetDescendants()) do
        if (obj:IsA("BasePart") or obj:IsA("MeshPart")) and not processed[obj] then
            table.insert(parts, obj)
        end
    end
    for i = 1, #parts, 50 do
        for j = i, math.min(i + 49, #parts) do
            local obj = parts[j]
            if obj and obj.Parent then
                if isGameplay(obj.Name) then
                    if obj.CanCollide then
                        local np = obj:Clone(); np.Parent = nil
                        table.insert(stored, np)
                        pcall(function() obj:Destroy() end)
                    end
                else
                    if obj.CanCollide and obj.Transparency >= 0.8 and obj.Position.Y > 50 then
                        pcall(function() obj:Destroy() end)
                    end
                end
                processed[obj] = true
            end
        end
        task.wait()
    end
    wallBusy = false
end

local function restoreWalls()
    local mp = workspace:FindFirstChild("Map") or workspace:FindFirstChild("Level") or workspace
    for i = 1, #stored, 25 do
        for j = i, math.min(i + 24, #stored) do
            local p = stored[j]
            if p then pcall(function() p.Parent = mp end) end
        end
        task.wait()
    end
    stored = {}; processed = {}
end

local function runWall()
    WallDot.BackgroundColor3 = C.orange
    WallTxt.Text = "Processing..."
    doWallClean()
    task.wait(0.2)
    restoreWalls()
    WallDot.BackgroundColor3 = C.green
    WallTxt.Text = "Done — press " .. kn(KB.wallClean) .. " to re-run"
    notify("Walls Removed", "Press " .. kn(KB.wallClean) .. " to fix issues", 4)
end

