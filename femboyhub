            Enum.KeyCode.G, Enum.KeyCode.Five,
            Enum.KeyCode.G, Enum.KeyCode.Six,
        },
        ["Custom"] = {},
    }
    local PRESET_NAMES = {
        "Ctrl","Space",
        "G → 1","G → 2","G → 3","G → 4","G → 5","G → 6",
        "G → 1→2→3→4→5→6",
        "Custom",
    }

    -- ── Key name resolver ─────────────────────────────────────
    local KEY_MAP = {
        space=Enum.KeyCode.Space, ctrl=Enum.KeyCode.LeftControl,
        leftcontrol=Enum.KeyCode.LeftControl, rightcontrol=Enum.KeyCode.RightControl,
        shift=Enum.KeyCode.LeftShift, leftshift=Enum.KeyCode.LeftShift,
        rightshift=Enum.KeyCode.RightShift, alt=Enum.KeyCode.LeftAlt,
        e=Enum.KeyCode.E, f=Enum.KeyCode.F, g=Enum.KeyCode.G, q=Enum.KeyCode.Q,
        r=Enum.KeyCode.R, t=Enum.KeyCode.T, x=Enum.KeyCode.X, z=Enum.KeyCode.Z,
        ["1"]=Enum.KeyCode.One,   ["2"]=Enum.KeyCode.Two,   ["3"]=Enum.KeyCode.Three,
        ["4"]=Enum.KeyCode.Four,  ["5"]=Enum.KeyCode.Five,  ["6"]=Enum.KeyCode.Six,
        ["7"]=Enum.KeyCode.Seven, ["8"]=Enum.KeyCode.Eight, ["9"]=Enum.KeyCode.Nine,
        ["0"]=Enum.KeyCode.Zero,
        w=Enum.KeyCode.W, a=Enum.KeyCode.A, s=Enum.KeyCode.S, d=Enum.KeyCode.D,
    }
    local function resolveKey(str)
        local s = str:lower():gsub("%s+","")
        if s == "" then return nil end
        local kc = KEY_MAP[s]
        if kc then return kc end
        local ok, val = pcall(function() return Enum.KeyCode[str] end)
        if ok and val then return val end
        return nil
    end

    -- ── Send a single key press+release ───────────────────────
    local function sendKey(kc)
        pcall(function()
            VIM:SendKeyEvent(true,  kc, false, game)
            task.wait(0.04)
            VIM:SendKeyEvent(false, kc, false, game)
        end)
    end

    -- ── Run the full combo once ────────────────────────────────
    local function runCombo()
        local keys = macro.selectedPreset == "Custom"
            and macro.customKeys
            or  (PRESETS[macro.selectedPreset] or {})
        if #keys == 0 then return end
        for _, kc in ipairs(keys) do
            if not macro.enabled then break end
            sendKey(kc)
            task.wait(macro.keyDelay)
        end
    end

    -- ── Loop control ──────────────────────────────────────────
    local function stopLoop()
        if macro.loopThread then
            pcall(function() task.cancel(macro.loopThread) end)
            macro.loopThread = nil
        end
    end

    local function startLoop()
        stopLoop()
        macro.loopThread = task.spawn(function()
            while macro.enabled and macro.loopEnabled do
                runCombo()
                task.wait(macro.loopDelay)
            end
            macro.loopThread = nil
        end)
    end

    -- ── Toggle macro on/off ───────────────────────────────────
    local function setMacro(v)
        macro.enabled = v
        pcall(function() toggleRefs["MacroEnable"]:SetValue(v) end)
        if v then
            if macro.loopEnabled then startLoop() end
        else
            stopLoop()
        end
    end

    -- ── Keybind ───────────────────────────────────────────────
    local macroKeyConn = nil
    local function rebuildMacroKeybind(kc)
        if macroKeyConn then macroKeyConn:Disconnect(); macroKeyConn = nil end
        if not kc or kc == Enum.KeyCode.Unknown then return end
        macroKeyConn = UserInputService.InputBegan:Connect(function(inp, gpe)
            if gpe then return end
            if inp.KeyCode ~= kc then return end
            setMacro(not macro.enabled)
        end)
    end

    -- ── Mobile button ─────────────────────────────────────────
    local mobileGui = nil
    local function destroyMobileBtn()
        if mobileGui then pcall(function() mobileGui:Destroy() end); mobileGui = nil end
    end
    local function createMobileBtn()
        destroyMobileBtn()
        mobileGui = Instance.new("ScreenGui")
        mobileGui.Name = "FemboyMacroBtn"; mobileGui.ResetOnSpawn = false
        mobileGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
        pcall(function() mobileGui.Parent = player:WaitForChild("PlayerGui") end)
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.fromOffset(64, 64)
        btn.Position = UDim2.new(1, -160, 1, -140)
        btn.AnchorPoint = Vector2.new(0, 1)
        btn.BorderSizePixel = 0; btn.TextSize = 11
        btn.Font = Enum.Font.GothamBold
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.ZIndex = 10; btn.Text = "MACRO"; btn.Parent = mobileGui
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 10)
        local function refresh()
            btn.BackgroundColor3 = macro.enabled
                and Color3.fromRGB(80, 200, 100)
                or  Color3.fromRGB(40, 40, 50)
        end
        btn.MouseButton1Click:Connect(function() setMacro(not macro.enabled); refresh() end)
        RunService.Heartbeat:Connect(refresh)
    end

    -- ════ UI ══════════════════════════════════════════════════

    -- Preset selector
    local sPreset = Tabs.Macro:AddSection("Combo Preset")
    sPreset:AddDropdown("MacroPreset", {
        Title   = "Select Preset",
        Values  = PRESET_NAMES,
        Default = "Custom",
        Callback = function(v) macro.selectedPreset = tostring(v) end,
    })

    -- Custom keys
    local sCustom = Tabs.Macro:AddSection("Custom Keys")
    local customRaw = ""
    sCustom:AddInput("MacroCustomRaw", {
        Title   = "Key sequence (comma separated)",
        Default = "",
        Placeholder = "e.g.  G,1  or  Ctrl  or  Space",
        Numeric = false, Finished = false,
        Callback = function(v) customRaw = v end,
    })
    sCustom:AddButton({Title="Apply Custom Keys", Callback=function()
        local parts = {}
        for seg in customRaw:gmatch("[^,]+") do
            local t = seg:match("^%s*(.-)%s*$")
            if t ~= "" then table.insert(parts, t) end
        end
        macro.customKeys = {}
        local ok, fail = 0, 0
        for _, name in ipairs(parts) do
            local kc = resolveKey(name)
            if kc then table.insert(macro.customKeys, kc); ok = ok + 1
            else fail = fail + 1 end
        end
        local msg = ok.." key(s) applied"
        if fail > 0 then msg = msg .. " | "..fail.." unrecognized" end
        pcall(function() Fluent.Options.MacroPreviewPara:SetDesc(msg) end)
    end})
    sCustom:AddButton({Title="Clear Custom Keys", Callback=function()
        macro.customKeys = {}
        pcall(function() Fluent.Options.MacroPreviewPara:SetDesc("Custom keys cleared.") end)
    end})

    -- Delays
    local sDelay = Tabs.Macro:AddSection("Timing")
    sDelay:AddSlider("MacroKeyDelay", {
        Title    = "Delay between keys (ms)",
        Default  = 80, Min = 10, Max = 500, Rounding = 0,
        Callback = function(v) macro.keyDelay = v / 1000 end,
    })
    sDelay:AddSlider("MacroLoopDelay", {
        Title    = "Delay between loop repeats (ms)",
        Default  = 200, Min = 50, Max = 2000, Rounding = 0,
        Callback = function(v) macro.loopDelay = v / 1000 end,
    })

    -- Loop toggle
    local sLoop = Tabs.Macro:AddSection("Loop")
    toggleRefs["MacroLoop"] = sLoop:AddToggle("MacroLoop", {
        Title   = "Infinite Loop",
        Default = false,
        Callback = function(v)
            macro.loopEnabled = v
            if macro.enabled then
                if v then startLoop() else stopLoop() end
            end
        end,
    })

    -- Preview
    local sPreview = Tabs.Macro:AddSection("Preview")
    local previewPara = sPreview:AddParagraph({Title="Current Combo", Content="(none)"})
    sPreview:AddButton({Title="View Combo", Callback=function()
        local keys = macro.selectedPreset == "Custom"
            and macro.customKeys
            or  (PRESETS[macro.selectedPreset] or {})
        if #keys == 0 then
            pcall(function() previewPara:SetDesc("⚠ No keys configured") end); return
        end
        local names = {}
        for _, kc in ipairs(keys) do
            table.insert(names, tostring(kc):match("%.(%w+)$") or "?")
        end
        local txt = "["..macro.selectedPreset.."]\n"..table.concat(names, " → ")
        pcall(function() previewPara:SetDesc(txt) end)
    end})
    sPreview:AddButton({Title="Fire Once (manual)", Callback=function()
        task.spawn(runCombo)
    end})

    -- Activate
    local sEnable = Tabs.Macro:AddSection("Activate")
    toggleRefs["MacroEnable"] = sEnable:AddToggle("MacroEnable", {
        Title   = "Enable Macro",
        Default = false,
        Callback = function(v) setMacro(v) end,
    })
    toggleRefs["MacroMobileBtn"] = sEnable:AddToggle("MacroMobileBtn", {
        Title   = "Mobile Button",
        Default = false,
        Callback = function(v)
            if v then createMobileBtn() else destroyMobileBtn() end
        end,
    })
end
buildMacroTab()

