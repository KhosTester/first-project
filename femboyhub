local function mkHandle(zi, cr)
    local h = Instance.new("Frame", SG)
    h.BackgroundColor3       = Color3.fromRGB(255,30,70)
    h.BackgroundTransparency = 0.55
    h.BorderSizePixel        = 0
    h.ZIndex                 = zi
    h.Active                 = true
    h.Visible                = false
    if cr then corner(h, 3) end
    return h
end
