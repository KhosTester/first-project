mapSpawnBtn.MouseButton1Click:Connect(function()
    local raw = mapTextBox.Text
    if not raw or raw == "" then
        notify("Femboy Hub — Map", "Please enter a valid Asset ID!", 3)
        return
    end
    local idStr = raw:gsub("rbxassetid://", ""):match("^%s*(.-)%s*$")
    local numId = tonumber(idStr)
    if not numId then
        notify("Femboy Hub — Map", "Invalid Asset ID! Numbers only.", 4)
        return
    end
    if spawnedMap and spawnedMap.Parent then
        spawnedMap:Destroy()
        spawnedMap = nil
    end
    local success, result = pcall(function()
        return game:GetObjects("rbxassetid://" .. idStr)[1]
    end)
    if not success or not result then
        notify("Femboy Hub — Map", "Failed to load map! Make sure the asset is public.", 5)
        return
    end
    result.Parent = workspace
    spawnedMap = result
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if root then
        local spawnCF = root.CFrame * CFrame.new(0, 0, -20)
        if result.PrimaryPart then
            result:SetPrimaryPartCFrame(spawnCF)
        else
            local bp = result:FindFirstChildWhichIsA("BasePart")
            if bp then bp.CFrame = spawnCF end
        end
    end
    notify("Femboy Hub — Map", "Map imported successfully! (ID: " .. idStr .. ")", 4)
end)

mapRemoveBtn.MouseButton1Click:Connect(function()
    if spawnedMap and spawnedMap.Parent then
        spawnedMap:Destroy()
        spawnedMap = nil
        notify("Femboy Hub — Map", "Imported map removed!", 3)
    else
        notify("Femboy Hub — Map", "No imported map to remove!", 3)
    end
end)

