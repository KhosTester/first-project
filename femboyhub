local function buildSlider(yPos, minVal, maxVal, initVal, fillCol, valLabel, onChange)
    local track = Instance.new("Frame", Cnt)
    track.Size             = UDim2.new(1, 0, 0, 9)
    track.Position         = UDim2.new(0, 0, 0, yPos)
    track.BackgroundColor3 = C.midGray
    track.BorderSizePixel  = 0
    track.ZIndex           = 14
    corner(track, 99)

    local fill = Instance.new("Frame", track)
    fill.BackgroundColor3 = fillCol
    fill.BorderSizePixel  = 0
    fill.Size             = UDim2.new(0, 0, 1, 0)
    fill.ZIndex           = 15
    corner(fill, 99)

    local knob = Instance.new("Frame", track)
    knob.Size             = UDim2.new(0, 18, 0, 18)
    knob.AnchorPoint      = Vector2.new(0.5, 0.5)
    knob.Position         = UDim2.new(0, 0, 0.5, 0)
    knob.BackgroundColor3 = C.white
    knob.BorderSizePixel  = 0
    knob.ZIndex           = 17
    corner(knob, 99)
    stroke(knob, 2.5, fillCol)

    local curVal   = initVal
    local dragging = false

    local function setVal(v)
        curVal = math.clamp(math.round(v), minVal, maxVal)
        local frac = (curVal - minVal) / (maxVal - minVal)
        fill.Size     = UDim2.new(frac, 0, 1, 0)
        knob.Position = UDim2.new(frac, 0, 0.5, 0)
        if valLabel then valLabel.Text = tostring(curVal) end
        if onChange  then onChange(curVal) end
    end

    local function getFrac()
        local mx = UserInputService:GetMouseLocation().X
        return math.clamp((mx - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
    end

    local function beginDrag()
        if not dragging then
            dragging    = true
            activeDrags = activeDrags + 1
            MF.Draggable = false
        end
    end

    local function endDrag()
        if dragging then
            dragging    = false
            activeDrags = math.max(0, activeDrags - 1)
            if activeDrags == 0 and not isResizing then
                MF.Draggable = true
            end
        end
    end

    track.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            beginDrag()
            setVal(minVal + getFrac() * (maxVal - minVal))
        end
    end)
    knob.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            beginDrag()
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            endDrag()
        end
    end)
    trackConn(RunService.RenderStepped:Connect(function()
        if dragging then
            setVal(minVal + getFrac() * (maxVal - minVal))
        end
    end))

    setVal(initVal)
    return function() return curVal end, setVal
end

local function presetRow(vals, y, normBg, hovBg, onFn)
    local n   = #vals
    local gap = 4
    local bw  = math.floor((344 - gap * (n - 1)) / n)
    for i, v in ipairs(vals) do
        local btn = Instance.new("TextButton", Cnt)
        btn.Size             = UDim2.new(0, bw, 0, 22)
        btn.Position         = UDim2.new(0, (i - 1) * (bw + gap), 0, y)
        btn.BackgroundColor3 = normBg
        btn.Text             = tostring(v)
        btn.TextColor3       = C.white
        btn.TextSize         = 11
        btn.Font             = Enum.Font.GothamBold
        btn.BorderSizePixel  = 0
        btn.ZIndex           = 13
        corner(btn, 5)
        stroke(btn, 1.1, hovBg)
        btn.MouseButton1Click:Connect(function() onFn(v) end)
        btn.MouseEnter:Connect(function()
            TweenService:Create(btn, TweenInfo.new(0.12), {BackgroundColor3 = hovBg}):Play()
        end)
        btn.MouseLeave:Connect(function()
            TweenService:Create(btn, TweenInfo.new(0.12), {BackgroundColor3 = normBg}):Play()
        end)
    end
end

