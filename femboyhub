-- ── PLAYER STAT — SetAttribute + Data folder ─────────────────
-- Uses 3 layers: Attribute → Data folder → leaderstats (fallback)
-- Works client-side visually, does not require leaderstats to exist
local function applyFakeStat(statName, value, aliases)
    local p = game.Players.LocalPlayer
    local targets = {statName}
    if aliases then for _,a in ipairs(aliases) do table.insert(targets, a) end end

    for _, name in ipairs(targets) do
        -- Layer 1: Attributes (Evade's UI reads from here)
        pcall(function() p:SetAttribute(name, value) end)
        -- Layer 2: Data folder
        local data = p:FindFirstChild("Data")
        if data then
            local child = data:FindFirstChild(name)
            if child then pcall(function() child.Value = value end) end
        end
        -- Layer 3: leaderstats fallback
        local ls = p:FindFirstChild("leaderstats")
        if ls then
            local child = ls:FindFirstChild(name)
            if child then pcall(function() child.Value = value end) end
        end
        -- Layer 4: Search all children
        for _, folder in ipairs(p:GetChildren()) do
            local child = folder:FindFirstChild(name)
            if child and child.Value ~= nil then
                pcall(function() child.Value = value end)
            end
        end
    end
end

-- ══════════════════════════════════════════════════════════════
-- AUTO CANDY  v2.6  —  Pro Hybrid Logic
-- ══════════════════════════════════════════════════════════════
--
-- How it works:
--   Enable → Initial Scan (sorted by nearest first) → DescendantAdded
--   → Pickup Verify (waits for candy to disappear, retries on timeout)
--   → Safety Poll every 15s  +  FolderWatcher (auto-reconnects when round changes)
--
-- Improvements over v2.4/v2.5:
--   [1] Sort candy by Magnitude (nearest first)
--   [2] Pickup Verification: wait for candy to actually disappear before
--       counting as collected — avoids missing items due to TP being too fast
--   [3] Retry: if timeout, TP again with lower offset to ensure hitbox contact
--   [4] FolderWatcher: auto-reconnect DescendantAdded when the game
--       deletes & recreates the ItemSpawns folder between rounds
-- ══════════════════════════════════════════════════════════════

-- New management variables
local candyFolderWatcher   = nil    -- Watcher for folder recreation
local PICKUP_TIMEOUT       = 1.5    -- Seconds to wait for pickup confirmation
local candyMissed          = 0      -- Counts missed candy (debug)

-- ── Filter ────────────────────────────────────────────────────
local function isCandyObject(obj)
    if not obj or not obj.Name then return false end
    local n = obj.Name:lower()
    for _, kw in ipairs(CANDY_NAMES) do
        if n:find(kw) then return true end
    end
    return false
end

local function getCandyPosition(obj)
    if not obj or not obj.Parent then return nil end
    local pos = nil
    pcall(function()
        if obj:IsA("BasePart") then
            pos = obj.Position
        elseif obj:IsA("Model") then
            -- Prefer PrimaryPart, fallback to any BasePart
            local p = obj.PrimaryPart or obj:FindFirstChildOfClass("BasePart")
            -- Wait if Model doesn't have a BasePart yet (still loading)
            if not p then
                for _ = 1, 5 do
                    task.wait(0.05)
                    p = obj.PrimaryPart or obj:FindFirstChildOfClass("BasePart")
                    if p then break end
                end
            end
            if p then pos = p.Position end
        end
    end)
    -- Reject position (0,0,0) — default value when not yet loaded
    if pos and pos.Magnitude < 0.5 then return nil end
    return pos
end

local function findItemSpawnsFolder()
    for _, pathParts in ipairs(CANDY_PATHS) do
        local cur = game; local ok = true
        for _, part in ipairs(pathParts) do
            cur = cur:FindFirstChild(part)
            if not cur then ok = false; break end
        end
        if ok and cur then return cur end
    end
    return nil
end

-- ── [1] Bot Safety Check (separated for reuse) ───────────────
local function isBotDangerousAt(pos)
    if not st.GodMode then return false end
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and not isPlayerChar(obj) then
            local botRoot = obj.PrimaryPart
                or obj:FindFirstChild("HumanoidRootPart")
                or obj:FindFirstChildWhichIsA("BasePart")
            if botRoot and (botRoot.Position - pos).Magnitude < BOT_SAFE_DIST then
                return true
            end
        end
    end
    return false
end

-- ── [1] Sort candy list by nearest distance ───────────────────
local function getSortedCandyList(itemSpawns, myPos)
    local list = {}
    for _, spawnPoint in ipairs(itemSpawns:GetChildren()) do
        -- Check spawnPoint itself
        if isCandyObject(spawnPoint) then
            local pos = getCandyPosition(spawnPoint)
            if pos then
                table.insert(list, {
                    obj  = spawnPoint,
                    pos  = pos,
                    dist = (pos - myPos).Magnitude
                })
            end
        end
        -- Check child objects inside
        for _, child in ipairs(spawnPoint:GetChildren()) do
            if isCandyObject(child) then
                local pos = getCandyPosition(child)
                if pos then
                    table.insert(list, {
                        obj  = child,
                        pos  = pos,
                        dist = (pos - myPos).Magnitude
                    })
                end
            end
        end
    end
    -- Sort: nearest candy first
    table.sort(list, function(a, b) return a.dist < b.dist end)
    return list
end

-- ── [2][3] Collect with Pickup Verification + Retry ──────────
-- Instead of counting immediately after TP, the script waits for the candy
-- to actually disappear to confirm the server received the action.
-- If timeout → retry with lower offset to ensure hitbox contact.
local function collectWithVerify(obj, pos)
    if not isCandyCollect then return false end

    local c    = player.Character
    local root = c and c:FindFirstChild("HumanoidRootPart")
    if not root then return false end

    -- Check if a bot is dangerous at candy position
    if isBotDangerousAt(pos) then
        candyStatusText = "⚠ Bot near candy — skipping"
        return false
    end

    -- Remember parent to detect when candy disappears
    local parentRef = obj.Parent

    -- Attempt 1: TP with standard offset
    root.CFrame = CFrame.new(pos + Vector3.new(0, candyTPOffset, 0))

    -- Wait for pickup verification (candy disappears from parent)
    local deadline = tick() + PICKUP_TIMEOUT
    local picked   = false
    while tick() < deadline and isCandyCollect do
        -- Candy no longer exists or has left its parent = picked up
        if not obj or not obj.Parent or obj.Parent ~= parentRef then
            picked = true; break
        end
        task.wait(0.05)
    end

    -- [3] Retry: if timeout, try again with lower offset
    if not picked and obj and obj.Parent then
        local retryPos = getCandyPosition(obj)
        if retryPos then
            candyStatusText = "🔄 Retrying..."
            root.CFrame = CFrame.new(retryPos + Vector3.new(0, 0.5, 0))
            task.wait(0.2)
            if not obj.Parent or obj.Parent ~= parentRef then
                picked = true
            end
        end
    end

    -- Update counter
    if picked then
        candyCount   = candyCount + 1
        candyStatusText = "✅ Collected: " .. candyCount
    else
        candyMissed  = candyMissed + 1
        candyStatusText = "⚠ Missed ×" .. candyMissed .. " | OK: " .. candyCount
    end

    -- Server sync delay before moving to next candy
    task.wait(candyDelay)
    return picked
end

-- ── Full folder scan (sorted) ─────────────────────────────────
local function fullSortedScan(itemSpawns)
    if not itemSpawns or not isCandyCollect then return end
    local c    = player.Character
    local root = c and c:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local sorted = getSortedCandyList(itemSpawns, root.Position)
    if #sorted == 0 then return end
    candyStatusText = "🔍 " .. #sorted .. " candy found — starting collection..."

    for _, entry in ipairs(sorted) do
        if not isCandyCollect then break end
        -- Confirm object still exists before TP
        if entry.obj and entry.obj.Parent then
            -- Update actual position (candy may have moved)
            local freshPos = getCandyPosition(entry.obj)
            if freshPos then
                collectWithVerify(entry.obj, freshPos)
            end
        end
    end
end

-- ── [4] Setup DescendantAdded event ──────────────────────────
local function setupCandyEvent(itemSpawns)
    if candyEventConn then candyEventConn:Disconnect(); candyEventConn = nil end

    candyEventConn = itemSpawns.DescendantAdded:Connect(function(obj)
        if not isCandyCollect then return end
        -- When DescendantAdded fires, the Model was just created but
        -- its BasePart inside MAY not exist yet → getCandyPosition
        -- returns nil or default (0,0,0) position → TP into air.
        -- Fix: Wait for object to actually have a BasePart with a valid position.
        task.wait(0.05)
        if not isCandyObject(obj) then return end

        -- Retry getting position up to 10 times (every 0.1s) until valid
        local pos = nil
        for _ = 1, 10 do
            pos = getCandyPosition(obj)
            -- Valid position: not nil AND not at origin (0,0,0)
            if pos and pos.Magnitude > 0.5 then break end
            pos = nil
            task.wait(0.1)
        end
        if not pos then return end   -- Still no valid position after 1s → skip

        candyStatusText = "⚡ New candy: " .. obj.Name
        collectWithVerify(obj, pos)
        if isCandyCollect then candyStatusText = "💤 Waiting for new candy..." end
    end)
end

-- ── [4] FolderWatcher: auto-reconnect when round changes ─────
-- When Evade deletes & recreates ItemSpawns between rounds,
-- the old DescendantAdded becomes orphaned. This watcher
-- detects the new folder and reconnects everything automatically.
local function startFolderWatcher()
    if candyFolderWatcher then candyFolderWatcher:Disconnect() end

    candyFolderWatcher = workspace.DescendantAdded:Connect(function(obj)
        if not isCandyCollect then return end
        -- Detect newly created ItemSpawns folder
        if obj.Name == "ItemSpawns" then
            task.wait(0.5)  -- Wait for game to populate candy into folder
            local newFolder = findItemSpawnsFolder()
            if newFolder then
                candyStatusText = "🔄 New round — Reconnecting..."
                setupCandyEvent(newFolder)
                task.spawn(function()
                    fullSortedScan(newFolder)
                    if isCandyCollect then candyStatusText = "💤 Waiting for new candy..." end
                end)
            end
        end
    end)
end

-- ── Start / Stop ──────────────────────────────────────────────
local function startCandyCollect()
    isCandyCollect  = true
    candyCount      = 0
    candyMissed     = 0
    candyStatusText = "⏳ Searching for ItemSpawns..."

    task.spawn(function()
        -- Search for ItemSpawns with 10s timeout
        local itemSpawns = nil
        local deadline   = tick() + 10
        while tick() < deadline do
            itemSpawns = findItemSpawnsFolder()
            if itemSpawns then break end
            task.wait(0.5)
        end

        if not itemSpawns then
            candyStatusText = "❌ ItemSpawns not found!\nTry entering a Custom Path."
            return
        end

        -- ① INITIAL SCAN — collect existing candy (sorted)
        candyStatusText = "🔍 Initial Scan..."
        fullSortedScan(itemSpawns)
        if not isCandyCollect then return end

        -- ② EVENT LISTENER — wake up when new candy spawns
        setupCandyEvent(itemSpawns)
        candyStatusText = "💤 Waiting for new candy..."

        -- ③ FOLDER WATCHER — auto-reconnect when round changes map
        startFolderWatcher()

        -- ④ SAFETY POLL — light scan every 15s to catch missed items
        task.spawn(function()
            while isCandyCollect do
                task.wait(15)
                if not isCandyCollect then break end
                local cur = findItemSpawnsFolder()
                if cur then
                    candyStatusText = "🔍 Safety Scan..."
                    fullSortedScan(cur)
                    if isCandyCollect then
                        candyStatusText = "💤 Waiting for new candy..."
                    end
                end
            end
        end)
    end)
end

local function stopCandyCollect()
    isCandyCollect = false
    if candyEventConn    then candyEventConn:Disconnect();    candyEventConn    = nil end
    if candyFolderWatcher then candyFolderWatcher:Disconnect(); candyFolderWatcher = nil end
    candyStatusText = "🔴 Stopped — OK: " .. candyCount .. " | Missed: " .. candyMissed
end

