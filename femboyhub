local isAutoFarmEnabled = false
local autoFarmConn      = nil
local autoFarmPhase     = 1
local autoFarmYTriggered= false

-- Teleport destinations for each phase
-- Phase 1 → (3000, 7000,  3000)
-- Phase 2 → (3000, 7000, -3000)
-- Phase 3 → (-3000, 7000, 3000)
-- Phase 4 → (-3000, 7000, -3000) → loop back to Phase 1
local farmDestinations = {
    Vector3.new( 3000, 7000,  3000),
    Vector3.new( 3000, 7000, -3000),
    Vector3.new(-3000, 7000,  3000),
    Vector3.new(-3000, 7000, -3000),
}

local function autoFarmTP()
    local char = player.Character; if not char then return end
    local hrpAF = char:FindFirstChild("HumanoidRootPart"); if not hrpAF then return end
    hrpAF.CFrame = CFrame.new(farmDestinations[autoFarmPhase])
    autoFarmYTriggered = false
end

local function startAutoFarm()
    isAutoFarmEnabled = true
    autoFarmPhase     = 1
    autoFarmTP()  -- immediately teleport to Phase 1 destination

    if autoFarmConn then autoFarmConn:Disconnect() end
    autoFarmConn = RunService.Heartbeat:Connect(function()
        if not isAutoFarmEnabled then return end
        local char = player.Character; if not char then return end
        local hrpAF = char:FindFirstChild("HumanoidRootPart"); if not hrpAF then return end

        -- When character falls below Y=6000 (dropped from Y=7000), advance phase
        if hrpAF.Position.Y < 6000 and not autoFarmYTriggered then
            autoFarmYTriggered = true
            autoFarmPhase = (autoFarmPhase % 4) + 1
            task.spawn(function()
                task.wait(0.05)
                autoFarmTP()
            end)
        end
    end)

    Notify("Auto Farm","✅ Auto Farm ON — Phase "..autoFarmPhase.." started",4)
end

local function stopAutoFarm()
    isAutoFarmEnabled = false
    if autoFarmConn then autoFarmConn:Disconnect(); autoFarmConn = nil end
    autoFarmPhase = 1
    Notify("Auto Farm","❌ Auto Farm OFF",3)
end

