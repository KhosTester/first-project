local function ec_normalize(text)
    if not text then return "" end
    if not ec_normalCache[text] then ec_normalCache[text]=string.lower(text:gsub("%s+","")) end
    return ec_normalCache[text]
end

local function ec_readTag(folder)
    if not folder then return nil end
    local a=folder:GetAttribute("Tag"); if a~=nil then return a end
    local o=folder:FindFirstChild("Tag"); if o and o:IsA("ValueBase") then return o.Value end
    return nil
end

local function ec_resolveRemotes()
    local Events=EC_RS:FindFirstChild("Events")
    local CharFolder=Events and Events:FindFirstChild("Character")
    local PassChar=CharFolder and CharFolder:FindFirstChild("PassCharacterInfo")
    EC_remoteSignal=PassChar and PassChar.OnClientEvent
end
ec_resolveRemotes()

local function ec_fireSelect(emoteName)
    if not EC_currentTag or not emoteName or emoteName=="" then return end
    local b=tonumber(EC_currentTag)
    if not b or b<0 or b>255 then return end
    local buf=buffer.create(2); buffer.writeu8(buf,0,b); buffer.writeu8(buf,1,17)
    if EC_remoteSignal then pcall(function() firesignal(EC_remoteSignal,buf,{emoteName}) end) end
end

local function ec_resolveTag()
    EC_currentTag=nil
    task.spawn(function()
        local t0=tick()
        while tick()-t0<10 do
            local gf=workspace:FindFirstChild("Game")
            if gf and gf:FindFirstChild("Players") then
                local pf=gf.Players:FindFirstChild(EC_player.Name)
                if pf then
                    EC_currentTag=ec_readTag(pf)
                    if EC_currentTag then
                        local b=tonumber(EC_currentTag)
                        if b and b>=0 and b<=255 then break else EC_currentTag=nil end
                    end
                end
            end
            task.wait(0.1)
        end
    end)
end

local function ec_setupHumanoidListeners(char)
    if not char then return end
    local isR15=char:GetAttribute("R15")==true
    local humanoidObj
    if isR15 then
        local r15=char:WaitForChild("R15Visual",5)
        if r15 then humanoidObj=r15:WaitForChild("Visual_Humanoid",5) end
    end
    if not humanoidObj then humanoidObj=char:WaitForChild("Humanoid",5) end
    if not humanoidObj then return end

    humanoidObj.AnimationPlayed:Connect(function(track)
        if not ec_emoteEnabled2 then return end
        local anim=track.Animation
        local emotesFolder=EC_RS:FindFirstChild("Items") and EC_RS.Items:FindFirstChild("Emotes")
        if not emotesFolder or not anim then return end
        if not anim:IsDescendantOf(emotesFolder) then return end
        local emoteModule=anim:FindFirstAncestorWhichIsA("ModuleScript")
        if not emoteModule then return end
        local playingName=ec_normalize(emoteModule.Name)
        for i=1,12 do
            if ec_currentEmotes[i]~="" and ec_selectEmotes[i]~="" then
                if ec_normalize(ec_currentEmotes[i])==playingName then
                    ec_fireSelect(ec_selectEmotes[i]); break
                end
            end
        end
    end)
end

local function ec_getEmoteFrame()
    local pg=EC_player.PlayerGui; if not pg then return nil end
    local shared=pg:FindFirstChild("Shared"); local hud=shared and shared:FindFirstChild("HUD")
    local interactors=hud and hud:FindFirstChild("Interactors")
    local popups=interactors and interactors:FindFirstChild("Popups")
    return popups and popups:FindFirstChild("Emote")
end

local function ec_findEmoteModelScript()
    if ec_emoteModelScript then return ec_emoteModelScript end
    for _,s in pairs(EC_player.PlayerScripts:GetDescendants()) do
        if s.Name=="EmoteModel" then ec_emoteModelScript=s; return s end
    end
    for _,s in pairs(EC_RS:GetDescendants()) do
        if s.Name=="EmoteModel" then ec_emoteModelScript=s; return s end
    end
    return nil
end

local function ec_findModuleByDisplayName(displayName)
    if displayName=="NONE" or not displayName then return nil end
    if ec_nameCache[displayName]~=nil then return ec_nameCache[displayName] end
    local emotesFolder=EC_RS:FindFirstChild("Items"); if not emotesFolder then ec_nameCache[displayName]=nil; return nil end
    emotesFolder=emotesFolder:FindFirstChild("Emotes"); if not emotesFolder then ec_nameCache[displayName]=nil; return nil end
    local norm=ec_normalize(displayName)
    for _,m in pairs(emotesFolder:GetChildren()) do
        local ok,data=pcall(require,m)
        if ok and data then
            local dn=data.AppearanceInfo and (data.AppearanceInfo.NameShorted or data.AppearanceInfo.Name)
            if dn and ec_normalize(dn)==norm then ec_nameCache[displayName]=m.Name; return m.Name end
        end
    end
    ec_nameCache[displayName]=nil; return nil
end

local function ec_saveOriginalEmoteData(frame)
    if not frame then return end
    ec_originalEmoteData={}
    local function saveSlot(slot, key)
        if not slot then return end
        local tl=slot:FindFirstChild("TextLabel")
        if tl then ec_originalEmoteData[key]={displayText=tl.Text, emoteName=ec_findModuleByDisplayName(tl.Text) or tl.Text} end
    end
    local w1=frame:FindFirstChild("Wheel"); local w2=frame:FindFirstChild("Wheel2")
    if w1 then for i=1,6 do saveSlot(w1:FindFirstChild("Emote"..i),"Wheel_Emote"..i) end end
    if w2 then for i=1,6 do saveSlot(w2:FindFirstChild("Emote"..i),"Wheel2_Emote"..i) end end
    ec_emoteDataSaved=true
end

local function ec_restoreOriginalEmotes()
    if not ec_emoteModelScript then ec_findEmoteModelScript() end
    if not ec_emoteModelScript or not ec_emoteFrame then return end
    local emf=require(ec_emoteModelScript)
    local function processSlot(slot, key)
        if not slot then return end
        local tl=slot:FindFirstChild("TextLabel"); local vf=slot:FindFirstChild("ViewportFrame")
        if tl and vf then
            local orig=ec_originalEmoteData[key]
            if orig then
                if vf:FindFirstChild("WorldModel") then vf.WorldModel:Destroy() end
                if orig.displayText~="NONE" and orig.emoteName then
                    local em=EC_RS.Items.Emotes:FindFirstChild(orig.emoteName)
                    if em then emf(vf,orig.emoteName) end
                    tl.Text=orig.displayText
                else tl.Text="NONE" end
            end
        end
    end
    local w1=ec_emoteFrame:FindFirstChild("Wheel"); local w2=ec_emoteFrame:FindFirstChild("Wheel2")
    if w1 then for i=1,6 do processSlot(w1:FindFirstChild("Emote"..i),"Wheel_Emote"..i) end end
    if w2 then for i=1,6 do processSlot(w2:FindFirstChild("Emote"..i),"Wheel2_Emote"..i) end end
end

local function ec_replaceEmotesFrame()
    if not ec_replacementEnabled or not ec_emoteDataSaved or not ec_emoteFrame then return end
    if not ec_emoteModelScript then ec_findEmoteModelScript() end
    if not ec_emoteModelScript then return end
    local emf=require(ec_emoteModelScript)
    local function processSlot(slot, wheelName, i)
        if not slot then return end
        local tl=slot:FindFirstChild("TextLabel"); if not tl then return end
        local norm=ec_normalize(tl.Text)
        for j=1,12 do
            if ec_currentEmotes[j]~="" and ec_selectEmotes[j]~="" then
                if norm==ec_normalize(ec_currentEmotes[j]) then
                    local vf=slot.ViewportFrame
                    if vf then
                        local rm=EC_RS.Items.Emotes:FindFirstChild(ec_selectEmotes[j])
                        if rm then
                            local key=wheelName.."_Emote"..i
                            if not ec_originalEmoteData[key] then
                                ec_originalEmoteData[key]={displayText=tl.Text, emoteName=ec_findModuleByDisplayName(tl.Text) or tl.Text}
                            end
                            if vf:FindFirstChild("WorldModel") then vf.WorldModel:Destroy() end
                            local ok,td=pcall(require,rm)
                            if ok and td then
                                local dn=td.AppearanceInfo and (td.AppearanceInfo.NameShorted or td.AppearanceInfo.Name)
                                emf(vf,ec_selectEmotes[j]); tl.Text=dn or ec_selectEmotes[j]
                            end
                        end
                    end
                    break
                end
            end
        end
    end
    local w1=ec_emoteFrame:FindFirstChild("Wheel"); local w2=ec_emoteFrame:FindFirstChild("Wheel2")
    if w1 then for i=1,6 do processSlot(w1:FindFirstChild("Emote"..i),"Wheel",i) end end
    if w2 then for i=1,6 do processSlot(w2:FindFirstChild("Emote"..i),"Wheel2",i) end end
end

local function ec_swapNames(curr, sel)
    local ef=EC_RS:FindFirstChild("Items"); if not ef then return false end
    ef=ef:FindFirstChild("Emotes"); if not ef then return false end
    local co=ef:FindFirstChild(curr); local so=ef:FindFirstChild(sel)
    if co and so then
        local tmp=sel.."_FemboyTemp"
        while ef:FindFirstChild(tmp) do tmp=tmp.."_" end
        co.Name=tmp; so.Name=curr; co.Name=sel; return true
    end
    return false
end
local function ec_resetSwappedNames()
    local ef=EC_RS:FindFirstChild("Items"); if not ef then return false end
    ef=ef:FindFirstChild("Emotes"); if not ef then return false end
    for curr,sel in pairs(ec_swappedPairs) do
        local co=ef:FindFirstChild(sel); local so=ef:FindFirstChild(curr)
        if co and so then
            local tmp=curr.."_FemboyTemp"
            while ef:FindFirstChild(tmp) do tmp=tmp.."_" end
            co.Name=tmp; so.Name=sel; co.Name=curr
        end
    end
    return true
end

local function ec_handleRespawn()
    local now=tick()
    if ec_respawnInProgress and (now-ec_lastRespawnTime)<2 then return end
    ec_respawnInProgress=true; ec_lastRespawnTime=now
    EC_currentTag=nil; ec_emoteFrame=nil
    if ec_reapplyThread then task.cancel(ec_reapplyThread); ec_reapplyThread=nil end

    task.spawn(function()
        local t0=tick()
        while tick()-t0<10 do
            local gf=workspace:FindFirstChild("Game")
            if gf and gf:FindFirstChild("Players") then
                local pf=gf.Players:FindFirstChild(EC_player.Name)
                if pf then
                    EC_currentTag=ec_readTag(pf)
                    if EC_currentTag then
                        local b=tonumber(EC_currentTag)
                        if b and b>=0 and b<=255 then break else EC_currentTag=nil end
                    end
                end
            end
            task.wait(0.1)
        end
        ec_respawnInProgress=false
    end)

    if ec_replacementEnabled and ec_emoteDataSaved then
        ec_reapplyThread=task.delay(1.5,function()
            if not ec_replacementEnabled then return end
            for attempt=1,30 do
                ec_emoteFrame=ec_getEmoteFrame()
                if ec_emoteFrame then
                    ec_saveOriginalEmoteData(ec_emoteFrame)
                    ec_restoreOriginalEmotes(); ec_replaceEmotesFrame(); break
                end
                task.wait(0.1)
            end
        end)
    end
end

local function ec_isValidEmote(name)
    if name=="" then return false,"" end
    local norm=ec_normalize(name)
    local ef=EC_RS:FindFirstChild("Items"); if not ef then return false,"" end
    ef=ef:FindFirstChild("Emotes"); if not ef then return false,"" end
    for _,m in ipairs(ef:GetChildren()) do
        if m:IsA("ModuleScript") and ec_normalize(m.Name)==norm then return true,m.Name end
    end
    return false,""
end

local function ec_installListeners()
    if ec_listenerReady then return end
    if EC_player.Character then ec_setupHumanoidListeners(EC_player.Character) end
    EC_player.CharacterAdded:Connect(function(newChar)
        task.wait(0.5); ec_setupHumanoidListeners(newChar); ec_handleRespawn()
    end)
    if EC_player.Character then task.spawn(ec_handleRespawn) end
    pcall(function()
        local gf=workspace:FindFirstChild("Game")
        if gf and gf:FindFirstChild("Players") then
            gf.Players.ChildAdded:Connect(function(child)
                if child.Name==EC_player.Name then task.wait(0.5); ec_handleRespawn() end
            end)
            gf.Players.ChildRemoved:Connect(function(child)
                if child.Name==EC_player.Name then EC_currentTag=nil; ec_emoteFrame=nil end
            end)
        end
    end)
    EC_player.CharacterRemoving:Connect(function()
        if next(ec_swappedPairs) then ec_resetSwappedNames() end
    end)
    EC_player.CharacterAdded:Connect(function()
        task.wait(1)
        if next(ec_swappedPairs) then
            for curr,sel in pairs(ec_swappedPairs) do ec_swapNames(curr,sel) end
        end
        if ec_pendingApply and #ec_pendingSwaps>0 then
            for _,pair in ipairs(ec_pendingSwaps) do
                if ec_swapNames(pair[1],pair[2]) then ec_swappedPairs[pair[1]]=pair[2] end
            end
            ec_pendingSwaps={}; ec_pendingApply=false
        end
    end)
    ec_listenerReady=true
end

