-- ════ EMOTE CHANGE TAB ════════════════════════════════════════
local function buildEmoteTab()
    local sNote=Tabs.Emote:AddSection("⚠ Important Note")
    sNote:AddParagraph({Title="Spaces in Emote Names",Content='If emotes have spaces e.g. "Broom of Doom", enter without spaces as "BroomofDoom".'})

    local sOH=Tabs.Emote:AddSection("Emote Changer  (Overhaul Hooks)")
    sOH:AddParagraph({Title="How It Works",Content="Intercepts your emote FireServer call and fires the selected emote instead.\nRequires hookmetamethod support."})

    local ecRS=game:GetService("ReplicatedStorage")
    local ecEvents=ecRS:FindFirstChild("Events")
    local ecCharFolder=ecEvents and ecEvents:FindFirstChild("Character")
    local ecEmoteRemote=ecCharFolder and ecCharFolder:FindFirstChild("Emote")
    local ecPassChar=ecCharFolder and ecCharFolder:FindFirstChild("PassCharacterInfo")
    local ecRSig=ecPassChar and ecPassChar.OnClientEvent

    local ecCurrent=table.create(12,"")
    local ecSelect=table.create(12,"")
    local ecEnabled=table.create(12,false)
    local ecCurInputs={}
    local ecSelInputs={}
    local ecTag=nil
    local ecPending=nil
    local ecBlock=false

    local function ecReadTag(f)
        if not f then return nil end
        local a=f:GetAttribute("Tag"); if a~=nil then return a end
        local o=f:FindFirstChild("Tag"); if o and o:IsA("ValueBase") then return o.Value end
        return nil
    end

    local function ecRespawn()
        ecTag=nil; ecPending=nil
        task.spawn(function()
            local t0=tick()
            while tick()-t0<10 do
                local g=workspace:FindFirstChild("Game"); local gp=g and g:FindFirstChild("Players")
                if gp then local pf=gp:FindFirstChild(player.Name); if pf then ecTag=ecReadTag(pf); if ecTag then local b=tonumber(ecTag); if b and b>=0 and b<=255 then break else ecTag=nil end end end end
                task.wait(0.5)
            end
        end)
    end

    local function ecFire(slot)
        if not ecTag then return end
        local b=tonumber(ecTag); if not b or b<0 or b>255 then return end
        if not ecSelect[slot] or ecSelect[slot]=="" then return end
        local buf=buffer.create(2); buffer.writeu8(buf,0,b); buffer.writeu8(buf,1,17)
        if ecRSig then pcall(firesignal,ecRSig,buf,{ecSelect[slot]}) end
    end

    if ecPassChar and ecEmoteRemote then
        ecPassChar.OnClientEvent:Connect(function()
            if not ecPending then return end
            local slot=ecPending; ecPending=nil
            task.wait(0.1); ecFire(slot)
        end)

        local ecOldNC
        local hookOk=pcall(function()
            ecOldNC=hookmetamethod(game,"__namecall",function(self,...)
                local m; pcall(function() m=getnamecallmethod() end)
                local args={...}
                if m=="FireServer" and self==ecEmoteRemote and type(args[1])=="string" then
                    for i=1,12 do
                        if ecEnabled[i] and ecCurrent[i]~="" and args[1]==ecCurrent[i] then
                            ecPending=i; ecBlock=true
                            task.spawn(function() task.wait(0.1); ecBlock=false; if ecPending==i then ecPending=nil; ecFire(i) end end)
                            if ecBlock then return nil end
                        end
                    end
                end
                return ecOldNC(self,...)
            end)
        end)

        if not hookOk then Fluent:Notify({Title="Emote Change",Content="⚠ Executor does not support hookmetamethod.\nTry Emote Swapper below.",Duration=6}) end

        if player.Character then task.spawn(ecRespawn) end
        player.CharacterAdded:Connect(function() task.wait(1); ecRespawn() end)
    end

    local sCur=Tabs.Emote:AddSection("Current Emotes  (what you trigger)")
    for i=1,12 do ecCurInputs[i]=sCur:AddInput("EC_C"..i,{Title="Current Emote "..i,Default="",Placeholder="Emote name (no spaces)",Callback=function(v) ecCurrent[i]=v:gsub("%s+","") end}) end

    local sSel=Tabs.Emote:AddSection("Select Emotes  (what plays instead)")
    for i=1,12 do ecSelInputs[i]=sSel:AddInput("EC_S"..i,{Title="Select Emote "..i,Default="",Placeholder="Replacement emote (no spaces)",Callback=function(v) ecSelect[i]=v:gsub("%s+","") end}) end

    local sECBtn=Tabs.Emote:AddSection("Changer Actions")
    sECBtn:AddButton({Title="✅ Apply Emote Mappings",Callback=function()
        local function norm(s) return s:gsub("%s+",""):lower() end
        local function valid(name)
            if name=="" then return false,"" end
            local ef=ecRS:FindFirstChild("Items"); ef=ef and ef:FindFirstChild("Emotes")
            if ef then for _,em in ipairs(ef:GetChildren()) do if em:IsA("ModuleScript") and norm(em.Name)==norm(name) then return true,em.Name end end end
            return false,""
        end
        local ok,fail=0,0
        for i=1,12 do
            if ecCurrent[i]~="" and ecSelect[i]~="" then
                local cv,cn=valid(ecCurrent[i]); local sv,sn=valid(ecSelect[i])
                if cv and sv and cn:lower()~=sn:lower() then ecEnabled[i]=true; ok=ok+1 else ecEnabled[i]=false; fail=fail+1 end
            else ecEnabled[i]=false end
        end
        local msg=ok>0 and ("✅ "..ok.." mapping(s) applied") or ""
        if fail>0 then msg=msg..(msg~="" and "\n" or "").."⚠ "..fail.." failed (invalid/same name)" end
        if msg=="" then msg="⚠ No valid emote pairs found" end
        Fluent:Notify({Title="Emote Change",Content=msg,Duration=5})
    end})
    sECBtn:AddButton({Title="🔄 Reset All Mappings",Callback=function()
        for i=1,12 do ecCurrent[i]=""; ecSelect[i]=""; ecEnabled[i]=false end
        Fluent:Notify({Title="Emote Change",Content="🔄 All mappings cleared.",Duration=3})
    end})

    local sSwap=Tabs.Emote:AddSection("Emote Swapper  (Global — ReplicatedStorage)")
    sSwap:AddParagraph({Title="Difference vs Changer",Content="Swapper renames emotes inside ReplicatedStorage. Works on any executor, no hookmetamethod needed."})

    local swCur=table.create(12,""); local swSel=table.create(12,""); local swPairs={}; local swCurIn={}; local swSelIn={}

    local sSWC=Tabs.Emote:AddSection("Current Emotes  (Swapper)")
    for i=1,12 do swCurIn[i]=sSWC:AddInput("SW_C"..i,{Title="Current Emote "..i,Default="",Placeholder="Emote name (no spaces)",Callback=function(v) swCur[i]=v end}) end

    local sSWS=Tabs.Emote:AddSection("Select Emotes  (Swapper)")
    for i=1,12 do swSelIn[i]=sSWS:AddInput("SW_S"..i,{Title="Select Emote "..i,Default="",Placeholder="Replacement emote (no spaces)",Callback=function(v) swSel[i]=v end}) end

    local function swapNames(cur,sel)
        local items=ecRS:FindFirstChild("Items"); if not items then return false end
        local ef=items:FindFirstChild("Emotes"); if not ef then return false end
        local cO=ef:FindFirstChild(cur); local sO=ef:FindFirstChild(sel)
        if cO and sO then local tmp=sel.."_Tmp"..math.random(1000,9999); cO.Name=tmp; sO.Name=cur; cO.Name=sel; return true end
        return false
    end

    local function resetSwap()
        local items=ecRS:FindFirstChild("Items"); if not items then return false end
        local ef=items:FindFirstChild("Emotes"); if not ef then return false end
        for cur,sel in pairs(swPairs) do
            local cO=ef:FindFirstChild(sel); local sO=ef:FindFirstChild(cur)
            if cO and sO then local tmp=cur.."_Tmp"..math.random(1000,9999); cO.Name=tmp; sO.Name=sel; cO.Name=cur end
        end
        return true
    end

    local sSWBtn=Tabs.Emote:AddSection("Swapper Actions")
    sSWBtn:AddButton({Title="🔀 Apply Emote Swap",Callback=function()
        local sc,fc=0,0
        for i=1,12 do if swCur[i]~="" and swSel[i]~="" then if swapNames(swCur[i],swSel[i]) then swPairs[swCur[i]]=swSel[i]; sc=sc+1 else fc=fc+1 end end end
        local msg=sc>0 and ("✅ Swapped "..sc.." emote(s)") or ""
        if fc>0 then msg=msg..(msg~="" and " | " or "").."❌ Failed "..fc end
        if msg=="" then msg="⚠ No emotes specified" end
        Fluent:Notify({Title="Emote Swapper",Content=msg,Duration=3})
    end})
    sSWBtn:AddButton({Title="🔄 Reset Emote Swap",Callback=function()
        if resetSwap() then swPairs={}; for i=1,12 do swCur[i]=""; swSel[i]="" end; Fluent:Notify({Title="Emote Swapper",Content="🔄 All emotes restored!",Duration=3})
