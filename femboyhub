-- ============================================================
-- STRETCH FOV  (Horizontal + Vertical for Evade)
-- ============================================================
local originalFOVBase = 70
local hStretch        = 100   -- Horizontal stretch %: 50-200, 100 = normal
local vStretch        = 100   -- Vertical   stretch %: 50-200, 100 = normal
local isStretchActive = false
local stretchConn     = nil
local HStretchSlider  = nil
local VStretchSlider  = nil

pcall(function() originalFOVBase = workspace.CurrentCamera.FieldOfView end)

-- Computes the camera FOV to simulate a stretched resolution.
-- hStretch > 100  → wider horizontal view (objects look thinner)
-- vStretch > 100  → taller vertical view  (objects look shorter)
local function computeStretchFOV()
    local cam = workspace.CurrentCamera
    local vp  = cam.ViewportSize
    if vp.X == 0 or vp.Y == 0 then return originalFOVBase end

    local realAspect = vp.X / vp.Y
    -- Simulate a stretched aspect ratio based on H/V multipliers
    local simAspect  = realAspect * (hStretch / 100) / (vStretch / 100)

    -- Roblox camera uses vertical FOV internally.
    -- 1) Compute vertical FOV from the base horizontal FOV at simulated aspect.
    local hFovRad  = math.rad(originalFOVBase)
    local vFovRad  = 2 * math.atan(math.tan(hFovRad / 2) / simAspect)
    -- 2) Convert that vertical FOV back to what Roblox needs for the real aspect.
    local resultVFov = 2 * math.atan(math.tan(vFovRad / 2) * realAspect)
    return math.clamp(math.deg(resultVFov), 1, 120)
end

local function applyStretchLoop()
    if not isStretchActive then return end
    pcall(function() workspace.CurrentCamera.FieldOfView = computeStretchFOV() end)
end

local function enableStretch()
    isStretchActive = true
    if stretchConn then stretchConn:Disconnect() end
    -- RenderStepped keeps FOV locked even when the game tries to reset it
    stretchConn = RunService.RenderStepped:Connect(applyStretchLoop)
    Notify("Stretch FOV","✅ Stretch FOV ON",3)
end

local function disableStretch()
    isStretchActive = false
    if stretchConn then stretchConn:Disconnect(); stretchConn = nil end
    pcall(function() workspace.CurrentCamera.FieldOfView = originalFOVBase end)
    Notify("Stretch FOV","🔄 FOV restored to "..originalFOVBase,3)
end

local function resetStretch()
    hStretch = 100; vStretch = 100
    if HStretchSlider and HStretchSlider.Set then HStretchSlider:Set(100) end
    if VStretchSlider and VStretchSlider.Set then VStretchSlider:Set(100) end
    if isStretchActive then
        pcall(function() workspace.CurrentCamera.FieldOfView = computeStretchFOV() end)
    end
    Notify("Stretch FOV","🔄 Stretch reset to 100% / 100%",3)
end

