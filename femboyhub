CustomTab:CreateSection("Custom Sky AssetID")
local customSkyID=""
CustomTab:CreateInput({ Name="Custom Sky AssetID", PlaceholderText="e.g. rbxassetid://130547382131410", NumbersOnly=false, OnEnter=true, Flag="CustomSkyInput", Callback=function(v) customSkyID=tostring(v) end })
CustomTab:CreateButton({ Name="✔️  Apply Custom Sky", Callback=function()
    if customSkyID=="" then Notify("Sky Change","⚠️ Please enter a Sky Asset ID first.",3); return end
    Notify("Sky Change","⏳ Applying custom sky...",2); task.spawn(function() applySkybox(customSkyID) end)
end })
CustomTab:CreateButton({ Name="🔄  Reset Sky to Default", Callback=function() resetSkybox() end })

