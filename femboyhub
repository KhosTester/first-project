-- KEYBIND HELPER
-- Stores keybind state — default None = not active
-- ============================================================
local keybinds   = {}   -- [featureName] = Enum.KeyCode or nil
local toggleRefs = {}   -- [featureName] = toggle object from AddToggle
-- Fluent.Toggles is NOT exposed by the library →
-- we save references manually when creating each Toggle so keybinds can call them.

local function registerKeybind(featureName, keyCode)
    keybinds[featureName] = (keyCode == Enum.KeyCode.Unknown) and nil or keyCode
end

-- Listen for global keybinds
-- Uses toggleRefs instead of Fluent.Toggles (Fluent doesn't expose that table)
UserInputService.InputBegan:Connect(function(inp, gpe)
    if gpe then return end
    for feat, kc in pairs(keybinds) do
        if kc and inp.KeyCode == kc then
            local toggle = toggleRefs[feat]
            if toggle then
                toggle:SetValue(not st[feat])
            end
        end
    end
    -- Reset AFK timer
    if inp.UserInputType ~= Enum.UserInputType.None then lastInputTime = tick() end
end)

