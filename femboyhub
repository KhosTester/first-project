        if espHolder then for _,folder in pairs(espHolder:GetChildren()) do local box=folder:FindFirstChild("ESPBox");if box then box.Color3=col end end end
    end)
end
local function removeESP()
    if espRainbowConn then espRainbowConn:Disconnect();espRainbowConn=nil end
    if espHolder then espHolder:Destroy();espHolder=nil end
end
