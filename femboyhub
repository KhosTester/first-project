-- Apply display name to all nametag labels on character
local function applyDisplayNameToChar()
    if fakeDisplayName == "" then return end
    pcall(function()
        local char = player.Character; if not char then return end
        local head = char:FindFirstChild("Head")
        if head then
            for _,gui in pairs(head:GetChildren()) do
                if gui:IsA("BillboardGui") then
                    for _,lbl in pairs(gui:GetDescendants()) do
                        if lbl:IsA("TextLabel") then lbl.Text = fakeDisplayName end
                    end
                end
            end
        end
        local pg = player.PlayerGui
        for _,gui in pairs(pg:GetDescendants()) do
            if gui:IsA("TextLabel") and
               (gui.Text == player.Name or gui.Text == player.DisplayName) then
                gui.Text = fakeDisplayName
            end
        end
    end)
end

