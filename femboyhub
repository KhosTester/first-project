        bill.StudsOffset=Vector3.new(0,3.2,0); bill.Adornee=head; bill.Parent=folder
        local nL=Instance.new("TextLabel"); nL.Size=UDim2.new(1,0,0.5,0); nL.BackgroundTransparency=1
        nL.Text=v.Name; nL.TextColor3=WHITE; nL.TextStrokeTransparency=0; nL.Font=Enum.Font.GothamBold; nL.TextSize=14; nL.Parent=bill
        local hL=Instance.new("TextLabel"); hL.Size=UDim2.new(1,0,0.5,0); hL.Position=UDim2.new(0,0,0.5,0)
        hL.BackgroundTransparency=1; hL.TextColor3=Color3.fromRGB(100,255,120); hL.TextStrokeTransparency=0
        hL.Font=Enum.Font.GothamBold; hL.TextSize=12; hL.Parent=bill
        local function updHP()
            local hum=char:FindFirstChild("Humanoid")
            if hum then hL.Text=math.floor((hum.Health/math.max(hum.MaxHealth,1))*100).."% HP" end
        end
        updHP(); local hum=char:FindFirstChild("Humanoid"); if hum then hum.Changed:Connect(updHP) end
    end
    local function setupPlayer(v)
        if v==player then return end
        local folder=Instance.new("Folder"); folder.Name=v.Name; folder.Parent=espHolder
        setupChar(v); v.CharacterAdded:Connect(function() task.wait(0.5); setupChar(v) end)
