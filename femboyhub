function buildPostProcessingEditor()
    local function getOrCreate(className)
        local eff=Lighting:FindFirstChildOfClass(className)
        if not eff then eff=Instance.new(className); eff.Parent=Lighting end
        return eff
    end
    local origPostCC={}; local origPostBloom={}; local origPostSR={}; local origPostBlur={}
    local cc0=Lighting:FindFirstChildOfClass("ColorCorrectionEffect")
    if cc0 then origPostCC={Brightness=cc0.Brightness,Contrast=cc0.Contrast,Saturation=cc0.Saturation,TintColor=cc0.TintColor}
    else origPostCC={Brightness=0,Contrast=0,Saturation=0,TintColor=Color3.new(1,1,1)} end
