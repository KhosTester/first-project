-- =================== EDGE LOGIC ===================
local bounceKw = {"bounce", "boost", "launch", "jump", "pad", "ramp", "platform"}
local function isBouncePart(p)
    local n = p.Name:lower()
    for _, k in pairs(bounceKw) do if n:find(k) then return true end end
    if p.Parent and (p.Parent:IsA("Model") or p.Parent:IsA("Folder")) then
        local pn = p.Parent.Name:lower()
        for _, k in pairs(bounceKw) do if pn:find(k) then return true end end
    end
    return false
end
local function applyEdge()
    if not isEdgeEnabled or not hrp or not humanoid or humanoid.Health <= 0 then return end
    local vel = hrp.AssemblyLinearVelocity
    if vel.Y < -MIN_Y_VEL then
        local parts = hrp:GetTouchingParts()
        if #parts > 0 then
            for _, p in pairs(parts) do if isBouncePart(p) then return end end
            hrp.AssemblyLinearVelocity = Vector3.new(vel.X, 0, vel.Z) + Vector3.new(0, BOOST_POWER, 0)
        end
    end
end

-- =================== FLY LOGIC ====================
local function enableFly()
    if not hrp or not humanoid then return end
    humanoid.PlatformStand = true
    flyBodyVel = Instance.new("BodyVelocity")
    flyBodyVel.Velocity  = Vector3.new(0, 0, 0)
    flyBodyVel.MaxForce  = Vector3.new(9e9, 9e9, 9e9)
    flyBodyVel.Parent    = hrp
    flyBodyGyro = Instance.new("BodyGyro")
    flyBodyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
    flyBodyGyro.P         = 9e4
    flyBodyGyro.CFrame    = hrp.CFrame
    flyBodyGyro.Parent    = hrp
    flyConn = RunService.Heartbeat:Connect(function()
        if not isFlyEnabled or not hrp or not flyBodyVel then return end
        local cam = workspace.CurrentCamera
        local dir = Vector3.new(0, 0, 0)
        local spd = flySpeed * 12
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + cam.CFrame.LookVector   end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir - cam.CFrame.LookVector   end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir = dir - cam.CFrame.RightVector  end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + cam.CFrame.RightVector  end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space)     then dir = dir + Vector3.new(0, 1, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then dir = dir - Vector3.new(0, 1, 0) end
        flyBodyVel.Velocity = if dir.Magnitude > 0 then dir.Unit * spd else Vector3.new(0, 0, 0)
        flyBodyGyro.CFrame  = cam.CFrame
    end)
end

local function disableFly()
    if flyConn     then flyConn:Disconnect();    flyConn    = nil end
    if flyBodyVel  then flyBodyVel:Destroy();    flyBodyVel  = nil end
    if flyBodyGyro then flyBodyGyro:Destroy();   flyBodyGyro = nil end
    if humanoid    then humanoid.PlatformStand = false end
end

-- =================== ESP LOGIC ====================
local rainbowHue = 0
local function createESP()
    if espHolder then espHolder:Destroy() end
    espHolder      = Instance.new("Folder")
    espHolder.Name = "FemboyESP"
    espHolder.Parent = game.CoreGui

    local function setupChar(v)
        if not v.Character then return end
        local folder = espHolder:FindFirstChild(v.Name)
        if not folder then return end
        folder:ClearAllChildren()
        local char = v.Character
        local head = char:FindFirstChild("Head")
        if not head then return end
        local box = Instance.new("SelectionBox")
        box.Name                = "ESPBox"
        box.Adornee             = char
        box.Color3              = BLUE_BORDER
        box.LineThickness       = 0.07
        box.SurfaceTransparency = 0.9
        box.SurfaceColor3       = WHITE
        box.Parent              = folder
        local bill = Instance.new("BillboardGui")
        bill.AlwaysOnTop = true
        bill.Size        = UDim2.new(0, 200, 0, 55)
        bill.StudsOffset = Vector3.new(0, 3.2, 0)
        bill.Adornee     = head
        bill.Parent      = folder
        local nameLbl = Instance.new("TextLabel")
        nameLbl.Size                   = UDim2.new(1, 0, 0.5, 0)
        nameLbl.BackgroundTransparency = 1
        nameLbl.Text                   = v.Name
        nameLbl.TextColor3             = WHITE
        nameLbl.TextStrokeTransparency = 0
        nameLbl.TextStrokeColor3       = Color3.fromRGB(0, 0, 0)
        nameLbl.Font                   = Enum.Font.GothamBold
        nameLbl.TextSize               = 14
        nameLbl.Parent                 = bill
        local hpLbl = Instance.new("TextLabel")
        hpLbl.Size                   = UDim2.new(1, 0, 0.5, 0)
        hpLbl.Position               = UDim2.new(0, 0, 0.5, 0)
        hpLbl.BackgroundTransparency = 1
        hpLbl.TextColor3             = Color3.fromRGB(100, 255, 120)
        hpLbl.TextStrokeTransparency = 0
        hpLbl.TextStrokeColor3       = Color3.fromRGB(0, 0, 0)
        hpLbl.Font                   = Enum.Font.GothamBold
        hpLbl.TextSize               = 12
        hpLbl.Parent                 = bill
        local function updateHP()
            local hum = char:FindFirstChild("Humanoid")
            if hum then
                local pct = math.floor((hum.Health / math.max(hum.MaxHealth, 1)) * 100)
                hpLbl.Text = pct .. "% HP"
            end
        end
        updateHP()
        local hum = char:FindFirstChild("Humanoid")
        if hum then hum.Changed:Connect(updateHP) end
    end

    local function setupPlayer(v)
        if v == player then return end
        local folder = Instance.new("Folder")
        folder.Name  = v.Name
        folder.Parent = espHolder
        setupChar(v)
        v.CharacterAdded:Connect(function() task.wait(0.5); setupChar(v) end)
    end

    for _, v in pairs(Players:GetPlayers()) do task.spawn(setupPlayer, v) end
    Players.PlayerAdded:Connect(setupPlayer)
    Players.PlayerRemoving:Connect(function(v)
        if espHolder then
            local f = espHolder:FindFirstChild(v.Name)
            if f then f:Destroy() end
        end
    end)

    espRainbowConn = RunService.Heartbeat:Connect(function(dt)
        rainbowHue = (rainbowHue + dt * 0.5) % 1
        local col  = Color3.fromHSV(rainbowHue, 1, 1)
        if espHolder then
            for _, folder in pairs(espHolder:GetChildren()) do
                local box = folder:FindFirstChild("ESPBox")
                if box then box.Color3 = col end
            end
        end
    end)
end

local function removeESP()
    if espRainbowConn then espRainbowConn:Disconnect(); espRainbowConn = nil end
    if espHolder       then espHolder:Destroy();        espHolder       = nil end
end

