-- MOBILE TOGGLE BUTTON
-- Floating button bottom-right — tap to show/hide the Hub UI
-- ════════════════════════════════════════════════════════════════
task.spawn(function()
    local playerGui = player:WaitForChild("PlayerGui")

    -- Remove old button if re-injecting
    local old = playerGui:FindFirstChild("FemboyMobileToggle")
    if old then old:Destroy() end

    local gui = Instance.new("ScreenGui")
    gui.Name           = "FemboyMobileToggle"
    gui.ResetOnSpawn   = false
    gui.DisplayOrder   = 999
    gui.IgnoreGuiInset = true
    gui.Parent         = playerGui

    -- Draggable container
    local btn = Instance.new("TextButton")
    btn.Size              = UDim2.fromOffset(72, 72)
    btn.Position          = UDim2.new(1, -88, 1, -120)
    btn.AnchorPoint       = Vector2.new(0, 1)
    btn.BackgroundColor3  = Color3.fromRGB(25, 25, 32)
    btn.BorderSizePixel   = 0
    btn.Text              = ""
    btn.ZIndex            = 10
    btn.Active            = true
    btn.Parent            = gui
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 20)

    -- Stroke
    local stroke = Instance.new("UIStroke")
    stroke.Color     = Color3.fromRGB(180, 60, 60)
    stroke.Thickness = 2
    stroke.Parent    = btn

    -- Icon label
    local icon = Instance.new("TextLabel")
    icon.Size                  = UDim2.fromScale(1, 0.55)
    icon.Position              = UDim2.fromScale(0, 0.08)
    icon.BackgroundTransparency = 1
    icon.Text                  = "🌸"
    icon.TextScaled            = true
    icon.Font                  = Enum.Font.GothamBold
    icon.Parent                = btn

    -- Label
    local lbl = Instance.new("TextLabel")
    lbl.Size                  = UDim2.new(1, 0, 0.38, 0)
    lbl.Position              = UDim2.fromScale(0, 0.62)
    lbl.BackgroundTransparency = 1
    lbl.Text                  = "HUB"
    lbl.TextColor3            = Color3.fromRGB(220, 220, 230)
    lbl.TextScaled            = true
    lbl.Font                  = Enum.Font.GothamBold
    lbl.Parent                = btn

    -- Drag support
    local dragging, dragStart, startPos = false, nil, nil
    btn.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.Touch
        or inp.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging  = true
            dragStart = inp.Position
            startPos  = btn.Position
        end
    end)
    btn.InputChanged:Connect(function(inp)
        if dragging and (inp.UserInputType == Enum.UserInputType.Touch
        or inp.UserInputType == Enum.UserInputType.MouseMove) then
            local delta = inp.Position - dragStart
            btn.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end)
    btn.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.Touch
        or inp.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)

    -- Toggle Hub UI visibility
    local hubVisible = true
    btn.MouseButton1Click:Connect(function()
        hubVisible = not hubVisible
        -- Toggle all Hub ScreenGuis except this button
        for _, sg in pairs(playerGui:GetChildren()) do
            if sg:IsA("ScreenGui") and sg.Name ~= "FemboyMobileToggle" and sg.Name ~= "FemboyAvatarInTab" then
                sg.Enabled = hubVisible
            end
        end
        -- Update button color to reflect state
        btn.BackgroundColor3 = hubVisible
            and Color3.fromRGB(25, 25, 32)
            or  Color3.fromRGB(60, 20, 20)
        stroke.Color = hubVisible
            and Color3.fromRGB(180, 60, 60)
            or  Color3.fromRGB(80, 80, 90)
        lbl.Text = hubVisible and "HUB" or "OFF"
    end)
end)
