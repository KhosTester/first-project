-- =================== ANIMATION HELPERS ============
local MF_W, MF_H = 700, 490
local MF_OX, MF_OY = -350, -245

local function tweenMF(props, time, style, dir)
    return TweenService:Create(MF,
        TweenInfo.new(time or 0.3, style or Enum.EasingStyle.Back, dir or Enum.EasingDirection.Out),
        props)
end

local mainVisible = false
local isMinimized = false

local function minimizeUI()
    if isMinimized then return end
    isMinimized = true
    local tw = tweenMF({
        Size     = UDim2.new(0, MF_W, 0, 0),
        Position = UDim2.new(0.5, MF_OX, 0.5, 0)
    }, 0.25, Enum.EasingStyle.Back, Enum.EasingDirection.In)
    tw:Play()
    tw.Completed:Connect(function()
        MF.Visible  = false
        MF.Size     = UDim2.new(0, MF_W, 0, MF_H)
        MF.Position = UDim2.new(0.5, MF_OX, 0.5, MF_OY)
        MinBar.Size     = UDim2.new(0, 0, 0, 36)
        MinBar.Position = UDim2.new(0.5, 0, 0, 6)
        MinBar.Visible  = true
        TweenService:Create(MinBar,
            TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
            {Size = UDim2.new(0, 230, 0, 36), Position = UDim2.new(0.5, -115, 0, 6)}
        ):Play()
    end)
end

local function expandUI()
    if not isMinimized then return end
    local tw = TweenService:Create(MinBar,
        TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.In),
        {Size = UDim2.new(0, 0, 0, 36), Position = UDim2.new(0.5, 0, 0, 6)})
    tw:Play()
    tw.Completed:Connect(function()
        MinBar.Visible = false
        isMinimized    = false
        MF.Size        = UDim2.new(0, MF_W, 0, 0)
        MF.Position    = UDim2.new(0.5, MF_OX, 0.5, 0)
        MF.Visible     = true
        tweenMF({
            Size     = UDim2.new(0, MF_W, 0, MF_H),
            Position = UDim2.new(0.5, MF_OX, 0.5, MF_OY)
        }, 0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out):Play()
    end)
end

local function showMainFrame()
    mainVisible = true
    MF.Size     = UDim2.new(0, MF_W, 0, 0)
    MF.Position = UDim2.new(0.5, MF_OX, 0.5, 0)
    MF.Visible  = true
    tweenMF({
        Size     = UDim2.new(0, MF_W, 0, MF_H),
        Position = UDim2.new(0.5, MF_OX, 0.5, MF_OY)
    }, 0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out):Play()
end

local function hideMainFrame()
    local tw = tweenMF({
        Size     = UDim2.new(0, MF_W, 0, 0),
        Position = UDim2.new(0.5, MF_OX, 0.5, 0)
    }, 0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
    tw:Play()
    tw.Completed:Connect(function()
        MF.Visible  = false
        mainVisible = false
        MF.Size     = UDim2.new(0, MF_W, 0, MF_H)
        MF.Position = UDim2.new(0.5, MF_OX, 0.5, MF_OY)
    end)
end

