-- ======================== GRAVITY FIX HELPERS ==================
-- Adjusts JumpPower proportionally when gravity changes so jumping still works
local gravityJumpConn = nil
local function applyGravityJumpFix(grav)
    local h = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    if not h then return end
    -- Only adjust if jump boost is not manually set
    if not (h.UseJumpPower) then
        pcall(function() h.UseJumpPower = true end)
    end
    local safeGrav = math.max(grav, 1)
    -- Keep a jump height of ~7 studs regardless of gravity
    local desiredHeight = 7
    local newJP = math.sqrt(2 * safeGrav * desiredHeight)
    newJP = math.clamp(newJP, 10, 250)
    pcall(function()
        if not jumpOn then
            h.JumpPower = newJP
        end
    end)
end

