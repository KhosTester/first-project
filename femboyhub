-- AUTO TICKET FARM  —  Stand-still + Event hook + Bot dodge
-- ══════════════════════════════════════════════════════════════
local ticketFarm = {
    enabled      = false,
    afkPos       = nil,
    workerConn   = nil,
    count        = 0,
    status       = "Idle",
    DWELL_TIME   = 2.0,   -- seconds standing on ticket
    UNDERGROUND_Y = -500, -- Y position to hide after collecting
    UNDERGROUND_WAIT = 8, -- seconds to stay underground
}

local function getTicketPosition(model)
    local hrp = model:FindFirstChild("HumanoidRootPart")
    if hrp then return hrp.Position end
    local pp = model.PrimaryPart
    if pp then return pp.Position end
    local bp = model:FindFirstChildWhichIsA("BasePart")
    if bp then return bp.Position end
    return nil
end

local function getActiveTickets()
    local folder = workspace:FindFirstChild("Game")
        and workspace.Game:FindFirstChild("Effects")
        and workspace.Game.Effects:FindFirstChild("Tickets")
    if not folder then return {} end
    local list = {}
    for _, model in pairs(folder:GetChildren()) do
        if model:IsA("Model") then
            local pos = getTicketPosition(model)
            if pos then table.insert(list, {model=model, position=pos}) end
        end
    end
    return list
end

local function startTicketFarm()
    local char = player.Character
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then
        Fluent:Notify({Title="Ticket Farm", Content="⚠ No character found.", Duration=3})
        return
    end

    ticketFarm.afkPos = hrp.Position
    ticketFarm.count  = 0
    ticketFarm.status = "Scanning for tickets..."

    if ticketFarm.workerConn then
        pcall(function() task.cancel(ticketFarm.workerConn) end)
    end

    ticketFarm.workerConn = task.spawn(function()
        while ticketFarm.enabled do
            task.wait(0.5)

            local c = player.Character
            local h = c and c:FindFirstChild("HumanoidRootPart")
            if not h then continue end

            local tickets = getActiveTickets()

            if #tickets == 0 then
                ticketFarm.status = "💤 No tickets — collected: " .. ticketFarm.count
                continue
            end

            ticketFarm.status = "🎫 " .. #tickets .. " ticket(s) found!"

            for _, t in pairs(tickets) do
                if not ticketFarm.enabled then break end
                if not t.model or not t.model.Parent then continue end

                local pos = getTicketPosition(t.model)
                if not pos then continue end

                -- 1. TP onto ticket
                local c2 = player.Character
                local h2 = c2 and c2:FindFirstChild("HumanoidRootPart")
                if not h2 then break end

                ticketFarm.status = "⚡ Moving to ticket..."
                pcall(function()
                    h2.CFrame = CFrame.new(pos + Vector3.new(0, 2, 0))
                    h2.AssemblyLinearVelocity = Vector3.zero
                end)

                -- 2. Stand 2s — game client auto-collects within 14 studs
                ticketFarm.status = "⏳ Collecting..."
                task.wait(ticketFarm.DWELL_TIME)

                -- 3. Count if collected
                if not t.model.Parent then
                    ticketFarm.count  = ticketFarm.count + 1
                    ticketFarm.status = "✅ Collected! Total: " .. ticketFarm.count
                end

                -- 4. TP underground to hide from bots
                local c3 = player.Character
                local h3 = c3 and c3:FindFirstChild("HumanoidRootPart")
                if h3 then
                    ticketFarm.status = "🕳 Hiding underground..."
                    pcall(function()
                        h3.CFrame = CFrame.new(
                            ticketFarm.afkPos.X,
                            ticketFarm.UNDERGROUND_Y,
                            ticketFarm.afkPos.Z
                        )
                        h3.AssemblyLinearVelocity = Vector3.zero
                    end)
                end

                -- 5. Wait underground
                task.wait(ticketFarm.UNDERGROUND_WAIT)

                -- 6. Return to AFK surface position
                if ticketFarm.enabled then
                    local c4 = player.Character
                    local h4 = c4 and c4:FindFirstChild("HumanoidRootPart")
                    if h4 and ticketFarm.afkPos then
                        ticketFarm.status = "🔼 Returning to surface..."
                        pcall(function()
                            h4.CFrame = CFrame.new(ticketFarm.afkPos)
                            h4.AssemblyLinearVelocity = Vector3.zero
                        end)
                    end
                end
            end

            if ticketFarm.enabled then
                ticketFarm.status = "💤 Waiting for next ticket spawn..."
            end
        end
    end)

    Fluent:Notify({
        Title   = "Ticket Farm",
        Content = "✅ ON — Collects tickets then hides underground.\nAFK position saved.",
        Duration = 4,
    })
end

local function stopTicketFarm()
    ticketFarm.enabled = false
    if ticketFarm.workerConn then
        pcall(function() task.cancel(ticketFarm.workerConn) end)
        ticketFarm.workerConn = nil
    end
    ticketFarm.afkPos  = nil
    ticketFarm.status  = "Idle"
    Fluent:Notify({
        Title   = "Ticket Farm",
        Content = "🔴 OFF — Total collected: " .. ticketFarm.count,
        Duration = 3,
    })
end

