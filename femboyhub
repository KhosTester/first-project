-- ── GOD MODE — Avoidance Logic ────────────────────────────────
local function isPlayerChar(m)
    for _,p in pairs(Players:GetPlayers()) do if p.Character==m then return true end end; return false
end
-- God Mode escape destinations — 4 corners of the map at safe height
local GOD_ESCAPE_POINTS = {
    Vector3.new( 150, 30,  150),
    Vector3.new(-150, 30,  150),
    Vector3.new( 150, 30, -150),
    Vector3.new(-150, 30, -150),
    Vector3.new(   0, 30,  200),
    Vector3.new(   0, 30, -200),
    Vector3.new( 200, 30,    0),
    Vector3.new(-200, 30,    0),
}
local godEscapeIdx = 1

local function enableGodMode()
    if godConn then godConn:Disconnect() end
    godConn=RunService.Heartbeat:Connect(function()
        if not st.GodMode then return end
        local c=player.Character; if not c then return end
        local root=c:FindFirstChild("HumanoidRootPart"); if not root then return end
        local hum=c:FindFirstChild("Humanoid"); if not hum or hum.Health<=0 then return end
        local myPos=root.Position; local now=tick()

        local closestDist = math.huge
        local closestBot  = nil

        -- Find the closest threatening bot
        for _,obj in pairs(workspace:GetDescendants()) do
            if obj:IsA("Model") and not isPlayerChar(obj) then
                local botRoot=obj.PrimaryPart or obj:FindFirstChild("HumanoidRootPart")
                    or obj:FindFirstChildWhichIsA("BasePart")
                if botRoot then
                    local dist=(botRoot.Position-myPos).Magnitude
                    if dist < BOT_SAFE_DIST and dist < closestDist then
                        closestDist = dist
                        closestBot  = botRoot
                    end
                end
            end
        end

        if closestBot and now-godCooldown > 0.25 then
            godCooldown = now

            -- Pick escape destination that is FARTHEST from bot
            local botPos = closestBot.Position
            local bestDest = nil; local bestScore = -math.huge
            for _, dest in ipairs(GOD_ESCAPE_POINTS) do
                local score = (dest - botPos).Magnitude
                if score > bestScore then bestScore = score; bestDest = dest end
            end

            -- TP to best escape point
            local target = bestDest or (myPos + Vector3.new(0, GOD_LIFT_H, 0))
            root.CFrame = CFrame.new(target)
            pcall(function()
                root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            end)
        end
    end)
end
local function disableGodMode()
    if godConn then godConn:Disconnect(); godConn=nil end
end

