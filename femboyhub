-- STRETCH FOV
-- ============================================================
local originalFOVBase=70; local hStretch=100; local vStretch=100
local isStretchActive=false; local stretchConn=nil
pcall(function() originalFOVBase=workspace.CurrentCamera.FieldOfView end)
local function computeStretchFOV()
    local cam=workspace.CurrentCamera; local vp=cam.ViewportSize
    if vp.X==0 or vp.Y==0 then return originalFOVBase end
    local realAspect=vp.X/vp.Y; local simAspect=realAspect*(hStretch/100)/(vStretch/100)
    local vFovRad=math.rad(originalFOVBase); local hFovRad=2*math.atan(math.tan(vFovRad/2)*simAspect)
    local newVFov=2*math.atan(math.tan(hFovRad/2)/realAspect)
    return math.clamp(math.deg(newVFov),1,120)
end
local function enableStretch()
    isStretchActive=true
    if stretchConn then stretchConn:Disconnect() end
    stretchConn=RunService.RenderStepped:Connect(function() if isStretchActive then pcall(function() workspace.CurrentCamera.FieldOfView=computeStretchFOV() end) end end)
end
local function disableStretch()
    isStretchActive=false
    if stretchConn then stretchConn:Disconnect();stretchConn=nil end
    pcall(function() workspace.CurrentCamera.FieldOfView=originalFOVBase end)
end

