local function toggleEdge()
    if isEdgeEnabled then
        isEdgeEnabled = false
        if edgeConn then edgeConn:Disconnect(); edgeConn = nil end
        eStatus.Text             = "🔴  Edge Boost: OFF"
        eStatus.TextColor3       = BLUE_DARK
        eToggle.Text             = "⚡  TOGGLE EDGE BOOST  —  OFF"
        eToggle.BackgroundColor3 = BLUE_DARK
        notify("Femboy Hub — Edge Boost", "Edge Boost disabled!", 3)
    else
        isEdgeEnabled = true
        edgeConn = RunService.Stepped:Connect(applyEdge)
        eStatus.Text             = "🟢  Edge Boost: ON"
        eStatus.TextColor3       = GREEN_ON
        eToggle.Text             = "⚡  TOGGLE EDGE BOOST  —  ON"
        eToggle.BackgroundColor3 = GREEN_ON
        notify("Femboy Hub — Edge Boost", "Edge Boost activated! Power: " .. BOOST_POWER, 4)
    end
end

local function toggleJump()
    if isJumpEnabled then
        isJumpEnabled = false
        if jumpPropConn then jumpPropConn:Disconnect(); jumpPropConn = nil end
        if humanoid then pcall(function() humanoid.JumpPower = defaultJumpPower end) end
        jStatus.Text             = "🔴  Jump Boost: OFF"
        jStatus.TextColor3       = BLUE_DARK
        jToggle.Text             = "🦵  TOGGLE JUMP BOOST  —  OFF"
        jToggle.BackgroundColor3 = BLUE_DARK
        notify("Femboy Hub — Jump", "Jump Boost disabled!", 3)
    else
        isJumpEnabled = true
        applyJumpPower()
        if humanoid then
            jumpPropConn = humanoid:GetPropertyChangedSignal("JumpPower"):Connect(function()
                if isJumpEnabled then applyJumpPower() end
            end)
        end
        jStatus.Text             = "🟢  Jump Boost: ON"
        jStatus.TextColor3       = GREEN_ON
        jToggle.Text             = "🦵  TOGGLE JUMP BOOST  —  ON"
        jToggle.BackgroundColor3 = GREEN_ON
        notify("Femboy Hub — Jump", "Jump Boost activated! Power: " .. jumpPowerValue, 4)
    end
end

