local animOverride = {
    enabled  = false,
    ID_IDLE  = "rbxassetid://10357290728",
    ID_OTHER = "rbxassetid://10357289537",
    conn     = nil,   -- AnimationPlayed hook
    idleTrack  = nil,
    otherTrack = nil,
}

local function setupAnimOverride(char)
    if not animOverride.enabled then return end
    local hum = char:WaitForChild("Humanoid", 10)
    if not hum then return end
    local animator = hum:WaitForChild("Animator", 10)
    if not animator then return end
    local hrpRef = char:FindFirstChild("HumanoidRootPart")

    -- Stop any existing tracks cleanly
    for _, t in pairs(animator:GetPlayingAnimationTracks()) do
        pcall(function() t:Stop(0) end)
    end

    -- Helper: reset all Motor6D transforms to 0,0,0 rotation
    local function resetJoints()
        for _, desc in pairs(char:GetDescendants()) do
            if desc:IsA("Motor6D") then
                pcall(function()
                    desc.Transform = CFrame.new(desc.Transform.Position)
                end)
            end
        end
    end

    -- Pre-load our custom tracks
    local function makeTrack(id)
        local anim = Instance.new("Animation")
        anim.AnimationId = id
        local track = animator:LoadAnimation(anim)
        track.Priority = Enum.AnimationPriority.Action
        return track
    end

    animOverride.idleTrack  = makeTrack(animOverride.ID_IDLE)
    animOverride.otherTrack = makeTrack(animOverride.ID_OTHER)

    -- Disconnect old hook
    if animOverride.conn then animOverride.conn:Disconnect() end

    -- Hook AnimationPlayed — intercept, reset rotation, replace
    animOverride.conn = animator.AnimationPlayed:Connect(function(track)
        if track == animOverride.idleTrack or track == animOverride.otherTrack then return end

        local name = track.Name:lower()
        local id   = track.Animation and track.Animation.AnimationId or ""

        pcall(function() track:Stop(0) end)
        -- Reset character rotation to 0,0,0 before playing our track
        resetJoints()
        if hrpRef then
            pcall(function()
                hrpRef.CFrame = CFrame.new(hrpRef.Position)
            end)
        end

        if name:find("idle") or id:find("180435571") then
            if animOverride.idleTrack and not animOverride.idleTrack.IsPlaying then
                animOverride.idleTrack:Play()
            end
        else
            if animOverride.otherTrack and not animOverride.otherTrack.IsPlaying then
                animOverride.otherTrack:Play()
            end
        end
    end)
end

local function enableAnimOverride()
    animOverride.enabled = true
    local char = player.Character
    if char then task.spawn(setupAnimOverride, char) end
end

local function disableAnimOverride()
    animOverride.enabled = false
    if animOverride.conn then animOverride.conn:Disconnect(); animOverride.conn = nil end
    if animOverride.idleTrack  then pcall(function() animOverride.idleTrack:Stop(0)  end); animOverride.idleTrack  = nil end
    if animOverride.otherTrack then pcall(function() animOverride.otherTrack:Stop(0) end); animOverride.otherTrack = nil end
end

-- Survive respawn
player.CharacterAdded:Connect(function(char)
    if animOverride.enabled then
        task.spawn(setupAnimOverride, char)
    end
end)

