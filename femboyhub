        local tw = tweenMF({
            Size     = UDim2.new(0, MF_W, 0, 0),
            Position = UDim2.new(0.5, MF_OX, 0.5, 0)
        }, 0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
        tw:Play()
        tw.Completed:Connect(function()
            MF.Size     = UDim2.new(0, MF_W, 0, MF_H)
            MF.Position = UDim2.new(0.5, MF_OX, 0.5, MF_OY)
            fullResetAndClose()
        end)
    else
        fullResetAndClose()
    end
end)

-- =================== GLOBAL KEYBINDS ==============
UserInputService.InputBegan:Connect(function(inp, gp)
    if gp or listenUI or listenEdge or listenJump or listenFly or listenEsp then return end
    if inp.KeyCode == uiKeybind then
        if isMinimized then
            expandUI()
        elseif mainVisible then
            hideMainFrame()
        else
            showMainFrame()
        end
    end
    if inp.KeyCode == edgeKeybind then toggleEdge() end
    if inp.KeyCode == jumpKeybind  then toggleJump() end
    if inp.KeyCode == flyKeybind   then toggleFly()  end
    if inp.KeyCode == espKeybind   then toggleESP()  end
end)

