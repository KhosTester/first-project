-- AUTO FARM TAB
-- ============================================================
AutoFarmTab:CreateSection("Auto Farm — Evade TP Loop")
AutoFarmTab:CreateLabel("Instantly teleports you to a high point and loops 4 positions.")
AutoFarmTab:CreateLabel("TP 1: (3000, 7000,  3000)  →  falls to Y<6000  →  next")
AutoFarmTab:CreateLabel("TP 2: (3000, 7000, -3000)  →  falls to Y<6000  →  next")
AutoFarmTab:CreateLabel("TP 3: (-3000, 7000,  3000)  →  falls to Y<6000  →  next")
AutoFarmTab:CreateLabel("TP 4: (-3000, 7000, -3000)  →  falls to Y<6000  →  back to TP 1")
AutoFarmTab:CreateLabel("Loop continues infinitely. Restarts from TP 1 after respawn.")
AutoFarmTab:CreateSection("Controls")
AutoFarmTab:CreateToggle({
    Name="Enable Auto Farm", CurrentValue=false, Flag="AutoFarmToggle",
    Callback=function(v)
        if v then startAutoFarm() else stopAutoFarm() end
    end,
})
AutoFarmTab:CreateButton({
    Name="🔄  Reset to Phase 1 (Manual)",
    Callback=function()
        if isAutoFarmEnabled then
            autoFarmPhase=1; autoFarmTP()
            Notify("Auto Farm","🔄 Manually reset to Phase 1",3)
        else Notify("Auto Farm","⚠️ Auto Farm is not active.",3) end
    end,
})
AutoFarmTab:CreateSection("Status")
AutoFarmTab:CreateButton({
    Name="📍  Show Current Phase",
    Callback=function()
        if isAutoFarmEnabled then
            local dest=farmDestinations[autoFarmPhase]
            Notify("Auto Farm","Phase "..autoFarmPhase.."\nTarget: ("..dest.X..", "..dest.Y..", "..dest.Z..")",4)
        else Notify("Auto Farm","Auto Farm is OFF",3) end
    end,
})

