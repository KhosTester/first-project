local skyIDs={"130547382131410","128839006185497","125641870562571","127770372529424","110570238374062","138349252564540","82666462942145","95142505890749","110326016107832","123826538827500","7108851308","15983996673","15983996673","12376964583","6900508449","10594723714","11675661848","116402178504134","16262385808","11336743666"}
CustomTab:CreateSection("Quick Sky Presets (20 Skies)")
CustomTab:CreateDropdown({
    Name="Select Sky & Apply", Options=skyNames, CurrentOption={skyNames[1]}, Flag="SkyPresetDropdown",
    Callback=function(v) local sel=v[1] or v; for i,n in ipairs(skyNames) do if n==sel then Notify("Sky Change","⏳ Applying "..n.."...",2); task.spawn(function() applySkybox(skyIDs[i]) end); break end end end,
