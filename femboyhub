local function playIntro()
    MF.Visible = true
    MF.Size    = UDim2.new(0, 0, 0, 0)
    MF.BackgroundTransparency = 1
    outerStroke.Transparency  = 1
    TitleLbl.TextColor3 = C.white
    showHandles()
    TweenService:Create(MF, TweenInfo.new(1.0, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, FW, 0, FH),
        BackgroundTransparency = 0,
    }):Play()
    TweenService:Create(outerStroke, TweenInfo.new(0.9), {Transparency = 0}):Play()
    task.delay(1.0, function()
        TweenService:Create(outerStroke,
            TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, 3, true),
            {Thickness = 12}):Play()
    end)
    task.delay(1.2, function()
        local function shimmer(n)
            if n <= 0 then
                TweenService:Create(TitleLbl, TweenInfo.new(0.3), {TextColor3 = C.red}):Play()
                return
            end
            TweenService:Create(TitleLbl, TweenInfo.new(0.25), {TextColor3 = C.red}):Play()
            task.delay(0.25, function()
                TweenService:Create(TitleLbl, TweenInfo.new(0.25), {TextColor3 = C.white}):Play()
                task.delay(0.25, function() shimmer(n - 1) end)
            end)
        end
        shimmer(4)
    end)
    task.delay(3.5, function()
        TweenService:Create(outerStroke, TweenInfo.new(0.4), {Thickness = 4}):Play()
        TweenService:Create(TitleLbl,   TweenInfo.new(0.3), {TextColor3 = C.red}):Play()
    end)
end

