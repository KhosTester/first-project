-- FLY
local flyOn    = false
local flyConn2 = nil
local flyBV    = nil
local flyBG    = nil

local function startFly()
    local c = player.Character
    if not c then return end
    local fhrp = c:FindFirstChild("HumanoidRootPart")
    local fhum = c:FindFirstChildOfClass("Humanoid")
    if not fhrp or not fhum then return end
    fhum.PlatformStand = true

    flyBV            = Instance.new("BodyVelocity")
    flyBV.MaxForce   = Vector3.new(1e6, 1e6, 1e6)
    flyBV.Velocity   = Vector3.new(0, 0, 0)
    flyBV.Parent     = fhrp

    flyBG            = Instance.new("BodyGyro")
    flyBG.MaxTorque  = Vector3.new(1e6, 1e6, 1e6)
    flyBG.P          = 1e4
    flyBG.D          = 100
    flyBG.CFrame     = fhrp.CFrame
    flyBG.Parent     = fhrp

    flyConn2 = trackConn(RunService.RenderStepped:Connect(function()
        if not flyOn then return end
        local c2 = player.Character
        if not c2 then return end
        local fhrp2 = c2:FindFirstChild("HumanoidRootPart")
        if not fhrp2 then return end
        local cam   = workspace.CurrentCamera
        local speed = getFlySpeed()
        local dir   = Vector3.new(0, 0, 0)
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then
            local lv = cam.CFrame.LookVector
            dir = dir + Vector3.new(lv.X, 0, lv.Z).Unit
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then
            local lv = cam.CFrame.LookVector
            dir = dir - Vector3.new(lv.X, 0, lv.Z).Unit
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then
            local rv = cam.CFrame.RightVector
            dir = dir - Vector3.new(rv.X, 0, rv.Z).Unit
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then
            local rv = cam.CFrame.RightVector
            dir = dir + Vector3.new(rv.X, 0, rv.Z).Unit
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
            dir = dir + Vector3.new(0, 1, 0)
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
            dir = dir - Vector3.new(0, 1, 0)
        end
        local vel = Vector3.new(0, 0, 0)
        if dir.Magnitude > 0 then
            vel = dir.Unit * speed
        end
        if flyBV and flyBV.Parent then flyBV.Velocity = vel end
        if flyBG and flyBG.Parent and dir.Magnitude > 0 then
            local lv = cam.CFrame.LookVector
            local lt = Vector3.new(lv.X, 0, lv.Z)
            if lt.Magnitude > 0 then
                flyBG.CFrame = CFrame.lookAt(fhrp2.Position, fhrp2.Position + lt)
            end
        end
    end))
end

local function stopFly()
    if flyConn2 then flyConn2:Disconnect(); flyConn2 = nil end
    if flyBV then pcall(function() flyBV:Destroy() end); flyBV = nil end
    if flyBG then pcall(function() flyBG:Destroy() end); flyBG = nil end
    local c = player.Character
    if c then
        local fhum = c:FindFirstChildOfClass("Humanoid")
        if fhum then fhum.PlatformStand = false end
    end
end

