local function showHandles()
    if not MF.Visible then return end
    HR.Visible = true; HB.Visible = true; HT.Visible = true
    HCbr.Visible = true; HCtr.Visible = true
end
local function hideHandles()
    HR.Visible = false; HB.Visible = false; HT.Visible = false
