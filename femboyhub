-- =================== UI HELPERS ===================
local function corner(r, p)
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, r); c.Parent = p
end
local function stroke(col, thick, p)
    local s = Instance.new("UIStroke"); s.Color = col; s.Thickness = thick; s.Parent = p
end
local function uiPad(a, p)
    local u = Instance.new("UIPadding")
    u.PaddingTop = UDim.new(0, a); u.PaddingBottom = UDim.new(0, a)
    u.PaddingLeft = UDim.new(0, a); u.PaddingRight  = UDim.new(0, a)
    u.Parent = p
end
local function listLayout(gap, p)
    local l = Instance.new("UIListLayout")
    l.Padding   = UDim.new(0, gap)
    l.SortOrder = Enum.SortOrder.LayoutOrder
    l.Parent    = p
    return l
end
local function mkLabel(parent, text, h, col, align)
    local l = Instance.new("TextLabel")
    l.Size                   = UDim2.new(1, 0, 0, h or 22)
    l.BackgroundTransparency = 1
    l.Text                   = text
    l.TextColor3             = col or GRAY_TEXT
    l.Font                   = Enum.Font.GothamBold
    l.TextSize               = 15
    l.TextXAlignment         = align or Enum.TextXAlignment.Left
    l.TextWrapped            = true
    l.Parent                 = parent
    return l
end

local function mkBtn(parent, text, bg, tc, h)
    local b = Instance.new("TextButton")
    b.Size                   = UDim2.new(1, 0, 0, h or 36)
    b.BackgroundColor3       = bg or BLUE_BTN
    b.BorderSizePixel        = 0
    b.Text                   = text
    b.TextColor3             = tc or WHITE
    b.TextStrokeColor3       = BLUE_DARK
    b.TextStrokeTransparency = 0.3
    b.Font                   = Enum.Font.GothamBold
    b.TextSize               = 15
    b.AutoButtonColor        = true
    b.Parent                 = parent
    corner(8, b); stroke(BLUE_DARK, 2, b)
    return b
end

local function mkSection(parent, titleText, order)
    local wrap = Instance.new("Frame")
    wrap.Size             = UDim2.new(1, 0, 0, 0)
    wrap.AutomaticSize    = Enum.AutomaticSize.Y
    wrap.BackgroundColor3 = BLUE
    wrap.BorderSizePixel  = 0
    wrap.LayoutOrder      = order or 0
    wrap.Parent           = parent
    corner(10, wrap); stroke(BLUE_BORDER, 3, wrap)

    local inner = Instance.new("Frame")
    inner.Size                   = UDim2.new(1, 0, 0, 0)
    inner.AutomaticSize          = Enum.AutomaticSize.Y
    inner.BackgroundTransparency = 1
    inner.Parent                 = wrap
    listLayout(8, inner); uiPad(10, inner)

    local secTitleLbl = nil
    if titleText then
        local hdr = Instance.new("Frame")
        hdr.Size             = UDim2.new(1, -20, 0, 34)
        hdr.BackgroundColor3 = BLUE_BTN
        hdr.BorderSizePixel  = 0
        hdr.LayoutOrder      = 0
        hdr.Parent           = inner
        corner(7, hdr); stroke(BLUE_DARK, 2, hdr)
        secTitleLbl = Instance.new("TextLabel")
        secTitleLbl.Size                   = UDim2.new(1, -14, 1, 0)
        secTitleLbl.Position               = UDim2.new(0, 10, 0, 0)
        secTitleLbl.BackgroundTransparency = 1
        secTitleLbl.Text                   = titleText
        secTitleLbl.TextColor3             = WHITE
        secTitleLbl.TextStrokeColor3       = BLUE_DARK
        secTitleLbl.TextStrokeTransparency = 0.3
        secTitleLbl.Font                   = Enum.Font.GothamBold
        secTitleLbl.TextSize               = 15
        secTitleLbl.TextXAlignment         = Enum.TextXAlignment.Left
        secTitleLbl.Parent                 = hdr
    end
    return wrap, inner, secTitleLbl
end

local function mkSlider(parent, minV, maxV, curV)
    local bg = Instance.new("Frame")
    bg.Size             = UDim2.new(1, 0, 0, 18)
    bg.BackgroundColor3 = Color3.fromRGB(230, 200, 245)
    bg.BorderSizePixel  = 0
    bg.Parent           = parent
    corner(9, bg); stroke(BLUE_BORDER, 2, bg)
    local fill = Instance.new("Frame")
    fill.Size             = UDim2.new((curV - minV) / (maxV - minV), 0, 1, 0)
    fill.BackgroundColor3 = BLUE_BTN
    fill.BorderSizePixel  = 0
    fill.Parent           = bg
    corner(9, fill)
    local knob = Instance.new("Frame")
    knob.Size             = UDim2.new(0, 18, 0, 18)
    knob.Position         = UDim2.new(fill.Size.X.Scale, -9, 0.5, -9)
    knob.BackgroundColor3 = WHITE
    knob.BorderSizePixel  = 0
    knob.Parent           = bg
    corner(9, knob); stroke(BLUE_DARK, 2, knob)
    return bg, fill, knob
end

