local function applyEdgeBoost()
    if not st.EdgeBoost or not hrp or not humanoid or humanoid.Health<=0 then return end
    if hrp.AssemblyLinearVelocity.Y < -1 then
        local tp=hrp:GetTouchingParts(); local bounce=false
        for _,p in pairs(tp) do
            local n=p.Name:lower()
            for _,k in pairs({"bounce","boost","launch","jump","pad","ramp","platform"}) do
                if n:find(k) then bounce=true; break end
            end
            if bounce then break end
        end
        if not bounce and #tp>0 then
            hrp.AssemblyLinearVelocity=Vector3.new(hrp.AssemblyLinearVelocity.X,BOOST_POWER,hrp.AssemblyLinearVelocity.Z)
        end
    end
end

