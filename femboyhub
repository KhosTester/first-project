local function buildFarmTab()
    local sFM=Tabs.Farm:AddSection("Auto Farm")
    sFM:AddDropdown("FarmMethod",{Title="Method",Values={"Method 1 — 4-Point TP Loop","Method 2 — Platform Hover","Method 3 — Underground AFK"},Default="Method 1 — 4-Point TP Loop",Callback=function(v)
        local s=tostring(v)
        if s:find("Method 1") then farm.method=1 elseif s:find("Method 2") then farm.method=2 elseif s:find("Method 3") then farm.method=3 end
        if farm.active then stopAutoFarm(); task.wait(0.2); startAutoFarm() end
    end})
    toggleRefs["AutoFarm"]=sFM:AddToggle("AutoFarm",{Title="Enable Auto Farm",Default=false,Callback=function(v)
        st.AutoFarm=v; if v then startAutoFarm() else stopAutoFarm() end
    end})
    end

    sVote:AddDropdown("VoteMode", {
        Title   = "Vote Priority",
        Values  = {"Easiest First", "Hardest First", "Random"},
        Default = "Easiest First",
        Callback = function(v)
            autoVoteMode = tostring(v)
            
        end,
    })

    toggleRefs["AutoVote"] = sVote:AddToggle("AutoVote", {
        Title   = "Enable Auto Vote",
        Default = false,
        Callback = function(v)
            st.AutoVote = v
            if v then
                task.spawn(function()
                    local playerGui = player:WaitForChild("PlayerGui")
                    if autoVoteConn then autoVoteConn:Disconnect() end

                    -- Continuous scan: check every 2s if Vote frame is visible
                    -- This way it works whether toggled before or during the vote screen
                    autoVoteConn = RunService.Heartbeat:Connect(function()
                        if not st.AutoVote then return end
                        -- Throttle to once per 2 seconds
                        if not autoVoteConn._lastCheck then autoVoteConn._lastCheck = 0 end
                        if tick() - autoVoteConn._lastCheck < 2 then return end
                        autoVoteConn._lastCheck = tick()

                        for _, desc in pairs(playerGui:GetDescendants()) do
                            if desc.Name == "Vote" and desc:IsA("Frame") and desc.Visible then
                                -- Vote screen is open — vote if not already voted
                                local choices = desc:FindFirstChild("Choices")
                                if choices then
                                    -- Check if already voted (any slot shows Voted=true visible)
                                    local alreadyVoted = false
                                    for i = 1, 4 do
                                        local container = choices:FindFirstChild(tostring(i))
                                        local imgBtn = container and (container:FindFirstChild("ImageButton") or container:FindFirstChildOfClass("ImageButton"))
                                        local votedLabel = imgBtn and imgBtn:FindFirstChild("Voted")
                                        if votedLabel and votedLabel.Visible then
                                            alreadyVoted = true; break
                                        end
                                    end
                                    if not alreadyVoted then
                                        task.spawn(executeAutoVote)
                                    end
                                end
                                break
                            end
                        end
                    end)
                end)
            else
                if autoVoteConn then autoVoteConn:Disconnect(); autoVoteConn=nil end
            end
        end,
    })
    sVote:AddButton({Title="🖱 Vote Now (manual)", Callback=function()
        task.spawn(executeAutoVote)
    end})

    sFM:AddButton({Title="Reset Phase 1 (M1)",Callback=function()
        if farm.active and farm.method==1 then farm.phase=1; farmTP(); Fluent:Notify({Title="Farm",Content="🔄 Reset to Phase 1.",Duration=2}) end
    end})
    sFM:AddButton({Title="Return to Surface (M3)",Callback=function()
        if farm.method==3 then
            local c=player.Character; if not c then return end
            local h=c:FindFirstChild("HumanoidRootPart")
            if h then h.CFrame=CFrame.new(0,5,0); h.AssemblyLinearVelocity=Vector3.new(); Fluent:Notify({Title="Farm M3",Content="🔄 Returned to surface.",Duration=2}) end
        end
    end})

    local sTF = Tabs.Farm:AddSection("Auto Ticket Farm  🎫")
    local tfStatusPara = sTF:AddParagraph({Title="Status",  Content="Idle"})
    local tfCountPara  = sTF:AddParagraph({Title="Collected",Content="0"})
    RunService.Heartbeat:Connect(function()
        pcall(function() tfStatusPara:SetDesc(ticketFarm.status) end)
        pcall(function() tfCountPara:SetDesc(tostring(ticketFarm.count)) end)
    end)
    toggleRefs["TicketFarm"] = sTF:AddToggle("TicketFarm", {
        Title    = "🎫 Enable Auto Ticket Farm",
        Default  = false,
        Callback = function(v)
            st.TicketFarm = v
            ticketFarm.enabled = v
            if v then startTicketFarm() else stopTicketFarm() end
        end,
    })

    local sAFK=Tabs.Farm:AddSection("Anti-AFK")
    toggleRefs["AntiAFK"]=sAFK:AddToggle("AntiAFK",{Title="Enable Anti-AFK",Default=false,Callback=function(v)
        st.AntiAFK=v
        if v then lastInputTime=tick(); enableAntiAFK()
        else disableAntiAFK() end
    end})
    local sAFKT=Tabs.Farm:AddSection("AFK Countdown")
    local afkTimeP=sAFKT:AddParagraph({Title="Time Until Kick",Content="20:00"})
    local afkStatusP=sAFKT:AddParagraph({Title="Status",Content="Active"})
    RunService.Heartbeat:Connect(function()
        local elapsed=tick()-lastInputTime; local remaining=math.max(0,1200-elapsed)
        pcall(function() afkTimeP:SetDesc(string.format("%02d:%02d",math.floor(remaining/60),math.floor(remaining%60))) end)
        pcall(function()
            if remaining<=60 then afkStatusP:SetDesc("⚠ ABOUT TO BE KICKED!")
            elseif remaining<=300 then afkStatusP:SetDesc("⚡ Warning — less than 5 minutes left")
            else afkStatusP:SetDesc("✔ Active — No AFK risk") end
        end)
    end)
end
