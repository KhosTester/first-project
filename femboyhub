-- =================== FULL RESET & CLOSE ===========
local function fullResetAndClose()
    -- 1. Disable Edge Boost
    if isEdgeEnabled then
        isEdgeEnabled = false
        if edgeConn then edgeConn:Disconnect(); edgeConn = nil end
        eStatus.Text             = "🔴  Edge Boost: OFF"
        eStatus.TextColor3       = BLUE_DARK
        eToggle.Text             = "⚡  TOGGLE EDGE BOOST  —  OFF"
        eToggle.BackgroundColor3 = BLUE_DARK
    end

    -- 2. Disable Jump Boost & restore default jump power
    if isJumpEnabled then
        isJumpEnabled = false
        if jumpPropConn then jumpPropConn:Disconnect(); jumpPropConn = nil end
        if humanoid then pcall(function() humanoid.JumpPower = defaultJumpPower end) end
        jStatus.Text             = "🔴  Jump Boost: OFF"
        jStatus.TextColor3       = BLUE_DARK
        jToggle.Text             = "🦵  TOGGLE JUMP BOOST  —  OFF"
        jToggle.BackgroundColor3 = BLUE_DARK
    end

    -- 3. Disable Fly
    if isFlyEnabled then
        isFlyEnabled = false
        disableFly()
        fStatus.Text             = "🔴  Fly: OFF"
        fStatus.TextColor3       = BLUE_DARK
        fToggle.Text             = "🕊️  TOGGLE FLY  —  OFF"
        fToggle.BackgroundColor3 = BLUE_DARK
    end

    -- 4. Disable ESP
    if isEspEnabled then
        isEspEnabled = false
        removeESP()
        espStatusLbl.Text             = "🔴  ESP: OFF"
        espStatusLbl.TextColor3       = BLUE_DARK
        espToggle.Text                = "👁️  TOGGLE ESP  —  OFF"
        espToggle.BackgroundColor3    = BLUE_DARK
    end

    -- 5. Reset sky to default
    resetSky()

    -- 6. Reset sliders to default values
    updateEdge(80)
    updateJump(20)
    updateFlySpeed(10)

    -- 7. Hide all UI panels
    MinBar.Visible = false
    MF.Visible     = false
    mainVisible    = false
    isMinimized    = false

    -- 8. Notify player
    notify(
        "Femboy Hub — Disconnected",
        "Disconnected from Femboy Hub. All changes have been reverted to default.",
        6
    )
end

MinBarClose.MouseButton1Click:Connect(function()
    local tw = TweenService:Create(MinBar,
        TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.In),
        {Size = UDim2.new(0, 0, 0, 36), Position = UDim2.new(0.5, 0, 0, 6)})
    tw:Play()
    tw.Completed:Connect(function()
        fullResetAndClose()
    end)
end)

CloseBtn.MouseButton1Click:Connect(function()
