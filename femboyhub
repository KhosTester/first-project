-- NPC BLACKLIST  —  Built from ReplicatedStorage → NPCs
-- ══════════════════════════════════════════════════════════════
local npcBlacklist = {}

local function buildNPCBlacklist()
    npcBlacklist = {}
    local npcsFolder = ReplicatedStorage:FindFirstChild("NPCs")
    if npcsFolder then
        for _, obj in ipairs(npcsFolder:GetDescendants()) do
            if obj.Name and obj.Name ~= "" then
                npcBlacklist[obj.Name:lower()] = true
            end
        end
        -- Keep blacklist live for lazy-loaded NPCs
        npcsFolder.DescendantAdded:Connect(function(obj)
            if obj.Name and obj.Name ~= "" then
                npcBlacklist[obj.Name:lower()] = true
            end
        end)
    end
end

buildNPCBlacklist()

local function isNPCName(name)
    if not name or name == "" then return false end
    if npcBlacklist[name:lower()] then return true end
    for blackName in pairs(npcBlacklist) do
        if name:lower():find(blackName, 1, true) then return true end
    end
    return false
end

