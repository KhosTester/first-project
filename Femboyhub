    local sMS=Tabs.Custom:AddSection("Map Skin  (Empty map only)")
    local mapSkinBackup={}; local mapSkinApplied=false
    local MAP_PART_PATHS={{"Game","Map","Parts","Map"},{"Game","Map","Parts"},{"Game","Map"}}
    local function findMapParts()
        local result={}
        for _,pathParts in ipairs(MAP_PART_PATHS) do
            local cur=workspace; local ok=true
            for _,seg in ipairs(pathParts) do cur=cur:FindFirstChild(seg); if not cur then ok=false; break end end
            if ok and cur then
                for _,obj in ipairs(cur:GetDescendants()) do if obj:IsA("BasePart") then table.insert(result,obj) end end
                if #result>0 then break end
            end
        end
        return result
    end
    local skinColor=Color3.fromRGB(30,30,30); local skinMaterial=Enum.Material.SmoothPlastic; local skinTrans=0
    local MATERIAL_MAP={["Plastic"]=Enum.Material.Plastic,["SmoothPlastic"]=Enum.Material.SmoothPlastic,["Neon"]=Enum.Material.Neon,["ForceField"]=Enum.Material.ForceField,["Metal"]=Enum.Material.Metal,["DiamondPlate"]=Enum.Material.DiamondPlate,["Foil"]=Enum.Material.Foil,["CorrodedMetal"]=Enum.Material.CorrodedMetal,["Wood"]=Enum.Material.Wood,["WoodPlanks"]=Enum.Material.WoodPlanks,["Granite"]=Enum.Material.Granite,["Concrete"]=Enum.Material.Concrete,["Brick"]=Enum.Material.Brick,["Cobblestone"]=Enum.Material.Cobblestone,["Marble"]=Enum.Material.Marble,["Slate"]=Enum.Material.Slate,["Sandstone"]=Enum.Material.Sandstone,["Limestone"]=Enum.Material.Limestone,["Basalt"]=Enum.Material.Basalt,["Rock"]=Enum.Material.Rock,["Pebble"]=Enum.Material.Pebble,["CrackedLava"]=Enum.Material.CrackedLava,["Grass"]=Enum.Material.Grass,["LeafyGrass"]=Enum.Material.LeafyGrass,["Ground"]=Enum.Material.Ground,["Sand"]=Enum.Material.Sand,["Salt"]=Enum.Material.Salt,["Mud"]=Enum.Material.Mud,["Snow"]=Enum.Material.Snow,["Glacier"]=Enum.Material.Glacier,["Ice"]=Enum.Material.Ice,["Pavement"]=Enum.Material.Pavement,["Fabric"]=Enum.Material.Fabric,["Glass"]=Enum.Material.Glass,["Cardboard"]=Enum.Material.Cardboard,["Air"]=Enum.Material.Air,["Water"]=Enum.Material.Water}
    local MATERIAL_NAMES={"Plastic","SmoothPlastic","Neon","ForceField","Metal","DiamondPlate","Foil","CorrodedMetal","Wood","WoodPlanks","Granite","Concrete","Brick","Cobblestone","Marble","Slate","Sandstone","Limestone","Basalt","Rock","Pebble","CrackedLava","Grass","LeafyGrass","Ground","Sand","Salt","Mud","Snow","Glacier","Ice","Pavement","Fabric","Glass","Cardboard","Air","Water"}
    sMS:AddColorpicker("MapSkinColor",{Title="Ground Color — Primary",Default=Color3.fromRGB(30,30,30),Callback=function(v) skinColor=v end})
    sMS:AddColorpicker("MapSkinColor2",{Title="Ground Color — Secondary",Default=Color3.fromRGB(60,60,60),Callback=function(v) skinColor=v end})
    sMS:AddDropdown("MapSkinMaterial",{Title="Ground Material",Values=MATERIAL_NAMES,Default="SmoothPlastic",Callback=function(v) skinMaterial=MATERIAL_MAP[tostring(v)] or Enum.Material.SmoothPlastic end})
    sMS:AddSlider("MapSkinTrans",{Title="Transparency",Default=0,Min=0,Max=90,Rounding=0,Callback=function(v) skinTrans=v/100 end})
    sMS:AddButton({Title="✅ Apply Map Skin",Callback=function()
        task.spawn(function()
            local parts=findMapParts()
            if #parts==0 then Fluent:Notify({Title="Map Skin",Content="❌ No parts found!\nMake sure you are using the Empty map.",Duration=5}); return end
            if not mapSkinApplied then
                mapSkinBackup={}
                for _,p in ipairs(parts) do table.insert(mapSkinBackup,{part=p,color=p.Color,mat=p.Material,trans=p.Transparency}) end
                mapSkinApplied=true
            end
            local texCount=0
            for _,p in ipairs(parts) do
                for _,child in ipairs(p:GetChildren()) do
                    if child:IsA("Texture") or child:IsA("Decal") then pcall(function() child:Destroy() end); texCount=texCount+1 end
                end
                pcall(function() p.Color=skinColor; p.Material=skinMaterial; p.Transparency=skinTrans; p.CastShadow=false end)
            end
            Fluent:Notify({Title="Map Skin",Content="✅ Applied to "..#parts.." parts\n🗑 Removed "..texCount.." texture/decals",Duration=4})
        end)
    end})
    sMS:AddButton({Title="🔄 Reset Map Skin",Callback=function()
        if not mapSkinApplied or #mapSkinBackup==0 then Fluent:Notify({Title="Map Skin",Content="⚠ No skin applied yet.",Duration=3}); return end
        local restored=0
        for _,entry in ipairs(mapSkinBackup) do
            if entry.part and entry.part.Parent then
                pcall(function() entry.part.Color=entry.color; entry.part.Material=entry.mat; entry.part.Transparency=entry.trans end)
                restored=restored+1
            end
        end
        mapSkinBackup={}; mapSkinApplied=false
        Fluent:Notify({Title="Map Skin",Content="🔄 Restored "..restored.." parts.",Duration=3})
    end})

    buildLightingEditor()
    buildAtmosphereEditor()
    buildPostProcessingEditor()

    local sDX=Tabs.Custom:AddSection("Advanced")
    sDX:AddButton({Title="Open Dex Explorer",Callback=function()
        Fluent:Notify({Title="Dex",Content="⏳ Loading...",Duration=3})
        task.spawn(function() pcall(function() loadstring(game:HttpGet("https://raw.githubusercontent.com/infyiff/backup/main/dex.lua"))() end) end)
    end})
end

