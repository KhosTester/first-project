        farm.platform.CanCollide=true; farm.platform.BrickColor=BrickColor.new("Cyan")
        farm.platform.Transparency=0.4; farm.platform.CFrame=CFrame.new(3000,FARM2_Y-3,3000); farm.platform.Parent=workspace
        if farm.fall2Conn then farm.fall2Conn:Disconnect() end
        farm.fall2Conn=RunService.Heartbeat:Connect(function()
            if not farm.active or farm.method~=2 then return end
            local c2=player.Character; if not c2 then return end
