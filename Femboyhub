        farm.plat3.Transparency=1; farm.plat3.CanQuery=false
        farm.plat3.CFrame=CFrame.new(targetX,platformY,targetZ); farm.plat3.Parent=workspace
        if h then h.CFrame=CFrame.new(targetX,playerY,targetZ); h.AssemblyLinearVelocity=Vector3.new() end
        if farm.conn3 then farm.conn3:Disconnect() end
