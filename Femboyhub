    clearWeather(); if wtype=="None" then return end
    weather.lastType=wtype
    weather.sound=Instance.new("Sound"); weather.sound.Looped=true; weather.sound.Volume=0.6; weather.sound.Parent=workspace
    if wtype=="Rain" then
        weather.isRain=true; createClouds(0.85,0.80,Color3.fromRGB(80,80,80))
        weather.sound.SoundId="rbxassetid://1516791621"; weather.sound:Play()
        startWeatherLoop("Rain"); Fluent:Notify({Title="Weather",Content="🌧 Rain started!",Duration=3})
    elseif wtype=="Snow" then
        weather.isSnow=true; createClouds(0.60,0.50,Color3.fromRGB(240,245,255))
        weather.sound.SoundId="rbxassetid://1340194740"; weather.sound:Play()
        startWeatherLoop("Snow"); Fluent:Notify({Title="Weather",Content="❄ Snowfall started!",Duration=3})
    end
end

