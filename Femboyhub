    task.spawn(function()
        while tas.running do
            RunService.Heartbeat:Wait()
            local c=player.Character
            if c and c:FindFirstChild("HumanoidRootPart") and c:FindFirstChild("Humanoid") then
                table.insert(tas.frames,{c.HumanoidRootPart.CFrame,c.Humanoid:GetState().Value,tick()-tas.timeStart})
            end
        end
    end)
end
local function tasStop()
    tas.running=false; Fluent:Notify({Title="TAS",Content="⏹ Stopped — "..#tas.frames.." frames.",Duration=3})
end
local function tasPlay()
    if #tas.frames==0 then Fluent:Notify({Title="TAS",Content="⚠ No frames recorded.",Duration=3}); return end
    Fluent:Notify({Title="TAS",Content="▶ Playing "..#tas.frames.." frames...",Duration=3})
    local timePlay=tick(); local fc=#tas.frames; local of=1
    local loop; loop=RunService.Heartbeat:Connect(function()
        if (tick()-timePlay)>=tas.frames[fc][3] then loop:Disconnect(); return end
        for i=of,math.min(of+60,fc) do
            local f=tas.frames[i]
            if f and f[3]<=tick()-timePlay then
                of=i; local ch=player.Character
                if ch then
                    if ch:FindFirstChild("HumanoidRootPart") then ch.HumanoidRootPart.CFrame=f[1] end
                    if ch:FindFirstChild("Humanoid") then pcall(function() ch.Humanoid:ChangeState(f[2]) end) end
                end
            end
        end
    end)
end

