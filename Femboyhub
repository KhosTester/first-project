local function applyFakeStat(statName, value, aliases)
    local p=game.Players.LocalPlayer; local targets={statName}
    if aliases then for _,a in ipairs(aliases) do table.insert(targets,a) end end
    for _,name in ipairs(targets) do
        pcall(function() p:SetAttribute(name,value) end)
        local data=p:FindFirstChild("Data")
        if data then local child=data:FindFirstChild(name); if child then pcall(function() child.Value=value end) end end
        local ls=p:FindFirstChild("leaderstats")
        if ls then local child=ls:FindFirstChild(name); if child then pcall(function() child.Value=value end) end end
        for _,folder in ipairs(p:GetChildren()) do
            local child=folder:FindFirstChild(name)
            if child and child.Value~=nil then pcall(function() child.Value=value end) end
        end
    end
end

local function isCandyObject(obj)
    if not obj or not obj.Name then return false end
    local n=obj.Name:lower()
    for _,kw in ipairs(CANDY_NAMES) do if n:find(kw) then return true end end
    return false
end

local function getCandyPosition(obj)
    if not obj or not obj.Parent then return nil end
    local pos=nil
    pcall(function()
        if obj:IsA("BasePart") then pos=obj.Position
        elseif obj:IsA("Model") then
            local p=obj.PrimaryPart or obj:FindFirstChildOfClass("BasePart")
            if not p then for _=1,5 do task.wait(0.05); p=obj.PrimaryPart or obj:FindFirstChildOfClass("BasePart"); if p then break end end end
            if p then pos=p.Position end
        end
    end)
    if pos and pos.Magnitude<0.5 then return nil end
    return pos
end

local function findItemSpawnsFolder()
    for _,pathParts in ipairs(CANDY_PATHS) do
        local cur=game; local ok=true
        for _,part in ipairs(pathParts) do cur=cur:FindFirstChild(part); if not cur then ok=false; break end end
        if ok and cur then return cur end
    end
    return nil
end

local function isBotDangerousAt(pos)
    if not st.GodMode then return false end
    for _,obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and not isPlayerChar(obj) then
            local botRoot=obj.PrimaryPart or obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChildWhichIsA("BasePart")
            if botRoot and (botRoot.Position-pos).Magnitude<god.BOT_SAFE_DIST then return true end
        end
    end
    return false
end

local function getSortedCandyList(itemSpawns, myPos)
    local list={}
    for _,spawnPoint in ipairs(itemSpawns:GetChildren()) do
        if isCandyObject(spawnPoint) then
            local pos=getCandyPosition(spawnPoint)
            if pos then table.insert(list,{obj=spawnPoint,pos=pos,dist=(pos-myPos).Magnitude}) end
        end
        for _,child in ipairs(spawnPoint:GetChildren()) do
            if isCandyObject(child) then
                local pos=getCandyPosition(child)
                if pos then table.insert(list,{obj=child,pos=pos,dist=(pos-myPos).Magnitude}) end
            end
        end
    end
    table.sort(list,function(a,b) return a.dist<b.dist end)
    return list
end

local function collectWithVerify(obj, pos)
    if not candy.active then return false end
    local c=player.Character; local root=c and c:FindFirstChild("HumanoidRootPart"); if not root then return false end
    if isBotDangerousAt(pos) then candy.status="⚠ Bot near candy — skipping"; return false end
    local parentRef=obj.Parent
    root.CFrame=CFrame.new(pos+Vector3.new(0,candy.tpOffset,0))
    local deadline=tick()+PICKUP_TIMEOUT; local picked=false
    while tick()<deadline and candy.active do
        if not obj or not obj.Parent or obj.Parent~=parentRef then picked=true; break end
        task.wait(0.05)
    end
    if not picked and obj and obj.Parent then
        local retryPos=getCandyPosition(obj)
        if retryPos then
            candy.status="🔄 Retrying..."; root.CFrame=CFrame.new(retryPos+Vector3.new(0,0.5,0)); task.wait(0.2)
            if not obj.Parent or obj.Parent~=parentRef then picked=true end
        end
    end
    if picked then candy.count=candy.count+1; candy.status="✅ Collected: "..candy.count
    else candy.missed=candy.missed+1; candy.status="⚠ Miss ×"..candy.missed.." | OK: "..candy.count end
    task.wait(candy.delay); return picked
end

local function fullSortedScan(itemSpawns)
    if not itemSpawns or not candy.active then return end
    local c=player.Character; local root=c and c:FindFirstChild("HumanoidRootPart"); if not root then return end
    local sorted=getSortedCandyList(itemSpawns,root.Position)
    if #sorted==0 then return end
    candy.status="🔍 "..#sorted.." candy found — collecting..."
    for _,entry in ipairs(sorted) do
        if not candy.active then break end
        if entry.obj and entry.obj.Parent then
            local freshPos=getCandyPosition(entry.obj); if freshPos then collectWithVerify(entry.obj,freshPos) end
        end
    end
end

local function setupCandyEvent(itemSpawns)
    if candy.eventConn then candy.eventConn:Disconnect(); candy.eventConn=nil end
    candy.eventConn=itemSpawns.DescendantAdded:Connect(function(obj)
        if not candy.active then return end; task.wait(0.05)
        if not isCandyObject(obj) then return end
        local pos=nil
        for _=1,10 do pos=getCandyPosition(obj); if pos and pos.Magnitude>0.5 then break end; pos=nil; task.wait(0.1) end
        if not pos then return end
        candy.status="⚡ New candy: "..obj.Name; collectWithVerify(obj,pos)
        if candy.active then candy.status="💤 Waiting for new candy..." end
    end)
end

local function startFolderWatcher()
    if candy.folderWatcher then candy.folderWatcher:Disconnect() end
    candy.folderWatcher=workspace.DescendantAdded:Connect(function(obj)
        if not candy.active then return end
        if obj.Name=="ItemSpawns" then
            task.wait(0.5); local newFolder=findItemSpawnsFolder()
            if newFolder then
                candy.status="🔄 New round — Reconnecting..."; setupCandyEvent(newFolder)
                task.spawn(function() fullSortedScan(newFolder); if candy.active then candy.status="💤 Waiting for new candy..." end end)
            end
        end
    end)
end

local function startCandyCollect()
    candy.active=true; candy.count=0; candy.missed=0; candy.status="⏳ Searching for ItemSpawns..."
    task.spawn(function()
        local itemSpawns=nil; local deadline=tick()+10
        while tick()<deadline do itemSpawns=findItemSpawnsFolder(); if itemSpawns then break end; task.wait(0.5) end
        if not itemSpawns then candy.status="❌ ItemSpawns not found!\nTry entering a Custom Path."; return end
        candy.status="🔍 Initial Scan..."; fullSortedScan(itemSpawns)
        if not candy.active then return end
        setupCandyEvent(itemSpawns); candy.status="💤 Waiting for new candy..."; startFolderWatcher()
        task.spawn(function()
            while candy.active do
                task.wait(15); if not candy.active then break end
                local cur=findItemSpawnsFolder()
                if cur then candy.status="🔍 Safety Scan..."; fullSortedScan(cur); if candy.active then candy.status="💤 Waiting for new candy..." end end
            end
        end)
    end)
end

local function stopCandyCollect()
    candy.active=false
    if candy.eventConn    then candy.eventConn:Disconnect();    candy.eventConn=nil    end
    if candy.folderWatcher then candy.folderWatcher:Disconnect(); candy.folderWatcher=nil end
    candy.status="🔴 Stopped — OK: "..candy.count.." | Miss: "..candy.missed
end

