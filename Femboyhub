local function startAutoFarm()
    farm.active=true
    if farm.method==1 then
        farm.phase=1; farmTP()
        if farm.capConn then farm.capConn:Disconnect() end
        farm.capConn=RunService.Heartbeat:Connect(function()
            if not farm.active or farm.method~=1 then return end
            local c=player.Character; if not c then return end
            local h=c:FindFirstChild("HumanoidRootPart"); if not h then return end
            local v=h.AssemblyLinearVelocity; if v.Y<-100 then h.AssemblyLinearVelocity=Vector3.new(v.X,-100,v.Z) end
        end)
        if farm.conn then farm.conn:Disconnect() end
        farm.conn=RunService.Heartbeat:Connect(function()
            if not farm.active or farm.method~=1 then return end
            local c=player.Character; if not c then return end
            local h=c:FindFirstChild("HumanoidRootPart"); if not h then return end
            if h.Position.Y<6000 and not farm.yTrig then
                farm.yTrig=true; farm.phase=(farm.phase%4)+1
                task.spawn(function() task.wait(0.05); farmTP() end)
            end
        end)
        Fluent:Notify({Title="Farm",Content="✅ Auto Farm M1 started!",Duration=2})
    elseif farm.method==2 then
        local c=player.Character
        if c then local h=c:FindFirstChild("HumanoidRootPart")
            if h then h.CFrame=CFrame.new(3000,FARM2_Y+1,3000); h.AssemblyLinearVelocity=Vector3.new() end
        end
        if farm.platform then pcall(function() farm.platform:Destroy() end) end
