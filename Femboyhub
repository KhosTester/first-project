            local h2=c2:FindFirstChild("HumanoidRootPart"); if not h2 then return end
            local dy=math.abs(h2.Position.Y-playerY); local dx=math.abs(h2.Position.X-targetX); local dz=math.abs(h2.Position.Z-targetZ)
