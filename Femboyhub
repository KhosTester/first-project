-- ════════════════════════════════════════════════════════════════
-- WET FLOOR SECTION
-- ════════════════════════════════════════════════════════════════
function buildWetFloorSection()
    local sMF=Tabs.Settings:AddSection("Wet Floor  💧✨")
    local waterParts={}; local waterApplied=false; local rippleConn=nil
    local wetIntensity=0.65; local waterThickness=0.05
    local waterColorTint=Color3.fromRGB(180,220,255); local waterTransAlpha=0.55
    local waterCanCollide=false; local waterMaterial=Enum.Material.Glass
    local WATER_MATERIALS={["Glass"]=Enum.Material.Glass,["SmoothPlastic"]=Enum.Material.SmoothPlastic,["Plastic"]=Enum.Material.Plastic}

    -- ── Ripple variables ──────────────────────────────────────
    local rippleOpacity           = 0.15
    local rippleExtraTransparency = 0.0
    local rippleThickness         = 0.07
    local rippleColor             = Color3.fromRGB(180,220,255)
    local rippleColor2            = Color3.fromRGB(140,195,240)
    local rippleMaterial          = Enum.Material.Neon
    local lastRippleTime          = 0

    -- ── Water overlay helpers ─────────────────────────────────
    local function refreshAllWaterParts()
        for _,wp in ipairs(waterParts) do
            if wp and wp.Parent then pcall(function() wp.Material=waterMaterial; wp.Transparency=waterTransAlpha; wp.CanCollide=waterCanCollide end) end
        end
    end
    local function findFloorsByRaycast()
        local char=player.Character; local hrpL=char and char:FindFirstChild("HumanoidRootPart")
        local base=hrpL and hrpL.Position or Vector3.new(0,50,0)
        local excl={}; if char then table.insert(excl,char) end
        for _,wp in ipairs(waterParts) do table.insert(excl,wp) end
        local rp=RaycastParams.new(); rp.FilterType=Enum.RaycastFilterType.Exclude; rp.FilterDescendantsInstances=excl
        local seen,floors={},{}
        local step,radius=5,200
        for x=-radius,radius,step do
            for z=-radius,radius,step do
                local origin=Vector3.new(base.X+x,base.Y+80,base.Z+z)
                local result=workspace:Raycast(origin,Vector3.new(0,-300,0),rp)
                if result and result.Instance then
                    local obj=result.Instance
                    if obj:IsA("BasePart") and not obj:IsA("Terrain") and obj.Size.X>=0.5 and obj.Size.Z>=0.5
                    and obj.Name~="FemboyWaterOverlay" and obj.Name~="FemboyRipple" and obj.Name~="FemboyWeatherPart"
                    and obj.Name~="FemboyFarm3Platform" and obj.Name~="FemboyWeatherPart" and not seen[obj]
                    then seen[obj]=true; table.insert(floors,obj) end
                end
            end
        end
        return floors
    end
    local function createWaterOverlay(orig)
        local wp=Instance.new("Part"); wp.Name="FemboyWaterOverlay"
        wp.Anchored=true; wp.CanCollide=waterCanCollide; wp.CanQuery=false; wp.CastShadow=false; wp.Material=waterMaterial
        local bc,tc=orig.Color,waterColorTint
        wp.Color=Color3.new(bc.R*0.40+tc.R*0.60,bc.G*0.40+tc.G*0.60,bc.B*0.40+tc.B*0.60)
        wp.Reflectance=0.28+0.62*wetIntensity; wp.Transparency=waterTransAlpha
        wp.Size=Vector3.new(orig.Size.X,waterThickness,orig.Size.Z)
        wp.CFrame=orig.CFrame*CFrame.new(0,orig.Size.Y/2+waterThickness/2+0.005,0)
        wp.Parent=workspace; return wp
    end
    local function applyWaterOverlay()
        if waterApplied then Fluent:Notify({Title="Wet Floor",Content="⚠ Already applied! Reset first.",Duration=3}); return end
        waterParts={}; Fluent:Notify({Title="Wet Floor",Content="⏳ Scanning...",Duration=2})
        task.spawn(function()
            local floors=findFloorsByRaycast()
            if #floors==0 then Fluent:Notify({Title="Wet Floor",Content="❌ No floors found! Stand on the floor and try again.",Duration=5}); return end
            local count=0
            for _,orig in ipairs(floors) do
                pcall(function() local wp=createWaterOverlay(orig); table.insert(waterParts,wp); count=count+1 end)
                if count%60==0 then task.wait() end
            end
            waterApplied=true; Fluent:Notify({Title="Wet Floor",Content="💧 "..count.." overlays applied!",Duration=4})
        end)
    end
    local function resetWaterOverlay()
        if not waterApplied and #waterParts==0 then Fluent:Notify({Title="Wet Floor",Content="⚠ Nothing to reset.",Duration=2}); return end
        local removed=0
        for _,wp in ipairs(waterParts) do if wp and wp.Parent then pcall(function() wp:Destroy() end); removed=removed+1 end end
        waterParts={}; waterApplied=false
        for _,obj in pairs(workspace:GetDescendants()) do if obj.Name=="FemboyWaterOverlay" then pcall(function() obj:Destroy() end) end end
        Fluent:Notify({Title="Wet Floor",Content="🗑 Removed "..removed.." overlays.",Duration=3})
    end

    -- ════════════════════════════════════════════════════════
    -- RIPPLE — Walk only (no jump/landing detection)
    -- ════════════════════════════════════════════════════════

    -- Core ring spawner
    local function spawnRippleRing(pos, startDiam, endDiam, duration, startTrans, col, yOff)
        local r = Instance.new("Part")
        r.Name        = "FemboyRipple"
        r.Anchored    = true
        r.CanCollide  = false
        r.CanQuery    = false
        r.CastShadow  = false
        r.Material    = rippleMaterial
        r.Color       = col
        r.Shape       = Enum.PartType.Cylinder
        r.CFrame      = CFrame.new(pos.X, pos.Y + (yOff or 0.04), pos.Z) * CFrame.Angles(0, 0, math.rad(90))
        r.Size        = Vector3.new(rippleThickness * 0.8, startDiam, startDiam)
        r.Transparency = math.clamp(startTrans + rippleOpacity + rippleExtraTransparency, 0, 0.99)
        r.Parent      = workspace
        local tw = TweenService:Create(r, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            { Size = Vector3.new(rippleThickness * 0.2, endDiam, endDiam), Transparency = 1 })
        tw:Play()
        tw.Completed:Connect(function() pcall(function() r:Destroy() end) end)
    end

    -- Glow disc (inner center)
    local function spawnGlowDisc(pos)
        local d = Instance.new("Part")
        d.Name        = "FemboyRipple"
        d.Anchored    = true
        d.CanCollide  = false
        d.CanQuery    = false
        d.CastShadow  = false
        d.Material    = rippleMaterial
        d.Color       = Color3.new(0.9, 0.97, 1)
        d.Shape       = Enum.PartType.Cylinder
        d.CFrame      = CFrame.new(pos.X, pos.Y + 0.03, pos.Z) * CFrame.Angles(0, 0, math.rad(90))
        d.Size        = Vector3.new(0.03, 0.8, 0.8)
        d.Transparency = math.clamp(0.12 + rippleOpacity + rippleExtraTransparency, 0, 0.98)
        d.Parent      = workspace
        TweenService:Create(d, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            { Size = Vector3.new(0.015, 3.0, 3.0), Transparency = 1 }):Play()
        task.delay(0.25, function() pcall(function() d:Destroy() end) end)
    end

    -- ── Simplified spawnRipple: 1 glow disc + 3 rings only ──
    local function spawnRipple(pos, speedFactor)
        local sf = math.clamp(speedFactor or 1.0, 0.4, 2.5)

        spawnGlowDisc(pos)

        spawnRippleRing(pos, 0.10, 2.0*sf, 0.28, 0.05, Color3.new(1,1,1),             0.065)
        task.delay(0.07, function()
            spawnRippleRing(pos, 0.14, 5.0*sf, 0.52, 0.15, rippleColor,                0.055)
        end)
        task.delay(0.18, function()
            spawnRippleRing(pos, 0.09, 9.0*sf, 0.80, 0.35, rippleColor2,               0.044)
        end)
    end

    -- ── Walk-only ripple loop (landing detection removed) ──
    local function startRipple()
        if rippleConn then return end
        rippleConn = RunService.Heartbeat:Connect(function()
            local now = tick()
            if now - lastRippleTime < 0.20 then return end
            local c   = player.Character
            local hrpL = c and c:FindFirstChild("HumanoidRootPart")
            local humL = c and c:FindFirstChild("Humanoid")
            if not hrpL or not humL then return end

            local onGround = (humL.FloorMaterial ~= Enum.Material.Air)
            if humL.MoveDirection.Magnitude > 0.1 and onGround then
                local rp = RaycastParams.new()
                rp.FilterDescendantsInstances = {c}
                rp.FilterType = Enum.RaycastFilterType.Exclude
                local ray = workspace:Raycast(hrpL.Position, Vector3.new(0, -5, 0), rp)
                if ray and ray.Instance and ray.Instance.Name ~= "FemboyRipple" then
                    local speed = hrpL.AssemblyLinearVelocity.Magnitude
                    local sf    = math.clamp(speed / 16, 0.5, 2.5)
                    spawnRipple(ray.Position, sf)
                    lastRippleTime = now
                end
            end
        end)
    end

    local function stopRipple()
        if rippleConn then rippleConn:Disconnect(); rippleConn=nil end
        for _,obj in pairs(workspace:GetDescendants()) do
            if obj.Name=="FemboyRipple" then pcall(function() obj:Destroy() end) end
        end
    end

    -- ════════════════════════════════════════════════════════
    -- UI
    -- ════════════════════════════════════════════════════════
    sMF:AddSlider("WetIntensity",{Title="Wet Intensity",Default=65,Min=0,Max=100,Rounding=0,Callback=function(v)
        wetIntensity=v/100
        for _,wp in ipairs(waterParts) do if wp and wp.Parent then pcall(function() wp.Reflectance=0.28+0.62*wetIntensity end) end end
    end})
    sMF:AddSlider("WaterTransparency",{Title="Water Transparency",Default=55,Min=0,Max=100,Rounding=0,Callback=function(v) waterTransAlpha=v/100; refreshAllWaterParts() end})
    sMF:AddSlider("WaterThickness",{Title="Layer Thickness",Default=5,Min=1,Max=30,Rounding=0,Callback=function(v) waterThickness=v/100 end})
    sMF:AddDropdown("WaterMaterial",{Title="Water Material",Values={"Glass","SmoothPlastic","Plastic"},Default="Glass",Callback=function(v)
        waterMaterial=WATER_MATERIALS[tostring(v)] or Enum.Material.Glass; refreshAllWaterParts()
    end})
    sMF:AddColorpicker("WaterTint",{Title="Water Tint — Primary",Default=Color3.fromRGB(180,220,255),Callback=function(v) waterColorTint=v end})
    sMF:AddColorpicker("WaterTint2",{Title="Water Tint — Secondary",Default=Color3.fromRGB(140,195,240),Callback=function(v) waterColorTint=v end})
    sMF:AddButton({Title="💧 Apply Wet Floor",Callback=function() task.spawn(applyWaterOverlay) end})
    sMF:AddButton({Title="🗑 Reset Wet Floor",  Callback=function() task.spawn(resetWaterOverlay) end})

    local sCC2=Tabs.Settings:AddSection("Water CanCollide")
    sCC2:AddParagraph({Title="Current State",Content="🔴 Solid (CanCollide ON)"})
    local ccStatePara = sCC2:AddParagraph({Title="Info",Content="Toggle whether the water overlay blocks your movement."})
    sCC2:AddButton({Title="🔀 Toggle: Walk Through / Solid",Callback=function()
        waterCanCollide = not waterCanCollide
        refreshAllWaterParts()
        if not waterCanCollide then
            Fluent:Notify({Title="Water CanCollide",Content="🔴 Solid — water blocks movement.",Duration=2})
            pcall(function() ccStatePara:SetDesc("Current: 🔴 Solid (CanCollide ON)") end)
        else
            Fluent:Notify({Title="Water CanCollide",Content="🟢 Pass-through — walk through water.",Duration=2})
            pcall(function() ccStatePara:SetDesc("Current: 🟢 Pass-through (CanCollide OFF)") end)
        end
    end})

    -- ── Ripple UI ─────────────────────────────────────────────
    sMF:AddSlider("RippleOpacity",{Title="Ripple Opacity (brightness)",Default=15,Min=0,Max=90,Rounding=0,Callback=function(v) rippleOpacity=v/100 end})
    sMF:AddSlider("RippleExtraTransparency",{Title="Ripple Extra Transparency",Default=0,Min=0,Max=85,Rounding=0,Callback=function(v) rippleExtraTransparency=v/100 end})
    sMF:AddSlider("RippleThickness",{Title="Ring Thickness",Default=7,Min=1,Max=50,Rounding=0,Callback=function(v) rippleThickness=v/100 end})

    local RIPPLE_MATERIAL_MAP={
        ["Neon"]         =Enum.Material.Neon,
        ["Glass"]        =Enum.Material.Glass,
        ["SmoothPlastic"]=Enum.Material.SmoothPlastic,
        ["Plastic"]      =Enum.Material.Plastic,
    }
    sMF:AddDropdown("RippleMaterial",{Title="Ripple Material",Values={"Neon","Glass","SmoothPlastic","Plastic"},Default="Neon",Callback=function(v)
        rippleMaterial=RIPPLE_MATERIAL_MAP[tostring(v)] or Enum.Material.Neon
        Fluent:Notify({Title="Ripple",Content="Material → "..tostring(v),Duration=2})
    end})

    sMF:AddColorpicker("RippleColor",{Title="Ripple Color — Primary",Default=Color3.fromRGB(180,220,255),Callback=function(v) rippleColor=v end})
    sMF:AddColorpicker("RippleColor2",{Title="Ripple Color — Secondary",Default=Color3.fromRGB(140,195,240),Callback=function(v) rippleColor2=v end})

    sMF:AddDropdown("RippleColorPreset",{Title="Quick Ripple Color Preset",Values={"Water (Default)","Dirt — Brown/Green","Sand — Golden"},Default="Water (Default)",Callback=function(v)
        local sv=tostring(v)
        if sv=="Dirt — Brown/Green" then
            rippleColor=Color3.fromRGB(101,67,33); rippleColor2=Color3.fromRGB(34,139,34)
            Fluent:Notify({Title="Ripple",Content="🟤 Dirt preset applied!",Duration=2})
        elseif sv=="Sand — Golden" then
            rippleColor=Color3.fromRGB(210,180,100); rippleColor2=Color3.fromRGB(194,165,61)
            Fluent:Notify({Title="Ripple",Content="🟡 Sand preset applied!",Duration=2})
        else
            rippleColor=Color3.fromRGB(180,220,255); rippleColor2=Color3.fromRGB(140,195,240)
            Fluent:Notify({Title="Ripple",Content="💧 Water preset applied!",Duration=2})
        end
    end})

    toggleRefs["Ripple"]=sMF:AddToggle("RippleToggle",{Title="💧 Ripple  (Walk Only)",Default=false,Callback=function(v)
        if v then startRipple(); Fluent:Notify({Title="Ripple",Content="✅ ON — Walk ripple active.",Duration=3})
        else stopRipple(); Fluent:Notify({Title="Ripple",Content="🗑 OFF",Duration=2}) end
    end})
end
