-- ── Weather helpers ──────────────────────────────────────────
local function applyCloudSettings()
    local terrain = workspace:FindFirstChildOfClass("Terrain"); if not terrain then return end
    local clouds = terrain:FindFirstChildOfClass("Clouds")
    if clouds then pcall(function()
        clouds.Cover=weather.cloudCover; clouds.Density=weather.cloudDensity; clouds.Color=weather.cloudColor
    end) end
end

local function createClouds(cover, density, color)
    local terrain = workspace:FindFirstChildOfClass("Terrain"); if not terrain then return end
    local clouds = terrain:FindFirstChildOfClass("Clouds")
    if not clouds then clouds=Instance.new("Clouds"); clouds.Parent=terrain end
    pcall(function()
        clouds.Cover=cover or weather.cloudCover; clouds.Density=density or weather.cloudDensity; clouds.Color=color or weather.cloudColor
    end)
end

local function clearWeather()
    if weather.switching then return end
    weather.isRain=false; weather.isSnow=false; weather.lastType="None"
    if weather.conn then weather.conn:Disconnect(); weather.conn=nil end
    if weather.part then pcall(function() weather.part:Destroy() end); weather.part=nil end
    if weather.sound then weather.sound:Stop(); pcall(function() weather.sound:Destroy() end); weather.sound=nil end
    local terrain=workspace:FindFirstChildOfClass("Terrain")
    if terrain then local clouds=terrain:FindFirstChildOfClass("Clouds"); if clouds then pcall(function() clouds:Destroy() end) end end
end

local function buildEmitter(parent, wtype)
    local emitter = Instance.new("ParticleEmitter")
    emitter.EmissionDirection = Enum.NormalId.Bottom
    if wtype == "Rain" then
        -- ── Rain: Thông số cân bằng — trông chuyên nghiệp, không lag ──
        emitter.Texture        = "rbxassetid://241876428"
        emitter.Color          = ColorSequence.new({
            ColorSequenceKeypoint.new(0,   Color3.fromRGB(210, 225, 255)),
            ColorSequenceKeypoint.new(0.5, Color3.fromRGB(221, 229, 255)),
            ColorSequenceKeypoint.new(1,   Color3.fromRGB(200, 218, 255)),
        })
        emitter.LightEmission  = 0.15
        emitter.LightInfluence = 0.85
        -- Rate 800: đủ thấy mưa dày mà không lag
        emitter.Rate           = 800
        -- Speed 80-120: mưa rơi nhanh, tạo cảm giác hối hả
        emitter.Speed          = NumberRange.new(80, 120)
        -- Lifetime 1.5-2.0: đủ để hạt rơi 150 studs từ Part xuống đất
        emitter.Lifetime       = NumberRange.new(1.5, 2.0)
        -- Size nhỏ: hạt mưa mảnh, không to như cục đá
        emitter.Size           = NumberSequence.new({
            NumberSequenceKeypoint.new(0,   0.04),
            NumberSequenceKeypoint.new(0.5, 0.05),
            NumberSequenceKeypoint.new(1,   0.03),
        })
        -- Squash dương 3.5: kéo dài hạt thành vệt mưa, bí quyết của các pro
        emitter.Squash         = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 3.5),
            NumberSequenceKeypoint.new(1, 3.5),
        })
        -- Transparency: fade vào, trong vừa phải, fade ra khi chạm đất
        emitter.Transparency   = NumberSequence.new({
            NumberSequenceKeypoint.new(0,    1.0),
            NumberSequenceKeypoint.new(0.08, 0.55),
            NumberSequenceKeypoint.new(0.85, 0.50),
            NumberSequenceKeypoint.new(1,    1.0),
        })
        -- Acceleration -100: ép hạt lao thẳng xuống dứt khoát
        emitter.Acceleration   = Vector3.new(0, -100, 0)
        emitter.Rotation       = NumberRange.new(0, 0)
        emitter.RotSpeed       = NumberRange.new(0, 0)
        -- SpreadAngle nhỏ: mưa gần thẳng đứng, không bay loạn
        emitter.SpreadAngle    = Vector2.new(4, 4)
        emitter.LockedToPart   = false
        pcall(function() emitter.Orientation = Enum.ParticleOrientation.VelocityParallel end)
        pcall(function() emitter.EmitterShape = Enum.ParticleEmitterShape.Box end)
    elseif wtype == "Snow" then
        emitter.Texture        = ""
        emitter.Color          = ColorSequence.new({
            ColorSequenceKeypoint.new(0,   Color3.fromRGB(235,245,255)),
            ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255,255,255)),
            ColorSequenceKeypoint.new(1,   Color3.fromRGB(220,235,255)),
        })
        emitter.Rate           = 350
        emitter.Speed          = NumberRange.new(5,15)
        emitter.Lifetime       = NumberRange.new(6,12)
        emitter.Size           = NumberSequence.new({
            NumberSequenceKeypoint.new(0,    0.0),
            NumberSequenceKeypoint.new(0.10, 0.30),
            NumberSequenceKeypoint.new(0.85, 0.28),
            NumberSequenceKeypoint.new(1,    0.0),
        })
        emitter.Transparency   = NumberSequence.new({
            NumberSequenceKeypoint.new(0,    1.0),
            NumberSequenceKeypoint.new(0.12, 0.08),
            NumberSequenceKeypoint.new(0.88, 0.08),
            NumberSequenceKeypoint.new(1,    1.0),
        })
        emitter.LightEmission  = 0.6
        emitter.LightInfluence = 0.85
        emitter.Squash         = 0.0
        emitter.Acceleration   = Vector3.new(4,-3,0)
        emitter.Rotation       = NumberRange.new(-180,180)
        emitter.RotSpeed       = NumberRange.new(-35,35)
        emitter.SpreadAngle    = Vector2.new(20,20)
    end
    emitter.Parent = parent
end

-- ── startWeatherLoop: Rain dùng Camera Part, Snow dùng floating part ──
local function startWeatherLoop(wtype)
    if weather.conn then weather.conn:Disconnect(); weather.conn=nil end
    if weather.part then pcall(function() weather.part:Destroy() end); weather.part=nil end

    if wtype == "Rain" then
        -- Part lớn 2048x1x2048 đặt 150 studs phía trên nhân vật, theo dõi player mỗi frame
        local char    = player.Character
        local hrpRef  = char and char:FindFirstChild("HumanoidRootPart")
        local startY  = hrpRef and (hrpRef.Position.Y + 25) or 25

        weather.part = Instance.new("Part")
        weather.part.Name         = "Rain"
        weather.part.Transparency = 1
        weather.part.CanCollide   = false
        weather.part.CanQuery     = false
        weather.part.CastShadow   = false
        weather.part.Anchored     = true
        -- Kích thước 2048 x 1 x 2048: bao phủ toàn bộ map, Y=1 (mỏng)
        weather.part.Size         = Vector3.new(2048, 1, 2048)
        weather.part.CFrame       = CFrame.new(hrpRef and hrpRef.Position.X or 0, startY, hrpRef and hrpRef.Position.Z or 0)
        weather.part.Parent       = workspace
        buildEmitter(weather.part, "Rain")

        -- Cập nhật X,Z theo player mỗi frame; Y cố định 150 studs trên đầu
        weather.conn = RunService.Heartbeat:Connect(function()
            local c   = player.Character
            local hrpL = c and c:FindFirstChild("HumanoidRootPart")
            if hrpL and weather.part and weather.part.Parent then
                pcall(function()
                    weather.part.CFrame = CFrame.new(hrpL.Position.X, hrpL.Position.Y + 25, hrpL.Position.Z)
                end)
            end
        end)

    elseif wtype == "Snow" then
        local char=player.Character; local hrpRef=char and char:FindFirstChild("HumanoidRootPart"); if not hrpRef then return end
        weather.part=Instance.new("Part"); weather.part.Name="FemboyWeatherPart"
        weather.part.Transparency=1; weather.part.CanCollide=false; weather.part.CanQuery=false
        weather.part.Anchored=true; weather.part.Size=Vector3.new(200,1,200)
        weather.part.CFrame=CFrame.new(hrpRef.Position+Vector3.new(0,60,0)); weather.part.Parent=workspace
        buildEmitter(weather.part, "Snow")
        weather.conn=RunService.Heartbeat:Connect(function()
            local c=player.Character; local h=c and c:FindFirstChild("HumanoidRootPart")
            if h and weather.part and weather.part.Parent then
                weather.part.CFrame=CFrame.new(h.Position.X, h.Position.Y+60, h.Position.Z)
            end
        end)
    end
end

