        Fluent.Options.PPBrightness:SetValue(origPostCC.Brightness or 0); Fluent.Options.PPContrast:SetValue(origPostCC.Contrast or 0)
        Fluent.Options.PPSaturation:SetValue(origPostCC.Saturation or 0); Fluent.Options.PPBloomIntensity:SetValue(origPostBloom.Intensity or 0.1)
