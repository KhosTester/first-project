        end)
        Fluent:Notify({Title="Farm",Content="✅ Auto Farm M2 started!",Duration=2})
    elseif farm.method==3 then
        if farm.plat3 then pcall(function() farm.plat3:Destroy() end) end
        local c=player.Character; local h=c and c:FindFirstChild("HumanoidRootPart")
