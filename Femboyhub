local GOD_ESCAPE_POINTS = {
    Vector3.new( 150,30, 150), Vector3.new(-150,30, 150),
    Vector3.new( 150,30,-150), Vector3.new(-150,30,-150),
    Vector3.new(   0,30, 200), Vector3.new(   0,30,-200),
    Vector3.new( 200,30,   0), Vector3.new(-200,30,   0),
