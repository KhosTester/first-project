local function enableGodMode()
    if god.conn then god.conn:Disconnect() end
    god.conn=RunService.Heartbeat:Connect(function()
        if not st.GodMode then return end
        local c=player.Character; if not c then return end
        local root=c:FindFirstChild("HumanoidRootPart"); if not root then return end
        local hum=c:FindFirstChild("Humanoid"); if not hum or hum.Health<=0 then return end
        local myPos=root.Position; local now=tick()
        local closestDist=math.huge; local closestBot=nil
        for _,obj in pairs(workspace:GetDescendants()) do
            if obj:IsA("Model") and not isPlayerChar(obj) then
                local botRoot=obj.PrimaryPart or obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChildWhichIsA("BasePart")
                if botRoot then
                    local dist=(botRoot.Position-myPos).Magnitude
                    if dist<god.BOT_SAFE_DIST and dist<closestDist then closestDist=dist; closestBot=botRoot end
                end
            end
        end
        if closestBot and now-god.cooldown>0.25 then
            god.cooldown=now; local botPos=closestBot.Position; local bestDest=nil; local bestScore=-math.huge
            for _,dest in ipairs(GOD_ESCAPE_POINTS) do
                local score=(dest-botPos).Magnitude; if score>bestScore then bestScore=score; bestDest=dest end
            end
            local target=bestDest or (myPos+Vector3.new(0,god.LIFT_H,0))
            root.CFrame=CFrame.new(target); pcall(function() root.AssemblyLinearVelocity=Vector3.new(0,0,0) end)
        end
    end)
end
